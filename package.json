{
  "name": "reformstudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cms": "VITE_CMS_MODE=true concurrently \"npm:content-server\" \"npm:dev\"",
    "build": "tsc && vite build",
    "content-server": "node scripts/content-server.js",
    "build:resources": "node scripts/build-resources.js",
    "validate:resources": "node scripts/validate-resources.js",
    "ingest": "npm run ingest:kjv && npm run ingest:bsb && npm run ingest:wcf && npm run ingest:henry && npm run ingest:strongs && npm run validate:resources && npm run authenticate",
    "ingest:kjv": "node scripts/ingest/kjv.js",
    "ingest:bsb": "node scripts/ingest/bsb.js",
    "ingest:wcf": "node scripts/ingest/wcf.js",
    "ingest:henry": "node scripts/ingest/henry.js",
    "ingest:strongs": "node scripts/ingest/strongs.js",
    "authenticate": "node scripts/authenticate/index.js",
    "content:diff": "node scripts/release/content-diff.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include='scripts/ingest/**' --test-coverage-include='scripts/lib/**' --test-coverage-include='scripts/authenticate/**' --test-coverage-lines=99 --test-coverage-branches=94 --test-coverage-functions=99 scripts/tests/*.test.js",
    "convert:resources": "node scripts/convert-text-to-json.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.496.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
