{"id":"TIT","name":"Titus","testament":"NT","chapters":3,"verses":[{"book":"TIT","chapter":1,"verse":1,"text":"Paul, a servant of God, and an apostle of Jesus Christ, according to the faith of God’s elect, and the acknowledging of the truth which is after godliness;","strongs":[[0,4,"G3972"],[8,15,"G1401"],[19,22,"G2316"],[24,27,"G1161"],[31,38,"G652"],[42,47,"G2424"],[48,54,"G5547"],[66,68,"G2596"],[73,78,"G4102"],[79,81,"G1588"],[82,87,"G2316"],[88,93,"G1588"],[95,98,"G2532"],[103,116,"G1922"],[124,129,"G225"],[130,135,"G3588"],[139,144,"G2596"],[145,154,"G2150"]]},{"book":"TIT","chapter":1,"verse":2,"text":"In hope of eternal life, which God, that cannot lie, promised before the world began;","strongs":[[0,2,"G1909"],[3,7,"G1680"],[11,18,"G166"],[19,23,"G2222"],[25,30,"G3739"],[31,34,"G2316"],[48,51,"G893"],[53,61,"G1861"],[62,68,"G4253"],[73,78,"G5550"],[79,84,"G166"]]},{"book":"TIT","chapter":1,"verse":3,"text":"But hath in due times manifested his word through preaching, which is committed unto me according to the commandment of God our Saviour;","strongs":[[0,3,"G1161"],[4,8,"G5319"],[12,15,"G2398"],[16,21,"G2540"],[22,32,"G5319"],[33,36,"G846"],[37,41,"G3056"],[42,49,"G1722"],[50,59,"G2782"],[61,66,"G3739"],[80,84,"G4100"],[85,87,"G1473"],[98,100,"G2596"],[105,116,"G2003"],[120,123,"G2316"],[124,127,"G2257"],[128,135,"G4990"]]},{"book":"TIT","chapter":1,"verse":4,"text":"To Titus, mine own son after the common faith: Grace, mercy, and peace, from God the Father and the Lord Jesus Christ our Saviour.","strongs":[[3,8,"G5103"],[15,18,"G1103"],[19,22,"G5043"],[23,28,"G2596"],[33,39,"G2839"],[40,45,"G4102"],[47,52,"G5485"],[54,59,"G1656"],[65,70,"G1515"],[72,76,"G575"],[77,80,"G2316"],[85,91,"G3962"],[92,95,"G2532"],[100,104,"G2962"],[105,110,"G2424"],[111,117,"G5547"],[118,121,"G2257"],[122,129,"G4990"]]},{"book":"TIT","chapter":1,"verse":5,"text":"For this cause left I thee in Crete, that thou shouldest set in order the things that are wanting, and ordain elders in every city, as I had appointed thee:","strongs":[[4,8,"G5127"],[9,14,"G5484"],[20,21,"G2641"],[22,26,"G4571"],[27,29,"G1722"],[30,35,"G2914"],[37,41,"G2443"],[64,69,"G1930"],[74,80,"G3588"],[90,97,"G3007"],[99,102,"G2532"],[103,109,"G2525"],[110,116,"G4245"],[120,125,"G2596"],[126,130,"G4172"],[132,134,"G5613"],[135,136,"G1473"],[141,150,"G1299"],[151,155,"G4671"]]},{"book":"TIT","chapter":1,"verse":6,"text":"If any be blameless, the husband of one wife, having faithful children not accused of riot or unruly.","strongs":[[0,2,"G1487"],[3,6,"G5100"],[7,9,"G2076"],[10,19,"G410"],[25,32,"G435"],[36,39,"G1520"],[40,44,"G1135"],[46,52,"G2192"],[53,61,"G4103"],[62,70,"G5043"],[71,74,"G3361"],[75,82,"G2724"],[86,90,"G810"],[91,93,"G2228"],[94,100,"G506"]]},{"book":"TIT","chapter":1,"verse":7,"text":"For a bishop must be blameless, as the steward of God; not selfwilled, not soon angry, not given to wine, no striker, not given to filthy lucre;","strongs":[[0,3,"G1063"],[6,12,"G1985"],[13,17,"G1163"],[18,20,"G1511"],[21,30,"G410"],[32,34,"G5613"],[39,46,"G3623"],[50,53,"G2316"],[55,58,"G3361"],[59,69,"G829"],[71,74,"G3361"],[80,85,"G3711"],[87,90,"G3361"],[100,104,"G3943"],[106,108,"G3361"],[109,116,"G4131"],[118,121,"G3361"],[138,143,"G146"]]},{"book":"TIT","chapter":1,"verse":8,"text":"But a lover of hospitality, a lover of good men, sober, just, holy, temperate;","strongs":[[0,3,"G235"],[15,26,"G5382"],[44,47,"G5358"],[49,54,"G4998"],[56,60,"G1342"],[62,66,"G3741"],[68,77,"G1468"]]},{"book":"TIT","chapter":1,"verse":9,"text":"Holding fast the faithful word as he hath been taught, that he may be able by sound doctrine both to exhort and to convince the gainsayers.","strongs":[[8,12,"G472"],[17,25,"G4103"],[26,30,"G3056"],[31,33,"G2596"],[47,53,"G1322"],[55,59,"G2443"],[67,69,"G5600"],[70,74,"G1415"],[75,77,"G1722"],[78,83,"G5198"],[84,92,"G1319"],[93,97,"G2532"],[101,107,"G3870"],[108,111,"G2532"],[115,123,"G1651"],[128,138,"G483"]]},{"book":"TIT","chapter":1,"verse":10,"text":"For there are many unruly and vain talkers and deceivers, specially they of the circumcision:","strongs":[[0,3,"G1063"],[10,13,"G1526"],[14,18,"G4183"],[19,25,"G506"],[26,29,"G2532"],[35,42,"G3151"],[43,46,"G2532"],[47,56,"G5423"],[58,67,"G3122"],[68,72,"G3588"],[73,75,"G1537"],[80,92,"G4061"]]},{"book":"TIT","chapter":1,"verse":11,"text":"Whose mouths must be stopped, who subvert whole houses, teaching things which they ought not, for filthy lucre’s sake.","strongs":[[0,5,"G3739"],[6,12,"G1993"],[13,17,"G1163"],[21,28,"G1993"],[30,33,"G3748"],[34,41,"G396"],[42,47,"G3650"],[48,54,"G3624"],[56,64,"G1321"],[72,77,"G3739"],[83,88,"G1163"],[89,92,"G3361"],[94,97,"G5484"],[98,104,"G150"],[105,112,"G2771"],[113,117,"G5484"]]},{"book":"TIT","chapter":1,"verse":12,"text":"One of themselves, even a prophet of their own, said, The Cretians are alway liars, evil beasts, slow bellies.","strongs":[[0,3,"G5100"],[4,6,"G1537"],[7,17,"G846"],[26,33,"G4396"],[37,42,"G846"],[43,46,"G2398"],[48,52,"G2036"],[58,66,"G2912"],[71,76,"G104"],[77,82,"G5583"],[84,88,"G2556"],[89,95,"G2342"],[97,101,"G692"],[102,109,"G1064"]]},{"book":"TIT","chapter":1,"verse":13,"text":"This witness is true. Wherefore rebuke them sharply, that they may be sound in the faith;","strongs":[[0,4,"G3778"],[5,12,"G3141"],[13,15,"G2076"],[16,20,"G227"],[22,31,"G1223"],[32,38,"G1651"],[39,43,"G846"],[44,51,"G664"],[53,57,"G2443"],[70,75,"G5198"],[76,78,"G1722"],[83,88,"G4102"]]},{"book":"TIT","chapter":1,"verse":14,"text":"Not giving heed to Jewish fables, and commandments of men, that turn from the truth.","strongs":[[0,3,"G3361"],[16,18,"G4337"],[19,25,"G2451"],[26,32,"G3454"],[34,37,"G2532"],[38,50,"G1785"],[54,57,"G444"],[69,73,"G654"],[78,83,"G225"]]},{"book":"TIT","chapter":1,"verse":15,"text":"Unto the pure all things are pure: but unto them that are defiled and unbelieving is nothing pure; but even their mind and conscience is defiled.","strongs":[[9,13,"G2513"],[18,24,"G3956"],[29,33,"G2513"],[35,38,"G1161"],[58,65,"G3392"],[66,69,"G2532"],[70,81,"G571"],[85,92,"G3762"],[93,97,"G2513"],[99,102,"G235"],[103,107,"G2532"],[108,113,"G846"],[114,118,"G3563"],[119,122,"G2532"],[123,133,"G4893"],[137,144,"G3392"]]},{"book":"TIT","chapter":1,"verse":16,"text":"They profess that they know God; but in works they deny him, being abominable, and disobedient, and unto every good work reprobate.","strongs":[[5,12,"G3670"],[23,27,"G1492"],[28,31,"G2316"],[33,36,"G1161"],[40,45,"G2041"],[51,55,"G720"],[61,66,"G5607"],[67,77,"G947"],[79,82,"G2532"],[83,94,"G545"],[96,99,"G2532"],[100,104,"G4314"],[105,110,"G3956"],[111,115,"G18"],[116,120,"G2041"],[121,130,"G96"]]},{"book":"TIT","chapter":2,"verse":1,"text":"But speak thou the things which become sound doctrine:","strongs":[[0,3,"G1161"],[4,9,"G2980"],[10,14,"G4771"],[26,31,"G3739"],[32,38,"G4241"],[39,44,"G5198"],[45,53,"G1319"]]},{"book":"TIT","chapter":2,"verse":2,"text":"That the aged men be sober, grave, temperate, sound in faith, in charity, in patience.","strongs":[[0,4,"G1511"],[14,17,"G4246"],[18,20,"G1511"],[21,26,"G3524"],[28,33,"G4586"],[35,44,"G4998"],[46,51,"G5198"],[55,60,"G4102"],[65,72,"G26"],[77,85,"G5281"]]},{"book":"TIT","chapter":2,"verse":3,"text":"The aged women likewise, that they be in behaviour as becometh holiness, not false accusers, not given to much wine, teachers of good things;","strongs":[[9,14,"G4247"],[15,23,"G5615"],[25,29,"G3361"],[38,40,"G1722"],[41,50,"G2688"],[63,71,"G2412"],[73,76,"G3361"],[83,91,"G1228"],[93,96,"G3361"],[97,102,"G1402"],[106,110,"G4183"],[111,115,"G3631"],[134,140,"G2567"]]},{"book":"TIT","chapter":2,"verse":4,"text":"That they may teach the young women to be sober, to love their husbands, to love their children,","strongs":[[0,4,"G2443"],[14,19,"G4994"],[30,35,"G3501"],[42,47,"G4994"],[63,71,"G5362"],[87,95,"G5388"]]},{"book":"TIT","chapter":2,"verse":5,"text":"To be discreet, chaste, keepers at home, good, obedient to their own husbands, that the word of God be not blasphemed.","strongs":[[6,14,"G4998"],[16,22,"G53"],[35,39,"G3626"],[41,45,"G18"],[47,55,"G5293"],[65,68,"G2398"],[69,77,"G435"],[79,83,"G2443"],[88,92,"G3056"],[96,99,"G2316"],[100,102,"G987"],[103,106,"G3361"],[107,117,"G987"]]},{"book":"TIT","chapter":2,"verse":6,"text":"Young men likewise exhort to be sober minded.","strongs":[[6,9,"G3501"],[10,18,"G5615"],[19,25,"G3870"],[38,44,"G4993"]]},{"book":"TIT","chapter":2,"verse":7,"text":"In all things shewing thyself a pattern of good works: in doctrine shewing uncorruptness, gravity, sincerity,","strongs":[[0,2,"G4012"],[7,13,"G3956"],[14,21,"G3930"],[22,29,"G4572"],[32,39,"G5179"],[43,47,"G2570"],[48,53,"G2041"],[55,57,"G1722"],[58,66,"G1319"],[75,88,"G90"],[90,97,"G4587"],[99,108,"G861"]]},{"book":"TIT","chapter":2,"verse":8,"text":"Sound speech, that cannot be condemned; that he that is of the contrary part may be ashamed, having no evil thing to say of you.","strongs":[[0,5,"G5199"],[6,12,"G3056"],[29,38,"G176"],[40,44,"G2443"],[53,55,"G3588"],[56,58,"G1537"],[72,76,"G1727"],[84,91,"G1788"],[93,99,"G2192"],[100,102,"G3367"],[108,113,"G5337"],[117,120,"G3004"],[121,123,"G4012"],[124,127,"G5216"]]},{"book":"TIT","chapter":2,"verse":9,"text":"Exhort servants to be obedient unto their own masters, and to please them well in all things; not answering again;","strongs":[[7,15,"G1401"],[19,21,"G1511"],[22,30,"G5293"],[42,45,"G2398"],[46,53,"G1203"],[62,68,"G2101"],[74,78,"G2101"],[79,81,"G1722"],[82,85,"G3956"],[94,97,"G3361"],[108,113,"G483"]]},{"book":"TIT","chapter":2,"verse":10,"text":"Not purloining, but shewing all good fidelity; that they may adorn the doctrine of God our Saviour in all things.","strongs":[[0,3,"G3361"],[4,14,"G3557"],[16,19,"G235"],[20,27,"G1731"],[28,31,"G3956"],[32,36,"G18"],[37,45,"G4102"],[47,51,"G2443"],[61,66,"G2885"],[71,79,"G1319"],[83,86,"G2316"],[87,90,"G2257"],[91,98,"G4990"],[99,101,"G1722"],[106,112,"G3956"]]},{"book":"TIT","chapter":2,"verse":11,"text":"For the grace of God that bringeth salvation hath appeared to all men,","strongs":[[0,3,"G1063"],[8,13,"G5485"],[17,20,"G2316"],[26,34,"G3588"],[35,44,"G4992"],[50,58,"G2014"],[62,65,"G3956"],[66,69,"G444"]]},{"book":"TIT","chapter":2,"verse":12,"text":"Teaching us that, denying ungodliness and worldly lusts, we should live soberly, righteously, and godly, in this present world;","strongs":[[0,8,"G3811"],[9,11,"G2248"],[12,16,"G2443"],[18,25,"G720"],[26,37,"G763"],[38,41,"G2532"],[42,49,"G2886"],[50,55,"G1939"],[67,71,"G2198"],[72,79,"G4996"],[81,92,"G1346"],[94,97,"G2532"],[98,103,"G2153"],[105,107,"G1722"],[108,112,"G3588"],[113,120,"G3568"],[121,126,"G165"]]},{"book":"TIT","chapter":2,"verse":13,"text":"Looking for that blessed hope, and the glorious appearing of the great God and our Saviour Jesus Christ;","strongs":[[8,11,"G4327"],[12,16,"G3588"],[17,24,"G3107"],[25,29,"G1680"],[31,34,"G2532"],[39,47,"G1391"],[48,57,"G2015"],[65,70,"G3173"],[71,74,"G2316"],[75,78,"G2532"],[79,82,"G2257"],[83,90,"G4990"],[91,96,"G2424"],[97,103,"G5547"]]},{"book":"TIT","chapter":2,"verse":14,"text":"Who gave himself for us, that he might redeem us from all iniquity, and purify unto himself a peculiar people, zealous of good works.","strongs":[[0,3,"G3739"],[4,8,"G1325"],[9,16,"G1438"],[17,20,"G5228"],[21,23,"G2257"],[25,29,"G2443"],[39,45,"G3084"],[46,48,"G2248"],[49,53,"G575"],[54,57,"G3956"],[58,66,"G458"],[68,71,"G2532"],[72,78,"G2511"],[84,91,"G1438"],[94,102,"G4041"],[103,109,"G2992"],[111,118,"G2207"],[122,126,"G2570"],[127,132,"G2041"]]},{"book":"TIT","chapter":2,"verse":15,"text":"These things speak, and exhort, and rebuke with all authority. Let no man despise thee.","strongs":[[6,12,"G5023"],[13,18,"G2980"],[20,23,"G2532"],[24,30,"G3870"],[32,35,"G2532"],[36,42,"G1651"],[43,47,"G3326"],[48,51,"G3956"],[52,61,"G2003"],[63,66,"G4065"],[70,73,"G3367"],[74,81,"G4065"],[82,86,"G4675"]]},{"book":"TIT","chapter":3,"verse":1,"text":"Put them in mind to be subject to principalities and powers, to obey magistrates, to be ready to every good work,","strongs":[[0,3,"G5279"],[4,8,"G846"],[12,16,"G5279"],[31,33,"G5293"],[34,48,"G746"],[49,52,"G2532"],[53,59,"G1849"],[69,80,"G3980"],[85,87,"G1511"],[88,93,"G2092"],[94,96,"G4314"],[97,102,"G3956"],[103,107,"G18"],[108,112,"G2041"]]},{"book":"TIT","chapter":3,"verse":2,"text":"To speak evil of no man, to be no brawlers, but gentle, shewing all meekness unto all men.","strongs":[[14,16,"G987"],[20,23,"G3367"],[28,30,"G1511"],[34,42,"G269"],[48,54,"G1933"],[56,63,"G1731"],[64,67,"G3956"],[68,76,"G4236"],[77,81,"G4314"],[82,85,"G3956"],[86,89,"G444"]]},{"book":"TIT","chapter":3,"verse":3,"text":"For we ourselves also were sometimes foolish, disobedient, deceived, serving divers lusts and pleasures, living in malice and envy, hateful, and hating one another.","strongs":[[0,3,"G1063"],[7,16,"G2249"],[17,21,"G2532"],[22,26,"G1510"],[27,36,"G4218"],[37,44,"G453"],[46,57,"G545"],[59,67,"G4105"],[69,76,"G1398"],[77,83,"G4164"],[84,89,"G1939"],[90,93,"G2532"],[94,103,"G2237"],[105,111,"G1236"],[112,114,"G1722"],[115,121,"G2549"],[122,125,"G2532"],[126,130,"G5355"],[132,139,"G4767"],[145,151,"G3404"],[156,163,"G240"]]},{"book":"TIT","chapter":3,"verse":4,"text":"But after that the kindness and love of God our Saviour toward man appeared,","strongs":[[0,3,"G1161"],[10,14,"G3753"],[19,27,"G5544"],[28,31,"G2532"],[32,36,"G5363"],[40,43,"G2316"],[44,47,"G2257"],[48,55,"G4990"],[63,66,"G5363"],[67,75,"G2014"]]},{"book":"TIT","chapter":3,"verse":5,"text":"Not by works of righteousness which we have done, but according to his mercy he saved us, by the washing of regeneration, and renewing of the Holy Ghost;","strongs":[[0,3,"G3756"],[4,6,"G1537"],[7,12,"G2041"],[13,15,"G1722"],[16,29,"G1343"],[30,35,"G3739"],[36,38,"G2249"],[44,48,"G4160"],[50,53,"G235"],[64,66,"G2596"],[67,70,"G846"],[71,76,"G1656"],[80,85,"G4982"],[86,88,"G2248"],[90,92,"G1223"],[97,104,"G3067"],[108,120,"G3824"],[122,125,"G2532"],[126,134,"G342"],[142,146,"G40"],[147,152,"G4151"]]},{"book":"TIT","chapter":3,"verse":6,"text":"Which he shed on us abundantly through Jesus Christ our Saviour;","strongs":[[0,5,"G3739"],[9,13,"G1632"],[14,16,"G1909"],[17,19,"G2248"],[20,30,"G4146"],[31,38,"G1223"],[39,44,"G2424"],[45,51,"G5547"],[52,55,"G2257"],[56,63,"G4990"]]},{"book":"TIT","chapter":3,"verse":7,"text":"That being justified by his grace, we should be made heirs according to the hope of eternal life.","strongs":[[0,4,"G2443"],[11,20,"G1344"],[24,27,"G1565"],[28,33,"G5485"],[48,52,"G1096"],[53,58,"G2818"],[69,71,"G2596"],[76,80,"G1680"],[84,91,"G166"],[92,96,"G2222"]]},{"book":"TIT","chapter":3,"verse":8,"text":"This is a faithful saying, and these things I will that thou affirm constantly, that they which have believed in God might be careful to maintain good works. These things are good and profitable unto men.","strongs":[[10,18,"G4103"],[19,25,"G3056"],[27,30,"G2532"],[37,43,"G5130"],[46,50,"G1014"],[51,55,"G1226"],[56,60,"G4571"],[68,78,"G1226"],[80,84,"G2443"],[101,109,"G4100"],[113,116,"G2316"],[126,133,"G5431"],[137,145,"G4291"],[146,150,"G2570"],[151,156,"G2041"],[164,170,"G5023"],[171,174,"G2076"],[175,179,"G2570"],[180,183,"G2532"],[184,194,"G5624"],[200,203,"G444"]]},{"book":"TIT","chapter":3,"verse":9,"text":"But avoid foolish questions, and genealogies, and contentions, and strivings about the law; for they are unprofitable and vain.","strongs":[[0,3,"G1161"],[4,9,"G4026"],[10,17,"G3474"],[18,27,"G2214"],[29,32,"G2532"],[33,44,"G1076"],[46,49,"G2532"],[50,61,"G2054"],[63,66,"G2532"],[67,76,"G3163"],[87,90,"G3544"],[92,95,"G1063"],[101,104,"G1526"],[105,117,"G512"],[118,121,"G2532"],[122,126,"G3152"]]},{"book":"TIT","chapter":3,"verse":10,"text":"A man that is an heretick after the first and second admonition reject;","strongs":[[2,5,"G444"],[17,25,"G141"],[26,31,"G3326"],[36,41,"G1520"],[42,45,"G2532"],[46,52,"G1208"],[53,63,"G3559"],[64,70,"G3868"]]},{"book":"TIT","chapter":3,"verse":11,"text":"Knowing that he that is such is subverted, and sinneth, being condemned of himself.","strongs":[[0,7,"G1492"],[8,12,"G3754"],[24,28,"G5108"],[32,41,"G1612"],[43,46,"G2532"],[47,54,"G264"],[56,61,"G5607"],[75,82,"G843"]]},{"book":"TIT","chapter":3,"verse":12,"text":"When I shall send Artemas unto thee, or Tychicus, be diligent to come unto me to Nicopolis: for I have determined there to winter.","strongs":[[0,4,"G3752"],[13,17,"G3992"],[18,25,"G734"],[26,30,"G4314"],[31,35,"G4571"],[37,39,"G2228"],[40,48,"G5190"],[53,61,"G4704"],[65,69,"G2064"],[70,74,"G4314"],[75,77,"G3165"],[78,80,"G1519"],[81,90,"G3533"],[92,95,"G1063"],[103,113,"G2919"],[114,119,"G1563"],[123,129,"G3914"]]},{"book":"TIT","chapter":3,"verse":13,"text":"Bring Zenas the lawyer and Apollos on their journey diligently, that nothing be wanting unto them.","strongs":[[0,5,"G4311"],[6,11,"G2211"],[16,22,"G3544"],[23,26,"G2532"],[27,34,"G625"],[44,51,"G4311"],[52,62,"G4709"],[64,68,"G2443"],[69,76,"G3367"],[80,87,"G3007"],[93,97,"G846"]]},{"book":"TIT","chapter":3,"verse":14,"text":"And let ours also learn to maintain good works for necessary uses, that they be not unfruitful.","strongs":[[0,3,"G1161"],[4,7,"G3129"],[8,12,"G2251"],[13,17,"G2532"],[18,23,"G3129"],[27,35,"G4291"],[36,40,"G2570"],[41,46,"G2041"],[47,50,"G1519"],[51,60,"G316"],[61,65,"G5532"],[67,71,"G2443"],[77,79,"G5600"],[80,83,"G3361"],[84,94,"G175"]]},{"book":"TIT","chapter":3,"verse":15,"text":"All that are with me salute thee. Greet them that love us in the faith. Grace be with you all. Amen.","strongs":[[9,12,"G3956"],[13,17,"G3326"],[18,20,"G1700"],[21,27,"G782"],[28,32,"G4571"],[34,39,"G782"],[50,54,"G5368"],[55,57,"G2248"],[58,60,"G1722"],[65,70,"G4102"],[72,77,"G5485"],[81,85,"G3326"],[86,89,"G5216"],[90,93,"G3956"],[95,99,"G281"]]}]}