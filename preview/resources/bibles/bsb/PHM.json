{"id":"PHM","name":"Philemon","testament":"NT","chapters":1,"verses":[{"book":"PHM","chapter":1,"verse":1,"text":"Paul, a prisoner of Christ Jesus, and Timothy our brother, To Philemon our beloved fellow worker,","strongs":[[0,4,"G3972"],[6,16,"G1198"],[17,26,"G5547"],[27,32,"G2424"],[34,37,"G2532"],[38,45,"G5095"],[46,49,"G3588"],[50,57,"G80"],[59,70,"G5371"],[71,74,"G1473"],[75,82,"G27"],[83,96,"G4904"]]},{"book":"PHM","chapter":1,"verse":2,"text":"to Apphia our sister, to Archippus our fellow soldier, and to the church that meets at your house:","strongs":[[0,9,"G682"],[10,13,"G3588"],[14,20,"G79"],[22,34,"G751"],[35,38,"G1473"],[39,53,"G4961"],[55,58,"G2532"],[59,65,"G3588"],[66,72,"G1577"],[73,86,"G2596"],[87,91,"G4771"],[92,97,"G3624"]]},{"book":"PHM","chapter":1,"verse":3,"text":"Grace and peace to you from God our Father and the Lord Jesus Christ.","strongs":[[0,5,"G5485"],[6,9,"G2532"],[10,15,"G1515"],[16,22,"G4771"],[23,27,"G575"],[28,31,"G2316"],[32,35,"G1473"],[36,42,"G3962"],[43,46,"G2532"],[47,55,"G2962"],[56,61,"G2424"],[62,68,"G5547"]]},{"book":"PHM","chapter":1,"verse":4,"text":"I always thank my God, remembering you in my prayers,","strongs":[[0,14,"G2168"],[15,17,"G1473"],[18,21,"G2316"],[23,34,"G4160"],[35,38,"G4771"],[39,41,"G1909"],[42,44,"G1473"],[45,52,"G4335"]]},{"book":"PHM","chapter":1,"verse":5,"text":"because I hear about your faith in the Lord Jesus and your love for all the saints.","strongs":[[0,20,"G191"],[21,25,"G2192"],[26,31,"G4102"],[32,34,"G4314"],[35,38,"G3588"],[39,43,"G2962"],[44,49,"G2424"],[50,53,"G2532"],[54,58,"G4771"],[59,63,"G26"],[64,67,"G1519"],[68,71,"G3956"],[72,75,"G3588"],[76,82,"G40"]]},{"book":"PHM","chapter":1,"verse":6,"text":"I pray that your partnership in the faith may become effective as you fully acknowledge every good thing that is ours in Christ.","strongs":[[0,11,"G3704"],[12,16,"G4771"],[17,28,"G2842"],[29,35,"G3588"],[36,41,"G4102"],[42,52,"G1096"],[53,62,"G1756"],[63,65,"G1722"],[66,87,"G1922"],[88,93,"G3956"],[94,104,"G18"],[105,112,"G3588"],[113,117,"G1473"],[118,120,"G1519"],[121,127,"G5547"]]},{"book":"PHM","chapter":1,"verse":7,"text":"I take great joy and encouragement in your love, because you, brother, have refreshed the hearts of the saints.","strongs":[[0,6,"G2192"],[7,12,"G4183"],[13,16,"G5479"],[17,20,"G2532"],[21,34,"G3874"],[35,37,"G1909"],[38,42,"G4771"],[43,47,"G26"],[49,56,"G3754"],[57,60,"G4771"],[62,69,"G80"],[71,85,"G373"],[86,89,"G3588"],[90,96,"G4698"],[97,103,"G3588"],[104,110,"G40"]]},{"book":"PHM","chapter":1,"verse":8,"text":"So although in Christ I am bold enough to order you to do what is proper,","strongs":[[0,2,"G1352"],[3,14,"G1722"],[15,21,"G5547"],[22,26,"G2192"],[27,31,"G3954"],[32,38,"G4183"],[39,47,"G2004"],[48,57,"G4771"],[58,65,"G3588"],[66,72,"G433"]]},{"book":"PHM","chapter":1,"verse":9,"text":"I prefer to appeal on the basis of love. For I, Paul, am now aged, and a prisoner of Christ Jesus as well.","strongs":[[0,18,"G3870"],[19,34,"G1223"],[35,39,"G26"],[41,44,"G5613"],[45,46,"G5108"],[48,52,"G3972"],[54,56,"G1510"],[57,60,"G3570"],[61,65,"G4246"],[67,70,"G1161"],[71,81,"G1198"],[82,91,"G5547"],[92,97,"G2424"],[98,105,"G2532"]]},{"book":"PHM","chapter":1,"verse":10,"text":"I appeal to you for my child Onesimus, whose father I became while I was in chains.","strongs":[[0,8,"G3870"],[9,15,"G4771"],[16,19,"G4012"],[20,22,"G1699"],[23,28,"G5043"],[29,37,"G3682"],[39,44,"G3739"],[45,60,"G1080"],[61,75,"G1722"],[76,82,"G1199"]]},{"book":"PHM","chapter":1,"verse":11,"text":"Formerly he was useless to you, but now he has become useful both to you and to me.","strongs":[[0,8,"G4218"],[9,23,"G890"],[24,30,"G4771"],[32,35,"G1161"],[36,39,"G3570"],[40,60,"G2173"],[61,65,"G2532"],[66,72,"G4771"],[73,76,"G2532"],[77,82,"G1473"]]},{"book":"PHM","chapter":1,"verse":12,"text":"I am sending back to you him who is my very heart.","strongs":[[0,17,"G375"],[18,24,"G4771"],[25,28,"G846"],[29,32,"G3778"],[33,35,"G1510"],[36,38,"G1699"],[39,49,"G4698"]]},{"book":"PHM","chapter":1,"verse":13,"text":"I would have liked to keep him with me, so that on your behalf he could minister to me in my chains for the gospel.","strongs":[[0,1,"G1473"],[2,18,"G1014"],[19,26,"G2722"],[27,30,"G3739"],[31,35,"G4314"],[36,38,"G1683"],[40,47,"G2443"],[48,62,"G4771"],[63,83,"G1247"],[84,86,"G1473"],[87,89,"G1722"],[90,92,"G3588"],[93,99,"G1199"],[100,107,"G3588"],[108,114,"G2098"]]},{"book":"PHM","chapter":1,"verse":14,"text":"But I did not want to do anything without your consent, so that your goodness will not be out of compulsion, but by your own free will.","strongs":[[0,3,"G1161"],[4,18,"G2309"],[19,24,"G4160"],[25,33,"G3762"],[34,41,"G5565"],[42,46,"G4674"],[47,54,"G1106"],[56,63,"G2443"],[64,68,"G4771"],[69,77,"G18"],[78,89,"G1510"],[90,96,"G2596"],[97,107,"G318"],[109,112,"G235"],[113,115,"G2596"],[116,134,"G1595"]]},{"book":"PHM","chapter":1,"verse":15,"text":"For perhaps this is why he was separated from you for a while, so that you might have him back for good—","strongs":[[0,3,"G1063"],[4,11,"G5029"],[12,23,"G1223"],[24,49,"G5563"],[50,53,"G4314"],[54,61,"G5610"],[63,70,"G2443"],[71,94,"G568"],[95,103,"G166"]]},{"book":"PHM","chapter":1,"verse":16,"text":"no longer as a slave, but better than a slave, as a beloved brother. He is especially beloved to me, but even more so to you, both in person and in the Lord.","strongs":[[0,9,"G3765"],[10,12,"G5613"],[13,20,"G1401"],[22,25,"G235"],[26,37,"G5228"],[38,45,"G1401"],[47,59,"G27"],[60,67,"G80"],[69,93,"G3122"],[94,99,"G1473"],[101,104,"G1161"],[105,117,"G4214"],[118,124,"G4771"],[126,130,"G2532"],[131,133,"G1722"],[134,140,"G4561"],[141,144,"G2532"],[145,147,"G1722"],[148,156,"G2962"]]},{"book":"PHM","chapter":1,"verse":17,"text":"So if you consider me a partner, receive him as you would receive me.","strongs":[[0,2,"G3767"],[3,5,"G1487"],[6,18,"G2192"],[19,21,"G1473"],[22,31,"G2844"],[33,40,"G4355"],[41,44,"G846"],[45,65,"G5613"],[66,68,"G1473"]]},{"book":"PHM","chapter":1,"verse":18,"text":"But if he has wronged you in any way or owes you anything, charge it to my account.","strongs":[[0,3,"G1161"],[4,6,"G1487"],[7,21,"G91"],[22,25,"G4771"],[26,36,"G5100"],[37,39,"G2228"],[40,57,"G3784"],[59,82,"G1677"]]},{"book":"PHM","chapter":1,"verse":19,"text":"I, Paul, write this with my own hand. I will repay it—not to mention that you owe me your very self.","strongs":[[0,1,"G1473"],[3,7,"G3972"],[9,19,"G1125"],[20,24,"G3588"],[25,31,"G1699"],[32,36,"G5495"],[38,39,"G1473"],[40,53,"G661"],[54,57,"G3361"],[58,60,"G2443"],[61,68,"G3004"],[69,73,"G3754"],[74,81,"G4359"],[82,84,"G1473"],[85,99,"G4572"]]},{"book":"PHM","chapter":1,"verse":20,"text":"Yes, brother, let me have some benefit from you in the Lord. Refresh my heart in Christ.","strongs":[[0,3,"G3483"],[5,12,"G80"],[14,38,"G3685"],[39,47,"G4771"],[48,50,"G1722"],[51,59,"G2962"],[61,68,"G373"],[69,71,"G1473"],[72,77,"G4698"],[78,80,"G1722"],[81,87,"G5547"]]},{"book":"PHM","chapter":1,"verse":21,"text":"Confident of your obedience, I write to you, knowing that you will do even more than I ask.","strongs":[[0,12,"G3982"],[13,17,"G4771"],[18,27,"G5218"],[29,36,"G1125"],[37,43,"G4771"],[45,52,"G1492"],[53,57,"G3754"],[58,69,"G4160"],[70,74,"G2532"],[75,79,"G5228"],[80,84,"G3739"],[85,90,"G3004"]]},{"book":"PHM","chapter":1,"verse":22,"text":"In the meantime, prepare a guest room for me, because I hope that through your prayers I will be restored to you.","strongs":[[0,15,"G1161"],[17,24,"G2090"],[25,37,"G3578"],[38,44,"G1473"],[46,53,"G1063"],[54,60,"G1679"],[61,65,"G3754"],[66,73,"G1223"],[74,78,"G4771"],[79,86,"G4335"],[87,105,"G5483"],[106,112,"G4771"]]},{"book":"PHM","chapter":1,"verse":23,"text":"Epaphras, my fellow prisoner in Christ Jesus, sends you greetings,","strongs":[[0,8,"G1889"],[10,12,"G1473"],[13,28,"G4869"],[29,31,"G1722"],[32,38,"G5547"],[39,44,"G2424"],[46,65,"G782"]]},{"book":"PHM","chapter":1,"verse":24,"text":"as do Mark, Aristarchus, Demas, and Luke, my fellow workers.","strongs":[[0,10,"G3138"],[12,23,"G708"],[25,30,"G1214"],[32,40,"G3065"],[42,44,"G1473"],[45,59,"G4904"]]},{"book":"PHM","chapter":1,"verse":25,"text":"The grace of the Lord Jesus Christ be with your spirit.","strongs":[[0,3,"G3588"],[4,9,"G5485"],[10,16,"G3588"],[17,21,"G2962"],[22,27,"G2424"],[28,34,"G5547"],[35,42,"G3326"],[43,47,"G4771"],[48,54,"G4151"]]}]}