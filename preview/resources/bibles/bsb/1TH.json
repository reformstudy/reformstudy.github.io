{"id":"1TH","name":"1 Thessalonians","testament":"NT","chapters":5,"verses":[{"book":"1TH","chapter":1,"verse":1,"text":"Paul, Silvanus, and Timothy, To the church of the Thessalonians in God the Father and the Lord Jesus Christ: Grace and peace to you.","strongs":[[0,4,"G3972"],[6,14,"G4610"],[16,19,"G2532"],[20,27,"G5095"],[29,35,"G3588"],[36,42,"G1577"],[43,63,"G2331"],[64,66,"G1722"],[67,70,"G2316"],[71,81,"G3962"],[82,85,"G2532"],[86,94,"G2962"],[95,100,"G2424"],[101,107,"G5547"],[109,114,"G5485"],[115,118,"G2532"],[119,124,"G1515"],[125,131,"G4771"]]},{"book":"1TH","chapter":1,"verse":2,"text":"We always thank God for all of you, remembering you in our prayers","strongs":[[0,15,"G2168"],[16,19,"G2316"],[20,23,"G4012"],[24,27,"G3956"],[28,34,"G4771"],[36,51,"G4160"],[52,54,"G1909"],[55,58,"G1473"],[59,66,"G4335"]]},{"book":"1TH","chapter":1,"verse":3,"text":"and continually recalling before our God and Father your work of faith, your labor of love, and your enduring hope in our Lord Jesus Christ.","strongs":[[0,15,"G89"],[16,25,"G3421"],[26,32,"G1715"],[33,36,"G1473"],[37,40,"G2316"],[41,44,"G2532"],[45,51,"G3962"],[52,56,"G4771"],[57,61,"G2041"],[62,70,"G4102"],[72,76,"G3588"],[77,82,"G2873"],[83,90,"G26"],[92,95,"G2532"],[96,100,"G3588"],[101,109,"G5281"],[110,114,"G1680"],[115,117,"G3588"],[118,121,"G1473"],[122,126,"G2962"],[127,132,"G2424"],[133,139,"G5547"]]},{"book":"1TH","chapter":1,"verse":4,"text":"Brothers who are beloved by God, we know that He has chosen you,","strongs":[[0,8,"G80"],[9,24,"G25"],[25,27,"G5259"],[28,31,"G2316"],[33,40,"G1492"],[41,59,"G1589"],[60,63,"G4771"]]},{"book":"1TH","chapter":1,"verse":5,"text":"because our gospel came to you not only in word, but also in power, in the Holy Spirit, and with great conviction—just as you know we lived among you for your sake.","strongs":[[0,7,"G3754"],[8,11,"G1473"],[12,18,"G2098"],[19,23,"G1096"],[24,26,"G1519"],[27,30,"G4771"],[31,34,"G3756"],[35,39,"G3440"],[40,42,"G1722"],[43,47,"G3056"],[49,52,"G235"],[53,57,"G2532"],[58,60,"G1722"],[61,66,"G1411"],[68,70,"G1722"],[71,79,"G40"],[80,86,"G4151"],[88,91,"G2532"],[92,96,"G1722"],[97,102,"G4183"],[103,113,"G4136"],[114,121,"G2531"],[122,130,"G1492"],[131,139,"G1096"],[140,145,"G1722"],[146,149,"G4771"],[150,163,"G1223"]]},{"book":"1TH","chapter":1,"verse":6,"text":"And you became imitators of us and of the Lord when you welcomed the message with the joy of the Holy Spirit, in spite of your great suffering.","strongs":[[0,3,"G2532"],[4,7,"G4771"],[8,14,"G1096"],[15,24,"G3402"],[25,30,"G1473"],[31,34,"G2532"],[35,41,"G3588"],[42,46,"G2962"],[47,64,"G1209"],[65,68,"G3588"],[69,76,"G3056"],[77,81,"G3326"],[82,89,"G5479"],[90,101,"G40"],[102,108,"G4151"],[110,126,"G1722"],[127,132,"G4183"],[133,142,"G2347"]]},{"book":"1TH","chapter":1,"verse":7,"text":"As a result, you have become an example to all the believers in Macedonia and Achaia.","strongs":[[0,11,"G5620"],[13,16,"G4771"],[17,28,"G1096"],[29,39,"G5179"],[40,46,"G3956"],[47,50,"G3588"],[51,60,"G4100"],[61,63,"G1722"],[64,73,"G3109"],[74,77,"G2532"],[78,84,"G882"]]},{"book":"1TH","chapter":1,"verse":8,"text":"For not only did the message of the Lord ring out from you to Macedonia and Achaia, but your faith in God has gone out to every place, so that we have no need to say anything more.","strongs":[[0,3,"G1063"],[4,7,"G3756"],[8,12,"G3440"],[13,20,"G3588"],[21,28,"G3056"],[29,35,"G3588"],[36,40,"G2962"],[41,49,"G1837"],[50,54,"G575"],[55,58,"G4771"],[59,61,"G1722"],[62,71,"G3109"],[72,75,"G2532"],[76,82,"G882"],[84,87,"G235"],[88,92,"G4771"],[93,98,"G4102"],[99,101,"G4314"],[102,105,"G2316"],[106,118,"G1831"],[119,121,"G1722"],[122,127,"G3956"],[128,133,"G5117"],[135,142,"G5620"],[143,145,"G1473"],[146,150,"G2192"],[151,153,"G3361"],[154,158,"G5532"],[159,165,"G2980"],[166,179,"G5100"]]},{"book":"1TH","chapter":1,"verse":9,"text":"For they themselves report what kind of welcome you gave us, and how you turned to God from idols to serve the living and true God","strongs":[[0,3,"G1063"],[4,19,"G846"],[20,26,"G518"],[27,36,"G3697"],[37,47,"G1529"],[48,59,"G2192"],[61,64,"G2532"],[65,68,"G4459"],[69,79,"G1994"],[80,82,"G4314"],[83,86,"G2316"],[87,91,"G575"],[92,97,"G1497"],[98,106,"G1398"],[107,117,"G2198"],[118,121,"G2532"],[122,126,"G228"],[127,130,"G2316"]]},{"book":"1TH","chapter":1,"verse":10,"text":"and to await His Son from heaven, whom He raised from the dead—Jesus our deliverer from the coming wrath.","strongs":[[0,3,"G2532"],[4,12,"G362"],[13,16,"G846"],[17,20,"G5207"],[21,25,"G1537"],[26,32,"G3772"],[34,38,"G3739"],[39,48,"G1453"],[49,53,"G1537"],[54,57,"G3588"],[58,62,"G3498"],[63,68,"G2424"],[69,72,"G1473"],[73,82,"G4506"],[83,87,"G1537"],[88,91,"G3588"],[92,98,"G2064"],[99,104,"G3709"]]},{"book":"1TH","chapter":2,"verse":1,"text":"You yourselves know, brothers, that our visit to you was not in vain.","strongs":[[0,14,"G846"],[15,19,"G1492"],[21,29,"G80"],[31,35,"G3754"],[36,39,"G1473"],[40,45,"G1529"],[46,48,"G4314"],[49,52,"G4771"],[53,56,"G1096"],[57,60,"G3756"],[61,68,"G2756"]]},{"book":"1TH","chapter":2,"verse":2,"text":"As you are aware, we had already endured suffering and shameful treatment in Philippi. But in the face of strong opposition, we were bold in our God to speak to you the gospel of God.","strongs":[[0,2,"G2531"],[3,16,"G1492"],[18,50,"G4310"],[51,54,"G2532"],[55,73,"G5195"],[74,76,"G1722"],[77,85,"G5375"],[87,90,"G235"],[91,105,"G1722"],[106,112,"G4183"],[113,123,"G73"],[125,137,"G3955"],[138,140,"G1722"],[141,144,"G1473"],[145,148,"G2316"],[149,157,"G2980"],[158,160,"G4314"],[161,164,"G4771"],[165,168,"G3588"],[169,175,"G2098"],[176,182,"G2316"]]},{"book":"1TH","chapter":2,"verse":3,"text":"For our appeal does not arise from deceit or ulterior motives or trickery.","strongs":[[0,3,"G1063"],[4,7,"G1473"],[8,14,"G3874"],[15,23,"G3756"],[24,34,"G1537"],[35,41,"G4106"],[42,44,"G3761"],[45,61,"G167"],[62,64,"G3761"],[65,73,"G1388"]]},{"book":"1TH","chapter":2,"verse":4,"text":"Instead, we speak as those approved by God to be entrusted with the gospel, not in order to please men but God, who examines our hearts.","strongs":[[0,7,"G235"],[9,17,"G2980"],[18,20,"G2531"],[21,35,"G1381"],[36,38,"G5259"],[39,42,"G2316"],[43,63,"G4100"],[64,67,"G3588"],[68,74,"G2098"],[76,79,"G3756"],[80,91,"G5613"],[92,98,"G700"],[99,102,"G444"],[103,106,"G235"],[107,110,"G2316"],[112,115,"G3588"],[116,124,"G1381"],[125,128,"G1473"],[129,135,"G2588"]]},{"book":"1TH","chapter":2,"verse":5,"text":"As you know, we never used words of flattery or any pretext for greed. God is our witness!","strongs":[[0,2,"G2531"],[3,11,"G1492"],[13,26,"G1096"],[27,32,"G3056"],[33,44,"G2850"],[45,47,"G3777"],[48,59,"G4392"],[60,69,"G4124"],[71,77,"G2316"],[78,89,"G3144"]]},{"book":"1TH","chapter":2,"verse":6,"text":"Nor did we seek praise from you or from anyone else, although as apostles of Christ we had authority to demand it.","strongs":[[0,3,"G3777"],[4,15,"G2212"],[16,22,"G1391"],[23,27,"G575"],[28,31,"G4771"],[32,34,"G3777"],[35,39,"G575"],[40,51,"G243"],[53,64,"G5613"],[65,73,"G652"],[74,83,"G5547"],[84,100,"G1410"],[101,113,"G922"]]},{"book":"1TH","chapter":2,"verse":7,"text":"On the contrary, we were gentle among you, like a nursing mother caring for her children.","strongs":[[0,15,"G235"],[17,24,"G1096"],[25,31,"G3516"],[32,37,"G1722"],[38,41,"G4771"],[43,47,"G5613"],[48,64,"G5162"],[65,75,"G2282"],[76,79,"G1438"],[80,88,"G5043"]]},{"book":"1TH","chapter":2,"verse":8,"text":"We cared so deeply that we were delighted to share with you not only the gospel of God, but our own lives as well. That is how beloved you have become to us.","strongs":[[0,18,"G2442"],[19,41,"G2106"],[42,55,"G3330"],[56,59,"G4771"],[60,63,"G3756"],[64,68,"G3440"],[69,72,"G3588"],[73,79,"G2098"],[80,86,"G2316"],[88,91,"G235"],[92,95,"G3588"],[96,99,"G1438"],[100,105,"G5590"],[106,113,"G2532"],[115,126,"G1360"],[127,134,"G27"],[135,150,"G1096"],[151,156,"G1473"]]},{"book":"1TH","chapter":2,"verse":9,"text":"Surely you recall, brothers, our labor and toil. We worked night and day so that we would not be a burden to anyone while we proclaimed to you the gospel of God.","strongs":[[0,17,"G3421"],[19,27,"G80"],[29,32,"G1473"],[33,38,"G2873"],[39,42,"G2532"],[43,47,"G3449"],[49,58,"G2038"],[59,64,"G3571"],[65,68,"G2532"],[69,72,"G2250"],[73,80,"G4314"],[81,105,"G1912"],[106,115,"G5100"],[116,135,"G2784"],[136,138,"G1519"],[139,142,"G4771"],[143,146,"G3588"],[147,153,"G2098"],[154,160,"G2316"]]},{"book":"1TH","chapter":2,"verse":10,"text":"You are witnesses, and so is God, of how holy, righteous, and blameless our conduct was among you who believed.","strongs":[[0,7,"G4771"],[8,17,"G3144"],[19,28,"G2532"],[29,32,"G2316"],[34,40,"G5613"],[41,45,"G3743"],[47,56,"G1346"],[58,61,"G2532"],[62,71,"G274"],[72,87,"G1096"],[88,97,"G4771"],[98,101,"G3588"],[102,110,"G4100"]]},{"book":"1TH","chapter":2,"verse":11,"text":"For you know that we treated each of you as a father treats his own children—","strongs":[[0,3,"G2509"],[4,12,"G1492"],[13,28,"G5613"],[29,33,"G1538"],[34,40,"G4771"],[41,43,"G5613"],[44,52,"G3962"],[53,67,"G1438"],[68,76,"G5043"]]},{"book":"1TH","chapter":2,"verse":12,"text":"encouraging you, comforting you, and urging you to walk in a manner worthy of God, who calls you into His own kingdom and glory.","strongs":[[0,15,"G3870"],[17,27,"G3888"],[28,31,"G4771"],[33,36,"G2532"],[37,43,"G3143"],[44,47,"G4771"],[48,55,"G4043"],[56,74,"G516"],[75,81,"G2316"],[83,86,"G3588"],[87,92,"G2564"],[93,96,"G4771"],[97,101,"G1519"],[102,109,"G1438"],[110,117,"G932"],[118,121,"G2532"],[122,127,"G1391"]]},{"book":"1TH","chapter":2,"verse":13,"text":"And we continually thank God because, when you received the word of God that you heard from us, you accepted it not as the word of men, but as it truly is, the word of God, which is also now at work in you who believe.","strongs":[[0,3,"G2532"],[4,6,"G1473"],[7,18,"G89"],[19,24,"G2168"],[25,28,"G2316"],[29,36,"G1223"],[38,55,"G3880"],[56,64,"G3056"],[65,71,"G2316"],[72,86,"G189"],[87,91,"G3844"],[92,94,"G1473"],[96,111,"G1209"],[112,115,"G3756"],[116,127,"G3056"],[128,134,"G444"],[136,139,"G235"],[140,142,"G2531"],[143,154,"G230"],[156,164,"G3056"],[165,171,"G2316"],[173,181,"G3739"],[182,186,"G2532"],[187,198,"G1754"],[199,201,"G1722"],[202,205,"G4771"],[206,209,"G3588"],[210,217,"G4100"]]},{"book":"1TH","chapter":2,"verse":14,"text":"For you, brothers, became imitators of the churches of God in Judea that are in Christ Jesus. You suffered from your own countrymen the very things they suffered from the Jews,","strongs":[[0,3,"G1063"],[4,7,"G4771"],[9,17,"G80"],[19,25,"G1096"],[26,35,"G3402"],[36,42,"G3588"],[43,51,"G1577"],[52,58,"G2316"],[59,61,"G1722"],[62,67,"G2449"],[68,72,"G3588"],[73,76,"G1510"],[77,79,"G1722"],[80,86,"G5547"],[87,92,"G2424"],[94,97,"G4771"],[98,106,"G3958"],[107,111,"G5259"],[112,116,"G3588"],[117,120,"G2398"],[121,131,"G4853"],[132,147,"G3588"],[148,152,"G846"],[153,161,"G2532"],[162,166,"G5259"],[167,170,"G3588"],[171,175,"G2453"]]},{"book":"1TH","chapter":2,"verse":15,"text":"who killed both the Lord Jesus and their own prophets and drove us out as well. They are displeasing to God and hostile to all men,","strongs":[[0,3,"G3588"],[4,10,"G615"],[11,15,"G2532"],[16,19,"G3588"],[20,24,"G2962"],[25,30,"G2424"],[31,34,"G2532"],[35,44,"G3588"],[45,53,"G4396"],[54,57,"G2532"],[58,78,"G1559"],[80,100,"G700"],[101,107,"G2316"],[108,111,"G2532"],[112,119,"G1727"],[120,126,"G3956"],[127,130,"G444"]]},{"book":"1TH","chapter":2,"verse":16,"text":"hindering us from telling the Gentiles how they may be saved. As a result, they continue to heap up their sins to full capacity; the utmost wrath has come upon them.","strongs":[[0,9,"G2967"],[10,12,"G1473"],[13,25,"G2980"],[26,29,"G3588"],[30,38,"G1484"],[39,42,"G2443"],[43,60,"G4982"],[62,73,"G1519"],[75,88,"G3842"],[89,99,"G378"],[100,105,"G846"],[106,127,"G266"],[129,132,"G1519"],[133,139,"G5056"],[140,145,"G3709"],[146,154,"G5348"],[155,159,"G1909"],[160,164,"G846"]]},{"book":"1TH","chapter":2,"verse":17,"text":"Brothers, although we were torn away from you for a short time (in person, not in heart), our desire to see you face to face was even more intense.","strongs":[[0,8,"G80"],[10,18,"G1161"],[19,21,"G1473"],[22,36,"G642"],[37,41,"G575"],[42,45,"G4771"],[46,49,"G4314"],[50,62,"G2540"],[64,73,"G4383"],[75,78,"G3756"],[79,87,"G2588"],[90,93,"G1722"],[94,100,"G1939"],[101,107,"G3708"],[108,111,"G4771"],[112,124,"G4383"],[125,146,"G4704"]]},{"book":"1TH","chapter":2,"verse":18,"text":"For we wanted to come to you—indeed I, Paul, tried again and again—but Satan obstructed us.","strongs":[[0,3,"G1360"],[4,13,"G2309"],[14,21,"G2064"],[22,24,"G4314"],[25,28,"G4771"],[29,35,"G3303"],[36,37,"G1473"],[39,43,"G3972"],[45,50,"G2532"],[51,56,"G530"],[57,60,"G2532"],[61,66,"G1364"],[67,70,"G2532"],[71,76,"G4567"],[77,87,"G1465"],[88,90,"G1473"]]},{"book":"1TH","chapter":2,"verse":19,"text":"After all, who is our hope, our joy, our crown of boasting, if it is not you yourselves in the presence of our Lord Jesus at His coming?","strongs":[[0,9,"G1063"],[11,17,"G5101"],[18,21,"G1473"],[22,26,"G1680"],[28,31,"G2228"],[32,35,"G5479"],[37,40,"G2228"],[41,46,"G4735"],[47,58,"G2746"],[60,68,"G2228"],[69,72,"G3780"],[73,87,"G4771"],[88,106,"G1715"],[107,110,"G1473"],[111,115,"G2962"],[116,121,"G2424"],[122,124,"G1722"],[125,128,"G846"],[129,135,"G3952"]]},{"book":"1TH","chapter":2,"verse":20,"text":"You are indeed our glory and our joy.","strongs":[[0,3,"G4771"],[4,7,"G1510"],[8,14,"G1063"],[15,18,"G1473"],[19,24,"G1391"],[25,28,"G2532"],[29,32,"G3588"],[33,36,"G5479"]]},{"book":"1TH","chapter":3,"verse":1,"text":"So when we could bear it no longer, we were willing to be left on our own in Athens.","strongs":[[0,2,"G1352"],[3,24,"G4722"],[25,34,"G3371"],[36,51,"G2106"],[52,62,"G2641"],[63,73,"G3441"],[74,76,"G1722"],[77,83,"G116"]]},{"book":"1TH","chapter":3,"verse":2,"text":"We sent Timothy, our brother and fellow worker for God in the gospel of Christ, to strengthen and encourage you in your faith,","strongs":[[0,7,"G3992"],[8,15,"G5095"],[17,20,"G1473"],[21,28,"G80"],[29,32,"G2532"],[33,46,"G4904"],[47,54,"G2316"],[55,57,"G1722"],[58,61,"G3588"],[62,68,"G2098"],[69,78,"G5547"],[80,82,"G1519"],[83,93,"G4741"],[94,97,"G2532"],[98,107,"G3870"],[108,111,"G4771"],[112,114,"G5228"],[115,119,"G4771"],[120,125,"G4102"]]},{"book":"1TH","chapter":3,"verse":3,"text":"so that none of you would be shaken by these trials. For you know that we are destined for this.","strongs":[[0,7,"G3588"],[8,19,"G3367"],[20,35,"G4525"],[36,38,"G1722"],[39,44,"G3778"],[45,51,"G2347"],[53,56,"G1063"],[57,60,"G846"],[61,65,"G1492"],[66,70,"G3754"],[71,86,"G2749"],[87,90,"G1519"],[91,95,"G3778"]]},{"book":"1TH","chapter":3,"verse":4,"text":"Indeed, when we were with you, we kept warning you that we would suffer persecution; and as you know, it has come to pass.","strongs":[[0,6,"G1063"],[8,12,"G3753"],[13,20,"G1510"],[21,25,"G4314"],[26,29,"G4771"],[31,50,"G4302"],[51,55,"G3754"],[56,64,"G3195"],[65,83,"G2346"],[85,91,"G2531"],[92,100,"G1492"],[102,121,"G1096"]]},{"book":"1TH","chapter":3,"verse":5,"text":"For this reason, when I could bear it no longer, I sent to find out about your faith, for fear that the tempter had somehow tempted you and that our labor might have been in vain.","strongs":[[0,15,"G1223"],[17,37,"G4722"],[38,47,"G3371"],[49,50,"G2504"],[51,55,"G3992"],[56,58,"G1519"],[59,73,"G1097"],[74,78,"G4771"],[79,84,"G4102"],[86,99,"G3361"],[100,103,"G3588"],[104,111,"G3985"],[112,123,"G4459"],[124,131,"G3985"],[132,135,"G4771"],[136,144,"G2532"],[145,148,"G1473"],[149,154,"G2873"],[155,170,"G1096"],[171,173,"G1519"],[174,178,"G2756"]]},{"book":"1TH","chapter":3,"verse":6,"text":"But just now, Timothy has returned from his visit with the good news about your faith, your love, and the fond memories you have preserved, longing to see us just as we long to see you.","strongs":[[0,3,"G1161"],[4,12,"G737"],[14,21,"G5095"],[22,34,"G2064"],[35,39,"G575"],[40,49,"G4771"],[50,68,"G2097"],[69,79,"G4771"],[80,85,"G4102"],[87,91,"G3588"],[92,96,"G26"],[98,101,"G2532"],[102,110,"G18"],[111,119,"G3417"],[120,138,"G2192"],[140,147,"G1971"],[148,154,"G3708"],[155,157,"G1473"],[158,165,"G2509"],[166,168,"G1473"],[169,180,"G2532"],[181,184,"G4771"]]},{"book":"1TH","chapter":3,"verse":7,"text":"For this reason, brothers, in all our distress and persecution, we have been reassured about you, because of your faith.","strongs":[[0,15,"G1223"],[17,25,"G80"],[27,29,"G1909"],[30,33,"G3956"],[34,37,"G1473"],[38,46,"G318"],[47,50,"G2532"],[51,62,"G2347"],[64,86,"G3870"],[87,92,"G1909"],[93,96,"G4771"],[98,108,"G1223"],[109,113,"G4771"],[114,119,"G4102"]]},{"book":"1TH","chapter":3,"verse":8,"text":"For now we can go on living, as long as you are standing firm in the Lord.","strongs":[[0,3,"G3754"],[4,7,"G3568"],[8,27,"G2198"],[29,39,"G1437"],[40,43,"G4771"],[44,61,"G4739"],[62,64,"G1722"],[65,73,"G2962"]]},{"book":"1TH","chapter":3,"verse":9,"text":"How can we adequately thank God for you in return for our great joy over you in His presence?","strongs":[[0,3,"G5101"],[4,10,"G1410"],[11,27,"G2169"],[28,31,"G2316"],[32,35,"G4012"],[36,39,"G4771"],[40,53,"G1909"],[54,67,"G5463"],[68,72,"G1223"],[73,76,"G4771"],[77,92,"G1715"]]},{"book":"1TH","chapter":3,"verse":10,"text":"Night and day we pray most earnestly that we may see you face to face and supply what is lacking in your faith.","strongs":[[0,5,"G3571"],[6,9,"G2532"],[10,13,"G2250"],[14,21,"G1189"],[22,36,"G5228"],[37,41,"G1519"],[42,52,"G3708"],[53,56,"G4771"],[57,69,"G4383"],[70,73,"G2532"],[74,80,"G2675"],[81,85,"G3588"],[86,96,"G5303"],[97,104,"G4771"],[105,110,"G4102"]]},{"book":"1TH","chapter":3,"verse":11,"text":"Now may our God and Father Himself, and our Lord Jesus, direct our way to you.","strongs":[[0,3,"G1161"],[4,11,"G1473"],[12,15,"G2316"],[16,19,"G2532"],[20,26,"G3962"],[27,34,"G846"],[36,39,"G2532"],[40,43,"G1473"],[44,48,"G2962"],[49,54,"G2424"],[56,62,"G2720"],[63,66,"G1473"],[67,70,"G3598"],[71,73,"G4314"],[74,77,"G4771"]]},{"book":"1TH","chapter":3,"verse":12,"text":"And may the Lord cause you to increase and overflow with love for one another and for everyone else, just as our love for you overflows,","strongs":[[0,3,"G1161"],[4,11,"G3588"],[12,16,"G2962"],[17,38,"G4121"],[39,42,"G2532"],[43,51,"G4052"],[52,61,"G26"],[62,65,"G1519"],[66,77,"G240"],[78,81,"G2532"],[82,85,"G1519"],[86,99,"G3956"],[101,108,"G2509"],[109,112,"G1473"],[113,117,"G2532"],[118,121,"G1519"],[122,135,"G4771"]]},{"book":"1TH","chapter":3,"verse":13,"text":"so that He may establish your hearts in blamelessness and holiness before our God and Father at the coming of our Lord Jesus with all His saints. Amen.","strongs":[[0,7,"G1519"],[8,24,"G4741"],[25,29,"G4771"],[30,36,"G2588"],[37,53,"G273"],[54,57,"G1722"],[58,66,"G42"],[67,73,"G1715"],[74,77,"G1473"],[78,81,"G2316"],[82,85,"G2532"],[86,92,"G3962"],[93,95,"G1722"],[96,99,"G3588"],[100,106,"G3952"],[107,113,"G1473"],[114,118,"G2962"],[119,124,"G2424"],[125,129,"G3326"],[130,133,"G3956"],[134,137,"G846"],[138,144,"G40"],[146,150,"G281"]]},{"book":"1TH","chapter":4,"verse":1,"text":"Finally, brothers, we ask and encourage you in the Lord Jesus to live in a way that is pleasing to God, just as you have received from us. This is how you already live, so you should do so all the more.","strongs":[[0,7,"G3063"],[9,17,"G80"],[19,25,"G2065"],[26,29,"G2532"],[30,39,"G3870"],[40,43,"G4771"],[44,46,"G1722"],[47,55,"G2962"],[56,61,"G2424"],[62,69,"G4043"],[70,78,"G4459"],[79,95,"G700"],[96,102,"G2316"],[104,111,"G2531"],[112,129,"G3880"],[130,134,"G3844"],[135,137,"G1473"],[139,150,"G2531"],[151,167,"G4043"],[169,171,"G2443"],[172,188,"G4052"],[189,201,"G3123"]]},{"book":"1TH","chapter":4,"verse":2,"text":"For you know the instructions we gave you by the authority of the Lord Jesus.","strongs":[[0,3,"G1063"],[4,12,"G1492"],[13,16,"G5101"],[17,29,"G3852"],[30,37,"G1325"],[38,41,"G4771"],[42,61,"G1223"],[62,65,"G3588"],[66,70,"G2962"],[71,76,"G2424"]]},{"book":"1TH","chapter":4,"verse":3,"text":"For it is God’s will that you should be holy: You must abstain from sexual immorality;","strongs":[[0,3,"G1063"],[4,9,"G1510"],[10,15,"G2316"],[16,20,"G2307"],[21,25,"G3778"],[26,29,"G4771"],[30,44,"G38"],[46,49,"G4771"],[50,62,"G568"],[63,67,"G575"],[68,85,"G4202"]]},{"book":"1TH","chapter":4,"verse":4,"text":"each of you must know how to control his own body in holiness and honor,","strongs":[[0,4,"G1538"],[5,11,"G4771"],[12,25,"G1492"],[26,36,"G2932"],[37,40,"G1438"],[41,44,"G3588"],[45,49,"G4632"],[50,52,"G1722"],[53,61,"G38"],[62,65,"G2532"],[66,71,"G5092"]]},{"book":"1TH","chapter":4,"verse":5,"text":"not in lustful passion like the Gentiles who do not know God;","strongs":[[0,3,"G3361"],[4,6,"G1722"],[7,14,"G1939"],[15,22,"G3806"],[23,27,"G2509"],[28,31,"G3588"],[32,40,"G1484"],[41,44,"G3588"],[45,56,"G1492"],[57,60,"G2316"]]},{"book":"1TH","chapter":4,"verse":6,"text":"and no one should ever violate or exploit his brother in this regard, because the Lord will avenge all such acts, as we have already told you and solemnly warned you.","strongs":[[0,10,"G3361"],[11,30,"G5233"],[31,33,"G2532"],[34,41,"G4122"],[42,45,"G846"],[46,53,"G80"],[54,56,"G1722"],[57,61,"G3588"],[62,68,"G4229"],[70,77,"G1360"],[78,86,"G2962"],[87,98,"G1558"],[99,102,"G3956"],[103,112,"G3778"],[114,116,"G2531"],[117,137,"G4302"],[138,141,"G4771"],[142,145,"G2532"],[146,165,"G1263"]]},{"book":"1TH","chapter":4,"verse":7,"text":"For God has not called us to impurity, but to holiness.","strongs":[[0,3,"G1063"],[4,7,"G2316"],[8,15,"G3756"],[16,22,"G2564"],[23,25,"G1473"],[26,28,"G1909"],[29,37,"G167"],[39,42,"G235"],[43,45,"G1722"],[46,54,"G38"]]},{"book":"1TH","chapter":4,"verse":8,"text":"Anyone, then, who rejects this command does not reject man but God, the very One who gives you His Holy Spirit.","strongs":[[0,6,"G3588"],[8,12,"G5105"],[14,38,"G114"],[39,47,"G3756"],[48,54,"G114"],[55,58,"G444"],[59,62,"G235"],[63,66,"G2316"],[68,84,"G3588"],[85,90,"G1325"],[91,94,"G4771"],[95,98,"G846"],[99,103,"G40"],[104,110,"G4151"]]},{"book":"1TH","chapter":4,"verse":9,"text":"Now about brotherly love, you do not need anyone to write to you, because you yourselves have been taught by God to love one another.","strongs":[[0,3,"G1161"],[4,9,"G4012"],[10,24,"G5360"],[26,32,"G2192"],[33,36,"G3756"],[37,48,"G5532"],[49,57,"G1125"],[58,64,"G4771"],[66,73,"G1063"],[74,77,"G4771"],[78,88,"G846"],[89,98,"G1510"],[99,112,"G2312"],[113,120,"G25"],[121,132,"G240"]]},{"book":"1TH","chapter":4,"verse":10,"text":"And you are indeed showing this love to all the brothers throughout Macedonia. But we urge you, brothers, to excel more and more","strongs":[[0,3,"G2532"],[4,18,"G1063"],[19,26,"G4160"],[27,36,"G846"],[37,39,"G1519"],[40,43,"G3956"],[44,47,"G3588"],[48,56,"G80"],[57,67,"G1722"],[68,77,"G3109"],[79,82,"G1161"],[83,90,"G3870"],[91,94,"G4771"],[96,104,"G80"],[106,114,"G4052"],[115,128,"G3123"]]},{"book":"1TH","chapter":4,"verse":11,"text":"and to aspire to live quietly, to attend to your own matters, and to work with your own hands, as we instructed you.","strongs":[[0,3,"G2532"],[4,13,"G5389"],[14,29,"G2270"],[31,43,"G4238"],[44,52,"G2398"],[53,60,"G3588"],[62,65,"G2532"],[66,78,"G2038"],[79,83,"G4771"],[84,87,"G2398"],[88,93,"G5495"],[95,97,"G2531"],[98,111,"G3853"],[112,115,"G4771"]]},{"book":"1TH","chapter":4,"verse":12,"text":"Then you will behave properly toward outsiders, without being dependent on anyone.","strongs":[[0,4,"G2443"],[5,20,"G4043"],[21,29,"G2156"],[30,36,"G4314"],[37,46,"G1854"],[48,55,"G2532"],[56,61,"G2192"],[62,71,"G5532"],[72,81,"G3367"]]},{"book":"1TH","chapter":4,"verse":13,"text":"Brothers, we do not want you to be uninformed about those who sleep in death, so that you will not grieve like the rest, who are without hope.","strongs":[[0,8,"G80"],[10,24,"G2309"],[25,28,"G4771"],[29,45,"G50"],[46,51,"G4012"],[52,61,"G3588"],[62,76,"G2837"],[78,85,"G2443"],[86,105,"G3076"],[106,110,"G2531"],[111,114,"G3588"],[115,119,"G3062"],[121,124,"G3588"],[125,128,"G2192"],[129,136,"G3361"],[137,141,"G1680"]]},{"book":"1TH","chapter":4,"verse":14,"text":"For since we believe that Jesus died and rose again, we also believe that God will bring with Jesus those who have fallen asleep in Him.","strongs":[[0,3,"G1063"],[4,9,"G1487"],[10,20,"G4100"],[21,25,"G3754"],[26,31,"G2424"],[32,36,"G599"],[37,40,"G2532"],[41,51,"G450"],[53,73,"G3779"],[74,77,"G2316"],[78,88,"G71"],[89,93,"G4862"],[94,99,"G846"],[100,109,"G3588"],[110,128,"G2837"],[129,131,"G1223"],[132,135,"G2424"]]},{"book":"1TH","chapter":4,"verse":15,"text":"By the word of the Lord, we declare to you that we who are alive and remain until the coming of the Lord will by no means precede those who have fallen asleep.","strongs":[[0,2,"G1722"],[3,11,"G3056"],[12,23,"G2962"],[25,35,"G3004"],[36,42,"G4771"],[43,47,"G3754"],[48,50,"G1473"],[51,58,"G3588"],[59,64,"G2198"],[65,75,"G4035"],[76,81,"G1519"],[82,85,"G3588"],[86,92,"G3952"],[93,99,"G3588"],[100,104,"G2962"],[105,129,"G5348"],[130,139,"G3588"],[140,158,"G2837"]]},{"book":"1TH","chapter":4,"verse":16,"text":"For the Lord Himself will descend from heaven with a loud command, with the voice of an archangel, and with the trumpet of God, and the dead in Christ will be the first to rise.","strongs":[[0,3,"G3754"],[4,7,"G3588"],[8,12,"G2962"],[13,20,"G846"],[21,33,"G2597"],[34,38,"G575"],[39,45,"G3772"],[46,50,"G1722"],[51,65,"G2752"],[67,71,"G1722"],[72,81,"G5456"],[82,97,"G743"],[99,102,"G2532"],[103,107,"G1722"],[108,119,"G4536"],[120,126,"G2316"],[128,131,"G2532"],[132,135,"G3588"],[136,140,"G3498"],[141,143,"G1722"],[144,150,"G5547"],[151,176,"G450"]]},{"book":"1TH","chapter":4,"verse":17,"text":"After that, we who are alive and remain will be caught up together with them in the clouds to meet the Lord in the air. And so we will always be with the Lord.","strongs":[[0,10,"G1899"],[12,14,"G1473"],[15,22,"G3588"],[23,28,"G2198"],[29,39,"G4035"],[40,57,"G726"],[58,66,"G260"],[67,71,"G4862"],[72,76,"G846"],[77,79,"G1722"],[80,90,"G3507"],[91,93,"G1519"],[94,98,"G529"],[99,102,"G3588"],[103,107,"G2962"],[108,110,"G1519"],[111,118,"G109"],[120,123,"G2532"],[124,126,"G3779"],[127,134,"G1510"],[135,144,"G3842"],[145,149,"G4862"],[150,158,"G2962"]]},{"book":"1TH","chapter":4,"verse":18,"text":"Therefore encourage one another with these words.","strongs":[[0,9,"G5620"],[10,19,"G3870"],[20,31,"G240"],[32,36,"G1722"],[37,42,"G3778"],[43,48,"G3056"]]},{"book":"1TH","chapter":5,"verse":1,"text":"Now about the times and seasons, brothers, we do not need to write to you.","strongs":[[0,3,"G1161"],[4,9,"G4012"],[10,13,"G3588"],[14,19,"G5550"],[20,23,"G2532"],[24,31,"G2540"],[33,41,"G80"],[43,52,"G3756"],[53,57,"G5532"],[58,66,"G1125"],[67,73,"G4771"]]},{"book":"1TH","chapter":5,"verse":2,"text":"For you are fully aware that the Day of the Lord will come like a thief in the night.","strongs":[[0,3,"G1063"],[4,7,"G846"],[8,17,"G199"],[18,23,"G1492"],[24,28,"G3754"],[29,36,"G2250"],[37,48,"G2962"],[49,58,"G2064"],[59,63,"G5613"],[64,71,"G2812"],[72,74,"G1722"],[75,84,"G3571"]]},{"book":"1TH","chapter":5,"verse":3,"text":"While people are saying, “Peace and security,” destruction will come upon them suddenly, like labor pains on a pregnant woman, and they will not escape.","strongs":[[0,5,"G3752"],[6,23,"G3004"],[26,31,"G1515"],[32,35,"G2532"],[36,44,"G803"],[47,58,"G3639"],[59,68,"G2186"],[69,78,"G846"],[79,87,"G160"],[89,93,"G5618"],[94,105,"G5604"],[106,108,"G3588"],[109,125,"G2192"],[127,130,"G2532"],[131,151,"G1628"]]},{"book":"1TH","chapter":5,"verse":4,"text":"But you, brothers, are not in the darkness so that this day should overtake you like a thief.","strongs":[[0,3,"G1161"],[4,7,"G4771"],[9,17,"G80"],[19,22,"G1510"],[23,26,"G3756"],[27,29,"G1722"],[30,42,"G4655"],[43,50,"G2443"],[51,55,"G3588"],[56,59,"G2250"],[60,75,"G2638"],[76,79,"G4771"],[80,84,"G5613"],[85,92,"G2812"]]},{"book":"1TH","chapter":5,"verse":5,"text":"For you are all sons of the light and sons of the day; we do not belong to the night or to the darkness.","strongs":[[0,3,"G1063"],[4,7,"G4771"],[8,11,"G1510"],[12,15,"G3956"],[16,20,"G5207"],[21,33,"G5457"],[34,37,"G2532"],[38,42,"G5207"],[43,53,"G2250"],[55,71,"G1510"],[72,84,"G3571"],[85,87,"G3761"],[88,103,"G4655"]]},{"book":"1TH","chapter":5,"verse":6,"text":"So then, let us not sleep as the others do, but let us remain awake and sober.","strongs":[[0,2,"G686"],[3,7,"G3767"],[9,25,"G2518"],[26,28,"G5613"],[29,32,"G3588"],[33,42,"G3062"],[44,47,"G235"],[48,67,"G1127"],[68,71,"G2532"],[72,77,"G3525"]]},{"book":"1TH","chapter":5,"verse":7,"text":"For those who sleep, sleep at night, and those who get drunk, get drunk at night.","strongs":[[0,3,"G1063"],[4,13,"G3588"],[14,19,"G2518"],[21,26,"G2518"],[27,35,"G3571"],[37,40,"G2532"],[41,50,"G3588"],[51,60,"G3182"],[62,71,"G3184"],[72,80,"G3571"]]},{"book":"1TH","chapter":5,"verse":8,"text":"But since we belong to the day, let us be sober, putting on the breastplate of faith and love, and the helmet of our hope of salvation.","strongs":[[0,9,"G1161"],[10,12,"G1473"],[13,22,"G1510"],[23,30,"G2250"],[32,47,"G3525"],[49,59,"G1746"],[60,75,"G2382"],[76,84,"G4102"],[85,88,"G2532"],[89,93,"G26"],[95,98,"G2532"],[99,109,"G4030"],[110,121,"G1680"],[122,134,"G4991"]]},{"book":"1TH","chapter":5,"verse":9,"text":"For God has not appointed us to suffer wrath, but to obtain salvation through our Lord Jesus Christ.","strongs":[[0,3,"G3754"],[4,7,"G2316"],[8,25,"G5087"],[26,28,"G1473"],[29,31,"G1519"],[32,44,"G3709"],[46,49,"G235"],[50,52,"G1519"],[53,59,"G4047"],[60,69,"G4991"],[70,77,"G1223"],[78,81,"G1473"],[82,86,"G2962"],[87,92,"G2424"],[93,99,"G5547"]]},{"book":"1TH","chapter":5,"verse":10,"text":"He died for us so that, whether we are awake or asleep, we may live together with Him.","strongs":[[0,2,"G3588"],[3,7,"G599"],[8,11,"G4012"],[12,14,"G1473"],[15,22,"G2443"],[24,31,"G1535"],[32,44,"G1127"],[45,47,"G1535"],[48,54,"G2518"],[56,67,"G2198"],[68,76,"G260"],[77,81,"G4862"],[82,85,"G846"]]},{"book":"1TH","chapter":5,"verse":11,"text":"Therefore encourage and build one another up, just as you are already doing.","strongs":[[0,9,"G1352"],[10,19,"G3870"],[20,23,"G2532"],[24,29,"G3618"],[30,33,"G1520"],[34,44,"G1520"],[46,53,"G2531"],[54,75,"G4160"]]},{"book":"1TH","chapter":5,"verse":12,"text":"But we ask you, brothers, to acknowledge those who work diligently among you, who care for you in the Lord and who admonish you.","strongs":[[0,3,"G1161"],[4,10,"G2065"],[11,14,"G4771"],[16,24,"G80"],[26,40,"G1492"],[41,50,"G3588"],[51,66,"G2872"],[67,72,"G1722"],[73,76,"G4771"],[78,86,"G4291"],[87,94,"G4771"],[95,97,"G1722"],[98,106,"G2962"],[107,110,"G2532"],[111,123,"G3560"],[124,127,"G4771"]]},{"book":"1TH","chapter":5,"verse":13,"text":"In love, hold them in highest regard because of their work. Live in peace with one another.","strongs":[[0,2,"G1722"],[3,7,"G26"],[9,13,"G2233"],[14,18,"G846"],[19,36,"G5228"],[37,47,"G1223"],[48,53,"G846"],[54,58,"G2041"],[60,73,"G1514"],[74,78,"G1722"],[79,90,"G1438"]]},{"book":"1TH","chapter":5,"verse":14,"text":"And we urge you, brothers, to admonish the unruly, encourage the fainthearted, help the weak, and be patient with everyone.","strongs":[[0,3,"G1161"],[4,11,"G3870"],[12,15,"G4771"],[17,25,"G80"],[27,38,"G3560"],[39,42,"G3588"],[43,49,"G813"],[51,60,"G3888"],[61,64,"G3588"],[65,77,"G3642"],[79,83,"G472"],[84,87,"G3588"],[88,92,"G772"],[94,108,"G3114"],[109,113,"G4314"],[114,122,"G3956"]]},{"book":"1TH","chapter":5,"verse":15,"text":"Make sure that no one repays evil for evil. Always pursue what is good for one another and for all people.","strongs":[[0,14,"G3708"],[15,17,"G3361"],[18,21,"G5100"],[22,28,"G591"],[29,33,"G2556"],[34,37,"G473"],[38,42,"G2556"],[44,50,"G3842"],[51,57,"G1377"],[58,65,"G3588"],[66,70,"G18"],[71,74,"G1519"],[75,86,"G240"],[87,90,"G2532"],[91,94,"G1519"],[95,105,"G3956"]]},{"book":"1TH","chapter":5,"verse":16,"text":"Rejoice at all times.","strongs":[[0,7,"G5463"],[8,20,"G3842"]]},{"book":"1TH","chapter":5,"verse":17,"text":"Pray without ceasing.","strongs":[[0,4,"G4336"],[5,20,"G89"]]},{"book":"1TH","chapter":5,"verse":18,"text":"Give thanks in every circumstance, for this is God’s will for you in Christ Jesus.","strongs":[[0,11,"G2168"],[12,14,"G1722"],[15,33,"G3956"],[35,38,"G1063"],[39,46,"G3778"],[47,52,"G2316"],[53,57,"G2307"],[58,61,"G1519"],[62,65,"G4771"],[66,68,"G1722"],[69,75,"G5547"],[76,81,"G2424"]]},{"book":"1TH","chapter":5,"verse":19,"text":"Do not extinguish the Spirit.","strongs":[[0,17,"G4570"],[18,21,"G3588"],[22,28,"G4151"]]},{"book":"1TH","chapter":5,"verse":20,"text":"Do not treat prophecies with contempt,","strongs":[[0,12,"G1848"],[13,37,"G4394"]]},{"book":"1TH","chapter":5,"verse":21,"text":"but test all things. Hold fast to what is good.","strongs":[[0,3,"G1161"],[4,8,"G1381"],[9,19,"G3956"],[21,30,"G2722"],[31,41,"G3588"],[42,46,"G2570"]]},{"book":"1TH","chapter":5,"verse":22,"text":"Abstain from every form of evil.","strongs":[[0,7,"G568"],[8,12,"G575"],[13,18,"G3956"],[19,23,"G1491"],[24,31,"G4190"]]},{"book":"1TH","chapter":5,"verse":23,"text":"Now may the God of peace Himself sanctify you completely, and may your entire spirit, soul, and body be kept blameless at the coming of our Lord Jesus Christ.","strongs":[[0,3,"G1161"],[4,11,"G3588"],[12,15,"G2316"],[16,24,"G1515"],[25,32,"G846"],[33,41,"G37"],[42,45,"G4771"],[46,56,"G3651"],[58,61,"G2532"],[62,70,"G4771"],[71,77,"G3648"],[78,84,"G4151"],[86,90,"G5590"],[92,95,"G2532"],[96,100,"G4983"],[101,108,"G5083"],[109,118,"G274"],[119,121,"G1722"],[122,125,"G3588"],[126,132,"G3952"],[133,139,"G1473"],[140,144,"G2962"],[145,150,"G2424"],[151,157,"G5547"]]},{"book":"1TH","chapter":5,"verse":24,"text":"The One who calls you is faithful, and He will do it.","strongs":[[0,11,"G3588"],[12,17,"G2564"],[18,21,"G4771"],[22,33,"G4103"],[35,38,"G2532"],[39,41,"G3739"],[42,52,"G4160"]]},{"book":"1TH","chapter":5,"verse":25,"text":"Brothers, pray for us as well.","strongs":[[0,8,"G80"],[10,14,"G4336"],[15,18,"G4012"],[19,21,"G1473"],[22,29,"G2532"]]},{"book":"1TH","chapter":5,"verse":26,"text":"Greet all the brothers with a holy kiss.","strongs":[[0,5,"G782"],[6,9,"G3956"],[10,13,"G3588"],[14,22,"G80"],[23,27,"G1722"],[28,34,"G40"],[35,39,"G5370"]]},{"book":"1TH","chapter":5,"verse":27,"text":"I charge you before the Lord to have this letter read to all the brothers.","strongs":[[0,8,"G3726"],[9,12,"G4771"],[13,23,"G3588"],[24,28,"G2962"],[29,41,"G3588"],[42,48,"G1992"],[49,53,"G314"],[54,60,"G3956"],[61,64,"G3588"],[65,73,"G80"]]},{"book":"1TH","chapter":5,"verse":28,"text":"The grace of our Lord Jesus Christ be with you.","strongs":[[0,3,"G3588"],[4,9,"G5485"],[10,16,"G1473"],[17,21,"G2962"],[22,27,"G2424"],[28,34,"G5547"],[35,42,"G3326"],[43,46,"G4771"]]}]}