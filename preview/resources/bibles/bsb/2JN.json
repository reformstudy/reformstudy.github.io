{"id":"2JN","name":"2 John","testament":"NT","chapters":1,"verses":[{"book":"2JN","chapter":1,"verse":1,"text":"The elder, To the chosen lady and her children, whom I love in the truth—and not I alone, but also all who know the truth—","strongs":[[0,3,"G3588"],[4,9,"G4245"],[11,24,"G1588"],[25,29,"G2959"],[30,33,"G2532"],[34,37,"G846"],[38,46,"G5043"],[48,52,"G3739"],[53,54,"G1473"],[55,59,"G25"],[60,62,"G1722"],[63,72,"G225"],[73,76,"G2532"],[77,80,"G3756"],[81,82,"G1473"],[83,88,"G3441"],[90,93,"G235"],[94,98,"G2532"],[99,102,"G3956"],[103,106,"G3588"],[107,111,"G1097"],[112,115,"G3588"],[116,121,"G225"]]},{"book":"2JN","chapter":1,"verse":2,"text":"because of the truth that abides in us and will be with us forever:","strongs":[[0,10,"G1223"],[11,14,"G3588"],[15,20,"G225"],[21,25,"G3588"],[26,32,"G3306"],[33,35,"G1722"],[36,38,"G1473"],[39,42,"G2532"],[43,50,"G1510"],[51,55,"G3326"],[56,58,"G1473"],[59,66,"G165"]]},{"book":"2JN","chapter":1,"verse":3,"text":"Grace, mercy, and peace from God the Father and from Jesus Christ, the Son of the Father, will be with us in truth and love.","strongs":[[0,5,"G5485"],[7,12,"G1656"],[14,23,"G1515"],[24,28,"G3844"],[29,32,"G2316"],[33,43,"G3962"],[44,47,"G2532"],[48,52,"G3844"],[53,58,"G2424"],[59,65,"G5547"],[67,70,"G3588"],[71,74,"G5207"],[75,81,"G3588"],[82,88,"G3962"],[90,97,"G1510"],[98,102,"G3326"],[103,105,"G1473"],[106,108,"G1722"],[109,114,"G225"],[115,118,"G2532"],[119,123,"G26"]]},{"book":"2JN","chapter":1,"verse":4,"text":"I was overjoyed to find some of your children walking in the truth, just as the Father has commanded us.","strongs":[[0,15,"G5463"],[16,18,"G3754"],[19,23,"G2147"],[24,31,"G1537"],[32,36,"G4771"],[37,45,"G5043"],[46,53,"G4043"],[54,56,"G1722"],[57,66,"G225"],[68,75,"G2531"],[76,79,"G3588"],[80,86,"G3962"],[87,100,"G1785"],[101,103,"G2983"]]},{"book":"2JN","chapter":1,"verse":5,"text":"And now I urge you, dear lady—not as a new commandment to you, but one we have had from the beginning—that we love one another.","strongs":[[0,3,"G2532"],[4,7,"G3568"],[8,14,"G2065"],[15,18,"G4771"],[20,29,"G2959"],[30,33,"G3756"],[34,36,"G5613"],[37,42,"G2537"],[43,54,"G1785"],[55,61,"G4771"],[63,66,"G235"],[67,70,"G3739"],[71,82,"G2192"],[83,87,"G575"],[88,101,"G746"],[102,106,"G2443"],[107,114,"G25"],[115,126,"G240"]]},{"book":"2JN","chapter":1,"verse":6,"text":"And this is love, that we walk according to His commandments. This is the very commandment you have heard from the beginning, that you must walk in love.","strongs":[[0,3,"G2532"],[4,8,"G3778"],[9,11,"G1510"],[12,16,"G26"],[18,22,"G2443"],[23,30,"G4043"],[31,43,"G2596"],[44,47,"G846"],[48,60,"G1785"],[62,66,"G3778"],[67,69,"G1510"],[70,73,"G3588"],[74,78,"G2531"],[79,90,"G1785"],[91,105,"G191"],[106,110,"G575"],[111,124,"G746"],[126,130,"G2443"],[131,144,"G4043"],[145,147,"G1722"],[148,152,"G846"]]},{"book":"2JN","chapter":1,"verse":7,"text":"For many deceivers have gone out into the world, refusing to confess the coming of Jesus Christ in the flesh. Any such person is the deceiver and the antichrist.","strongs":[[0,3,"G3754"],[4,8,"G4183"],[9,18,"G4108"],[19,32,"G1831"],[33,37,"G1519"],[38,41,"G3588"],[42,47,"G2889"],[49,57,"G3361"],[58,68,"G3670"],[69,82,"G2064"],[83,88,"G2424"],[89,95,"G5547"],[96,98,"G1722"],[99,108,"G4561"],[110,125,"G3778"],[126,128,"G1510"],[129,132,"G3588"],[133,141,"G4108"],[142,145,"G2532"],[146,149,"G3588"],[150,160,"G500"]]},{"book":"2JN","chapter":1,"verse":8,"text":"Watch yourselves, so that you do not lose what we have worked for, but that you may be fully rewarded.","strongs":[[0,5,"G991"],[6,16,"G1438"],[18,25,"G2443"],[26,41,"G622"],[42,46,"G3739"],[47,65,"G2038"],[67,75,"G235"],[76,101,"G618"]]},{"book":"2JN","chapter":1,"verse":9,"text":"Anyone who runs ahead without remaining in the teaching of Christ does not have God. Whoever remains in His teaching has both the Father and the Son.","strongs":[[0,6,"G3956"],[7,10,"G3588"],[11,21,"G4254"],[22,29,"G3361"],[30,39,"G3306"],[40,42,"G1722"],[43,46,"G3588"],[47,55,"G1322"],[56,65,"G5547"],[66,79,"G2192"],[80,83,"G2316"],[85,92,"G3588"],[93,100,"G3306"],[101,103,"G1722"],[104,107,"G3588"],[108,116,"G1322"],[117,120,"G2192"],[121,125,"G2532"],[126,129,"G3588"],[130,136,"G3962"],[137,140,"G2532"],[141,144,"G3588"],[145,148,"G5207"]]},{"book":"2JN","chapter":1,"verse":10,"text":"If anyone comes to you but does not bring this teaching, do not receive him into your home or even greet him.","strongs":[[0,2,"G1487"],[3,9,"G5100"],[10,15,"G2064"],[16,18,"G4314"],[19,22,"G4771"],[23,26,"G2532"],[27,41,"G5342"],[42,46,"G3778"],[47,55,"G1322"],[57,63,"G3361"],[64,71,"G2983"],[72,75,"G846"],[76,80,"G1519"],[81,90,"G3614"],[91,93,"G3361"],[94,98,"G2532"],[99,104,"G3004"],[105,108,"G846"]]},{"book":"2JN","chapter":1,"verse":11,"text":"Whoever greets such a person shares in his evil deeds.","strongs":[[0,7,"G3588"],[8,14,"G3004"],[15,28,"G846"],[29,35,"G2841"],[36,38,"G3588"],[39,42,"G846"],[43,47,"G4190"],[48,53,"G2041"]]},{"book":"2JN","chapter":1,"verse":12,"text":"I have many things to write to you, but I would prefer not to do so with paper and ink. Instead, I hope to come and speak with you face to face, so that our joy may be complete.","strongs":[[0,6,"G2192"],[7,18,"G4183"],[19,27,"G1125"],[28,34,"G4771"],[36,54,"G1014"],[55,67,"G3756"],[68,72,"G1223"],[73,78,"G5489"],[79,82,"G2532"],[83,86,"G3188"],[88,95,"G235"],[97,103,"G1679"],[104,111,"G1096"],[112,115,"G2532"],[116,121,"G2980"],[122,126,"G4314"],[127,130,"G4771"],[131,135,"G4750"],[136,138,"G4314"],[139,143,"G4750"],[145,152,"G2443"],[153,156,"G1473"],[157,160,"G5479"],[161,167,"G1510"],[168,176,"G4137"]]},{"book":"2JN","chapter":1,"verse":13,"text":"The children of your elect sister send you greetings.","strongs":[[0,3,"G3588"],[4,12,"G5043"],[13,20,"G4771"],[21,26,"G1588"],[27,33,"G79"],[34,52,"G782"]]}]}