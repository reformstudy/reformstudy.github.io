{"id":"PHP","name":"Philippians","testament":"NT","chapters":4,"verses":[{"book":"PHP","chapter":1,"verse":1,"text":"Paul and Timothy, servants of Christ Jesus, To all the saints in Christ Jesus at Philippi, together with the overseers and deacons:","strongs":[[0,4,"G3972"],[5,8,"G2532"],[9,16,"G5095"],[18,26,"G1401"],[27,36,"G5547"],[37,42,"G2424"],[44,50,"G3956"],[51,54,"G3588"],[55,61,"G40"],[62,64,"G1722"],[65,71,"G5547"],[72,77,"G2424"],[78,80,"G1722"],[81,89,"G5375"],[91,104,"G4862"],[105,118,"G1985"],[119,122,"G2532"],[123,130,"G1249"]]},{"book":"PHP","chapter":1,"verse":2,"text":"Grace and peace to you from God our Father and the Lord Jesus Christ.","strongs":[[0,5,"G5485"],[6,9,"G2532"],[10,15,"G1515"],[16,22,"G4771"],[23,27,"G575"],[28,31,"G2316"],[32,35,"G1473"],[36,42,"G3962"],[43,46,"G2532"],[47,55,"G2962"],[56,61,"G2424"],[62,68,"G5547"]]},{"book":"PHP","chapter":1,"verse":3,"text":"I thank my God every time I remember you.","strongs":[[0,7,"G2168"],[8,10,"G1473"],[11,14,"G2316"],[15,25,"G3956"],[26,36,"G3417"],[37,40,"G4771"]]},{"book":"PHP","chapter":1,"verse":4,"text":"In every prayer for all of you, I always pray with joy,","strongs":[[0,2,"G1722"],[3,8,"G3956"],[9,15,"G1162"],[16,19,"G5228"],[20,23,"G3956"],[24,30,"G4771"],[32,33,"G1473"],[34,40,"G3842"],[41,45,"G1162"],[46,50,"G3326"],[51,54,"G5479"]]},{"book":"PHP","chapter":1,"verse":5,"text":"because of your partnership in the gospel from the first day until now,","strongs":[[0,10,"G1909"],[11,15,"G4771"],[16,27,"G2842"],[28,30,"G1519"],[31,34,"G3588"],[35,41,"G2098"],[42,46,"G575"],[47,50,"G3588"],[51,56,"G4413"],[57,60,"G2250"],[61,66,"G891"],[67,70,"G3568"]]},{"book":"PHP","chapter":1,"verse":6,"text":"being confident of this, that He who began a good work in you will carry it on to completion until the day of Christ Jesus.","strongs":[[0,15,"G3982"],[16,23,"G3778"],[25,29,"G3754"],[30,32,"G3588"],[33,42,"G1728"],[43,49,"G18"],[50,54,"G2041"],[55,57,"G1722"],[58,61,"G4771"],[62,92,"G2005"],[93,98,"G891"],[99,106,"G2250"],[107,116,"G5547"],[117,122,"G2424"]]},{"book":"PHP","chapter":1,"verse":7,"text":"It is right for me to feel this way about all of you, since I have you in my heart. For in my chains and in my defense and confirmation of the gospel, you are all partners in grace with me.","strongs":[[0,5,"G1510"],[6,11,"G1342"],[12,18,"G1473"],[19,26,"G5426"],[27,35,"G3778"],[36,41,"G5228"],[42,45,"G3956"],[46,52,"G4771"],[54,59,"G1223"],[60,61,"G1473"],[62,66,"G2192"],[67,70,"G4771"],[71,73,"G1722"],[74,76,"G3588"],[77,82,"G2588"],[84,90,"G1722"],[91,93,"G1473"],[94,100,"G1199"],[101,104,"G2532"],[105,107,"G1722"],[108,110,"G3588"],[111,118,"G627"],[119,122,"G2532"],[123,135,"G951"],[136,142,"G3588"],[143,149,"G2098"],[151,154,"G4771"],[155,158,"G1510"],[159,162,"G3956"],[163,171,"G4791"],[172,174,"G3588"],[175,180,"G5485"],[181,188,"G1473"]]},{"book":"PHP","chapter":1,"verse":8,"text":"God is my witness how I long for all of you with the affection of Christ Jesus.","strongs":[[0,6,"G2316"],[7,9,"G1473"],[10,17,"G3144"],[18,21,"G5613"],[22,32,"G1971"],[33,36,"G3956"],[37,43,"G4771"],[44,48,"G1722"],[49,62,"G4698"],[63,72,"G5547"],[73,78,"G2424"]]},{"book":"PHP","chapter":1,"verse":9,"text":"And this is my prayer: that your love may abound more and more in knowledge and depth of insight,","strongs":[[0,3,"G2532"],[4,11,"G3778"],[12,21,"G4336"],[23,27,"G2443"],[28,32,"G4771"],[33,37,"G26"],[38,48,"G4052"],[49,53,"G3123"],[54,57,"G2532"],[58,62,"G3123"],[63,65,"G1722"],[66,75,"G1922"],[76,79,"G2532"],[80,85,"G3956"],[86,96,"G144"]]},{"book":"PHP","chapter":1,"verse":10,"text":"so that you may be able to test and prove what is best and may be pure and blameless for the day of Christ,","strongs":[[0,7,"G1519"],[8,11,"G4771"],[12,41,"G1381"],[42,46,"G3588"],[47,54,"G1308"],[55,58,"G2443"],[59,65,"G1510"],[66,70,"G1506"],[71,74,"G2532"],[75,84,"G677"],[85,88,"G1519"],[89,96,"G2250"],[97,106,"G5547"]]},{"book":"PHP","chapter":1,"verse":11,"text":"filled with the fruit of righteousness that comes through Jesus Christ, to the glory and praise of God.","strongs":[[0,6,"G4137"],[7,21,"G2590"],[22,38,"G1343"],[39,49,"G3588"],[50,57,"G1223"],[58,63,"G2424"],[64,70,"G5547"],[72,74,"G1519"],[75,84,"G1391"],[85,88,"G2532"],[89,95,"G1868"],[96,102,"G2316"]]},{"book":"PHP","chapter":1,"verse":12,"text":"Now I want you to know, brothers, that my circumstances have actually served to advance the gospel.","strongs":[[0,3,"G1161"],[4,10,"G1014"],[11,14,"G4771"],[15,22,"G1097"],[24,32,"G80"],[34,38,"G3754"],[39,55,"G3588"],[56,69,"G3123"],[70,76,"G2064"],[77,79,"G1519"],[80,87,"G4297"],[88,91,"G3588"],[92,98,"G2098"]]},{"book":"PHP","chapter":1,"verse":13,"text":"As a result, it has become clear throughout the whole palace guard and to everyone else that I am in chains for Christ.","strongs":[[0,11,"G5620"],[13,26,"G1096"],[27,32,"G5318"],[33,43,"G1722"],[44,47,"G3588"],[48,53,"G3650"],[54,66,"G4232"],[67,70,"G2532"],[71,73,"G3588"],[74,82,"G3956"],[83,92,"G3062"],[93,97,"G1473"],[98,107,"G1199"],[108,111,"G1722"],[112,118,"G5547"]]},{"book":"PHP","chapter":1,"verse":14,"text":"And most of the brothers, confident in the Lord by my chains, now dare more greatly to speak the word without fear.","strongs":[[0,3,"G2532"],[4,8,"G4119"],[9,15,"G3588"],[16,24,"G80"],[26,35,"G3982"],[36,38,"G1722"],[39,47,"G2962"],[48,50,"G3588"],[51,53,"G1473"],[54,60,"G1199"],[62,70,"G5111"],[71,83,"G4057"],[84,92,"G2980"],[93,96,"G3588"],[97,101,"G3056"],[102,114,"G870"]]},{"book":"PHP","chapter":1,"verse":15,"text":"It is true that some preach Christ out of envy and rivalry, but others out of goodwill.","strongs":[[0,15,"G3303"],[16,20,"G5100"],[21,27,"G2784"],[28,34,"G5547"],[35,41,"G1223"],[42,46,"G5355"],[47,50,"G2532"],[51,58,"G2054"],[60,63,"G1161"],[64,70,"G5100"],[71,77,"G1223"],[78,86,"G2107"]]},{"book":"PHP","chapter":1,"verse":16,"text":"The latter do so in love, knowing that I am appointed for the defense of the gospel.","strongs":[[0,10,"G3588"],[11,16,"G3303"],[17,19,"G1537"],[20,24,"G26"],[26,33,"G1492"],[34,38,"G3754"],[39,53,"G2749"],[54,57,"G1519"],[58,69,"G627"],[70,76,"G3588"],[77,83,"G2098"]]},{"book":"PHP","chapter":1,"verse":17,"text":"The former, however, preach Christ out of selfish ambition, not sincerely, supposing that they can add to the distress of my chains.","strongs":[[0,10,"G3588"],[12,19,"G1161"],[21,27,"G2605"],[28,34,"G5547"],[35,41,"G1537"],[42,58,"G2052"],[60,63,"G3756"],[64,73,"G55"],[75,89,"G3633"],[90,105,"G1453"],[106,118,"G2347"],[119,124,"G1473"],[125,131,"G1199"]]},{"book":"PHP","chapter":1,"verse":18,"text":"What then is the issue? Just this: that in every way, whether by false motives or true, Christ is preached. And in this I rejoice. Yes, and I will continue to rejoice,","strongs":[[0,4,"G5101"],[5,22,"G1063"],[24,33,"G4133"],[35,39,"G3754"],[40,48,"G3956"],[49,52,"G5158"],[54,61,"G1535"],[62,78,"G4392"],[79,81,"G1535"],[82,86,"G225"],[88,94,"G5547"],[95,106,"G2605"],[108,111,"G2532"],[112,114,"G1722"],[115,119,"G3778"],[120,129,"G5463"],[131,134,"G235"],[136,139,"G2532"],[140,166,"G5463"]]},{"book":"PHP","chapter":1,"verse":19,"text":"because I know that through your prayers and the provision of the Spirit of Jesus Christ, my distress will turn out for my deliverance.","strongs":[[0,7,"G1063"],[8,14,"G1492"],[15,19,"G3754"],[20,27,"G1223"],[28,32,"G4771"],[33,40,"G1162"],[41,44,"G2532"],[45,58,"G2024"],[59,65,"G3588"],[66,72,"G4151"],[73,81,"G2424"],[82,88,"G5547"],[90,101,"G3778"],[102,115,"G576"],[116,122,"G1473"],[123,134,"G4991"]]},{"book":"PHP","chapter":1,"verse":20,"text":"I eagerly expect and hope that I will in no way be ashamed, but will have complete boldness so that now as always Christ will be exalted in my body, whether by life or by death.","strongs":[[0,1,"G1473"],[2,16,"G603"],[17,20,"G2532"],[21,25,"G1680"],[26,30,"G3754"],[31,58,"G153"],[60,63,"G235"],[64,91,"G3954"],[92,99,"G2532"],[100,103,"G3568"],[104,106,"G5613"],[107,113,"G3842"],[114,120,"G5547"],[121,136,"G3170"],[137,139,"G1722"],[140,142,"G1473"],[143,147,"G4983"],[149,156,"G1535"],[157,159,"G1223"],[160,164,"G2222"],[165,167,"G1535"],[168,170,"G1223"],[171,176,"G2288"]]},{"book":"PHP","chapter":1,"verse":21,"text":"For to me, to live is Christ, and to die is gain.","strongs":[[0,3,"G1063"],[4,9,"G1473"],[11,18,"G2198"],[19,28,"G5547"],[30,33,"G2532"],[34,40,"G599"],[41,48,"G2771"]]},{"book":"PHP","chapter":1,"verse":22,"text":"But if I go on living in the body, this will mean fruitful labor for me. So what shall I choose? I do not know.","strongs":[[0,3,"G1161"],[4,6,"G1487"],[7,21,"G2198"],[22,24,"G1722"],[25,33,"G4561"],[35,39,"G3778"],[40,58,"G2590"],[59,64,"G2041"],[65,71,"G1473"],[73,75,"G2532"],[76,80,"G5101"],[81,95,"G138"],[97,110,"G1107"]]},{"book":"PHP","chapter":1,"verse":23,"text":"I am torn between the two. I desire to depart and be with Christ, which is far better indeed.","strongs":[[0,9,"G4912"],[10,17,"G1537"],[18,21,"G3588"],[22,25,"G1417"],[27,35,"G1939"],[36,45,"G360"],[46,49,"G2532"],[50,52,"G1510"],[53,57,"G4862"],[58,64,"G5547"],[66,78,"G4183"],[79,85,"G2908"],[86,92,"G1063"]]},{"book":"PHP","chapter":1,"verse":24,"text":"But it is more necessary for you that I remain in the body.","strongs":[[0,3,"G1161"],[4,24,"G316"],[25,28,"G1223"],[29,32,"G4771"],[33,46,"G1961"],[47,49,"G1722"],[50,53,"G3588"],[54,58,"G4561"]]},{"book":"PHP","chapter":1,"verse":25,"text":"Convinced of this, I know that I will remain and will continue with all of you for your progress and joy in the faith,","strongs":[[0,12,"G3982"],[13,17,"G3778"],[19,25,"G1492"],[26,30,"G3754"],[31,44,"G3306"],[45,48,"G2532"],[49,67,"G3887"],[68,71,"G3956"],[72,78,"G4771"],[79,82,"G1519"],[83,87,"G4771"],[88,96,"G4297"],[97,100,"G2532"],[101,104,"G5479"],[105,111,"G3588"],[112,117,"G4102"]]},{"book":"PHP","chapter":1,"verse":26,"text":"so that through my coming to you again your exultation in Christ Jesus will resound on account of me.","strongs":[[0,7,"G2443"],[8,15,"G1223"],[16,18,"G1699"],[19,25,"G3952"],[26,28,"G4314"],[29,32,"G4771"],[33,38,"G3825"],[39,43,"G4771"],[44,54,"G2745"],[55,57,"G1722"],[58,64,"G5547"],[65,70,"G2424"],[71,83,"G4052"],[84,97,"G1722"],[98,100,"G1473"]]},{"book":"PHP","chapter":1,"verse":27,"text":"Nevertheless, conduct yourselves in a manner worthy of the gospel of Christ. Then, whether I come and see you or only hear about you in my absence, I will know that you stand firm in one spirit, contending together as one for the faith of the gospel,","strongs":[[0,12,"G3440"],[14,32,"G4176"],[33,51,"G516"],[52,58,"G3588"],[59,65,"G2098"],[66,75,"G5547"],[77,81,"G2443"],[83,90,"G1535"],[91,97,"G2064"],[98,101,"G2532"],[102,105,"G3708"],[106,109,"G4771"],[110,117,"G1535"],[118,122,"G191"],[123,128,"G4012"],[129,132,"G4771"],[133,146,"G548"],[148,164,"G3754"],[165,179,"G4739"],[180,182,"G1722"],[183,186,"G1520"],[187,193,"G4151"],[195,214,"G4866"],[215,221,"G1520"],[222,229,"G3588"],[230,235,"G4102"],[236,242,"G3588"],[243,249,"G2098"]]},{"book":"PHP","chapter":1,"verse":28,"text":"without being frightened in any way by those who oppose you. This is a clear sign of their destruction but of your salvation, and it is from God.","strongs":[[0,24,"G4426"],[25,27,"G1722"],[28,35,"G3367"],[36,38,"G5259"],[39,48,"G3588"],[49,59,"G480"],[61,65,"G3748"],[66,68,"G1510"],[69,81,"G1732"],[82,90,"G846"],[91,102,"G684"],[103,106,"G1161"],[107,114,"G4771"],[115,124,"G4991"],[126,129,"G2532"],[130,132,"G3778"],[133,140,"G575"],[141,144,"G2316"]]},{"book":"PHP","chapter":1,"verse":29,"text":"For it has been granted to you on behalf of Christ not only to believe in Him, but also to suffer for Him,","strongs":[[0,3,"G3754"],[4,23,"G5483"],[24,30,"G4771"],[31,40,"G5228"],[41,50,"G5547"],[51,54,"G3756"],[55,59,"G3440"],[60,70,"G4100"],[71,73,"G1519"],[74,77,"G846"],[79,82,"G235"],[83,87,"G2532"],[88,97,"G3958"],[98,101,"G5228"],[102,105,"G846"]]},{"book":"PHP","chapter":1,"verse":30,"text":"since you are encountering the same struggle you saw I had, and now hear that I still have.","strongs":[[0,26,"G2192"],[27,30,"G3588"],[31,35,"G846"],[36,44,"G73"],[45,52,"G3708"],[53,58,"G1473"],[60,67,"G2532"],[68,77,"G191"],[78,90,"G1473"]]},{"book":"PHP","chapter":2,"verse":1,"text":"Therefore if you have any encouragement in Christ, if any comfort from His love, if any fellowship with the Spirit, if any affection and compassion,","strongs":[[0,9,"G3767"],[10,21,"G1487"],[22,25,"G5100"],[26,39,"G3874"],[40,42,"G1722"],[43,49,"G5547"],[51,53,"G1487"],[54,57,"G5100"],[58,65,"G3890"],[66,79,"G26"],[81,83,"G1487"],[84,87,"G5100"],[88,98,"G2842"],[99,114,"G4151"],[116,118,"G1487"],[119,122,"G5100"],[123,132,"G4698"],[133,136,"G2532"],[137,147,"G3628"]]},{"book":"PHP","chapter":2,"verse":2,"text":"then make my joy complete by being like-minded, having the same love, being united in spirit and purpose.","strongs":[[0,12,"G1473"],[13,16,"G5479"],[17,25,"G4137"],[26,46,"G5426"],[48,54,"G2192"],[55,58,"G3588"],[59,63,"G846"],[64,68,"G26"],[70,96,"G4861"],[97,104,"G1520"]]},{"book":"PHP","chapter":2,"verse":3,"text":"Do nothing out of selfish ambition or empty pride, but in humility consider others more important than yourselves.","strongs":[[0,10,"G3367"],[11,17,"G2596"],[18,34,"G2052"],[35,37,"G3366"],[38,49,"G2754"],[51,54,"G235"],[55,66,"G5012"],[67,75,"G2233"],[76,82,"G240"],[83,102,"G5242"],[103,113,"G1438"]]},{"book":"PHP","chapter":2,"verse":4,"text":"Each of you should look not only to your own interests, but also to the interests of others.","strongs":[[0,11,"G1538"],[12,23,"G4648"],[24,35,"G3361"],[36,44,"G1438"],[45,54,"G3588"],[56,59,"G235"],[60,64,"G2532"],[65,81,"G3588"],[82,91,"G2087"]]},{"book":"PHP","chapter":2,"verse":5,"text":"Let this mind be in you which was also in Christ Jesus:","strongs":[[0,16,"G5426"],[17,19,"G1722"],[20,23,"G4771"],[24,29,"G3739"],[30,38,"G2532"],[39,41,"G1722"],[42,48,"G5547"],[49,54,"G2424"]]},{"book":"PHP","chapter":2,"verse":6,"text":"Who, existing in the form of God, did not consider equality with God something to be grasped,","strongs":[[0,3,"G3739"],[5,13,"G5225"],[14,16,"G1722"],[17,25,"G3444"],[26,32,"G2316"],[34,41,"G3756"],[42,50,"G2233"],[51,59,"G2470"],[60,68,"G2316"],[69,92,"G725"]]},{"book":"PHP","chapter":2,"verse":7,"text":"but emptied Himself, taking the form of a servant, being made in human likeness.","strongs":[[0,3,"G235"],[4,11,"G2758"],[12,19,"G1438"],[21,27,"G2983"],[28,36,"G3444"],[37,49,"G1401"],[51,61,"G1096"],[62,64,"G1722"],[65,79,"G3667"]]},{"book":"PHP","chapter":2,"verse":8,"text":"And being found in appearance as a man, He humbled Himself and became obedient to death—even death on a cross.","strongs":[[0,3,"G2532"],[4,15,"G2147"],[16,29,"G4976"],[30,32,"G5613"],[33,38,"G444"],[40,50,"G5013"],[51,58,"G1438"],[59,69,"G1096"],[70,78,"G5255"],[79,81,"G3360"],[82,87,"G2288"],[88,92,"G1161"],[93,98,"G2288"],[99,109,"G4716"]]},{"book":"PHP","chapter":2,"verse":9,"text":"Therefore God exalted Him to the highest place and gave Him the name above all names,","strongs":[[0,9,"G1352"],[10,13,"G2316"],[14,21,"G5251"],[22,46,"G846"],[47,50,"G2532"],[51,55,"G5483"],[56,59,"G846"],[60,63,"G3588"],[64,68,"G3686"],[69,74,"G5228"],[75,78,"G3956"],[79,84,"G3686"]]},{"book":"PHP","chapter":2,"verse":10,"text":"that at the name of Jesus every knee should bow, in heaven and on earth and under the earth,","strongs":[[0,4,"G2443"],[5,7,"G1722"],[8,11,"G3588"],[12,16,"G3686"],[17,25,"G2424"],[26,31,"G3956"],[32,36,"G1119"],[37,47,"G2578"],[49,58,"G2032"],[59,62,"G2532"],[63,71,"G1919"],[72,75,"G2532"],[76,91,"G2709"]]},{"book":"PHP","chapter":2,"verse":11,"text":"and every tongue confess that Jesus Christ is Lord, to the glory of God the Father.","strongs":[[0,3,"G2532"],[4,9,"G3956"],[10,16,"G1100"],[17,24,"G1843"],[25,29,"G3754"],[30,35,"G2424"],[36,42,"G5547"],[43,50,"G2962"],[52,54,"G1519"],[55,64,"G1391"],[65,71,"G2316"],[72,82,"G3962"]]},{"book":"PHP","chapter":2,"verse":12,"text":"Therefore, my beloved, just as you have always obeyed, not only in my presence, but now even more in my absence, continue to work out your salvation with fear and trembling.","strongs":[[0,9,"G5620"],[11,13,"G1473"],[14,21,"G27"],[23,30,"G2531"],[31,53,"G5219"],[55,58,"G3361"],[59,63,"G3440"],[64,66,"G1722"],[67,69,"G1473"],[70,78,"G3952"],[80,83,"G235"],[84,87,"G3568"],[88,92,"G4183"],[93,97,"G3123"],[98,100,"G1722"],[101,103,"G1473"],[104,111,"G666"],[113,133,"G2716"],[134,138,"G1438"],[139,148,"G4991"],[149,153,"G3326"],[154,158,"G5401"],[159,162,"G2532"],[163,172,"G5156"]]},{"book":"PHP","chapter":2,"verse":13,"text":"For it is God who works in you to will and to act on behalf of His good purpose.","strongs":[[0,3,"G1063"],[4,9,"G1510"],[10,13,"G2316"],[14,17,"G3588"],[18,23,"G1754"],[24,26,"G1722"],[27,30,"G4771"],[31,38,"G2309"],[39,42,"G2532"],[43,49,"G1754"],[50,62,"G5228"],[63,66,"G3588"],[67,79,"G2107"]]},{"book":"PHP","chapter":2,"verse":14,"text":"Do everything without complaining or arguing,","strongs":[[0,2,"G4160"],[3,13,"G3956"],[14,21,"G5565"],[22,33,"G1112"],[34,36,"G2532"],[37,44,"G1261"]]},{"book":"PHP","chapter":2,"verse":15,"text":"so that you may be blameless and pure, children of God without fault in a crooked and perverse generation, in which you shine as lights in the world","strongs":[[0,7,"G2443"],[8,18,"G1096"],[19,28,"G273"],[29,32,"G2532"],[33,37,"G185"],[39,47,"G5043"],[48,54,"G2316"],[55,68,"G299"],[69,71,"G3319"],[72,81,"G4646"],[82,85,"G2532"],[86,94,"G1294"],[95,105,"G1074"],[107,109,"G1722"],[110,115,"G3739"],[116,125,"G5316"],[126,128,"G5613"],[129,135,"G5458"],[136,138,"G1722"],[139,148,"G2889"]]},{"book":"PHP","chapter":2,"verse":16,"text":"as you hold forth the word of life, in order that I may boast on the day of Christ that I did not run or labor in vain.","strongs":[[0,17,"G1907"],[18,26,"G3056"],[27,34,"G2222"],[36,49,"G1519"],[50,51,"G1473"],[52,61,"G2745"],[62,64,"G1519"],[65,72,"G2250"],[73,82,"G5547"],[83,87,"G3754"],[88,101,"G5143"],[102,104,"G3761"],[105,110,"G2872"],[111,113,"G1519"],[114,118,"G2756"]]},{"book":"PHP","chapter":2,"verse":17,"text":"But even if I am being poured out like a drink offering on the sacrifice and service of your faith, I am glad and rejoice with all of you.","strongs":[[0,3,"G235"],[4,8,"G2532"],[9,11,"G1487"],[12,55,"G4689"],[56,58,"G1909"],[59,62,"G3588"],[63,72,"G2378"],[73,76,"G2532"],[77,84,"G3009"],[85,87,"G3588"],[88,92,"G4771"],[93,98,"G4102"],[100,109,"G5463"],[110,113,"G2532"],[114,126,"G4796"],[127,130,"G3956"],[131,137,"G4771"]]},{"book":"PHP","chapter":2,"verse":18,"text":"So you too should be glad and rejoice with me.","strongs":[[0,2,"G846"],[3,6,"G4771"],[7,10,"G2532"],[11,25,"G5463"],[26,29,"G2532"],[30,42,"G4796"],[43,45,"G1473"]]},{"book":"PHP","chapter":2,"verse":19,"text":"Now I hope in the Lord Jesus to send Timothy to you soon, that I also may be cheered when I learn how you are doing.","strongs":[[0,3,"G1161"],[4,10,"G1679"],[11,13,"G1722"],[14,22,"G2962"],[23,28,"G2424"],[29,36,"G3992"],[37,44,"G5095"],[45,51,"G4771"],[52,56,"G5030"],[58,62,"G2443"],[63,69,"G2504"],[70,84,"G2174"],[85,97,"G1097"],[98,101,"G4012"],[102,115,"G4771"]]},{"book":"PHP","chapter":2,"verse":20,"text":"I have nobody else like him who will genuinely care for your needs.","strongs":[[0,6,"G2192"],[7,18,"G3762"],[19,27,"G2473"],[28,31,"G3748"],[32,46,"G1104"],[47,55,"G3309"],[56,60,"G4771"],[61,66,"G3588"]]},{"book":"PHP","chapter":2,"verse":21,"text":"For all the others look after their own interests, not those of Jesus Christ.","strongs":[[0,3,"G1063"],[4,7,"G3956"],[8,18,"G3588"],[19,29,"G2212"],[30,39,"G1438"],[40,49,"G3588"],[51,54,"G3756"],[55,60,"G3588"],[61,69,"G2424"],[70,76,"G5547"]]},{"book":"PHP","chapter":2,"verse":22,"text":"But you know Timothy’s proven worth, that as a child with his father he has served with me to advance the gospel.","strongs":[[0,3,"G1161"],[4,12,"G1097"],[13,22,"G846"],[23,35,"G1382"],[37,41,"G3754"],[42,44,"G5613"],[45,52,"G5043"],[53,68,"G3962"],[69,82,"G1398"],[83,87,"G4862"],[88,90,"G1473"],[91,101,"G1519"],[102,105,"G3588"],[106,112,"G2098"]]},{"book":"PHP","chapter":2,"verse":23,"text":"So I hope to send him as soon as I see what happens with me.","strongs":[[0,2,"G3767"],[3,9,"G1679"],[10,17,"G3992"],[18,21,"G3778"],[22,32,"G1824"],[33,38,"G872"],[39,51,"G3588"],[52,56,"G4012"],[57,59,"G1473"]]},{"book":"PHP","chapter":2,"verse":24,"text":"And I trust in the Lord that I myself will come soon.","strongs":[[0,3,"G1161"],[4,11,"G3982"],[12,14,"G1722"],[15,23,"G2962"],[24,28,"G3754"],[29,37,"G846"],[38,47,"G2064"],[48,52,"G5030"]]},{"book":"PHP","chapter":2,"verse":25,"text":"But I thought it necessary to send back to you Epaphroditus, my brother, fellow worker, and fellow soldier, who is also your messenger and minister to my needs.","strongs":[[0,3,"G1161"],[4,16,"G2233"],[17,26,"G316"],[27,39,"G3992"],[40,42,"G4314"],[43,46,"G4771"],[47,59,"G1891"],[61,63,"G1473"],[64,71,"G80"],[73,86,"G4904"],[88,91,"G2532"],[92,106,"G4961"],[108,119,"G1161"],[120,124,"G4771"],[125,134,"G652"],[135,138,"G2532"],[139,147,"G3011"],[148,153,"G1473"],[154,159,"G5532"]]},{"book":"PHP","chapter":2,"verse":26,"text":"For he has been longing for all of you and is distressed because you heard he was ill.","strongs":[[0,3,"G1894"],[4,15,"G1510"],[16,27,"G1971"],[28,31,"G3956"],[32,38,"G4771"],[39,42,"G2532"],[43,56,"G85"],[57,64,"G1360"],[65,74,"G191"],[75,85,"G770"]]},{"book":"PHP","chapter":2,"verse":27,"text":"He was sick indeed, nearly unto death. But God had mercy on him, and not only on him but also on me, to spare me sorrow upon sorrow.","strongs":[[0,11,"G770"],[12,18,"G2532"],[20,26,"G3897"],[27,37,"G2288"],[39,42,"G235"],[43,46,"G2316"],[47,59,"G1653"],[60,63,"G846"],[65,68,"G1161"],[69,72,"G3756"],[73,77,"G3441"],[78,84,"G846"],[85,88,"G235"],[89,93,"G2532"],[94,99,"G1473"],[101,103,"G2443"],[104,112,"G2192"],[113,119,"G3077"],[120,124,"G1909"],[125,131,"G3077"]]},{"book":"PHP","chapter":2,"verse":28,"text":"Therefore I am all the more eager to send him, so that when you see him again you may rejoice, and I may be less anxious.","strongs":[[0,9,"G3767"],[10,33,"G4708"],[34,41,"G3992"],[42,45,"G846"],[47,54,"G2443"],[55,67,"G3708"],[68,71,"G846"],[72,77,"G3825"],[78,93,"G5463"],[95,100,"G2504"],[101,107,"G1510"],[108,120,"G253"]]},{"book":"PHP","chapter":2,"verse":29,"text":"Welcome him in the Lord with great joy, and honor men like him,","strongs":[[0,7,"G4327"],[8,11,"G846"],[12,14,"G1722"],[15,23,"G2962"],[24,28,"G3326"],[29,34,"G3956"],[35,38,"G5479"],[40,43,"G2532"],[44,49,"G1784"],[50,62,"G5108"]]},{"book":"PHP","chapter":2,"verse":30,"text":"because he nearly died for the work of Christ, risking his life to make up for your deficit of service to me.","strongs":[[0,7,"G3754"],[8,17,"G1448"],[18,22,"G2288"],[23,26,"G1223"],[27,30,"G3588"],[31,35,"G2041"],[36,45,"G5547"],[47,54,"G3851"],[55,58,"G3588"],[59,63,"G5590"],[64,78,"G378"],[79,83,"G4771"],[84,91,"G5303"],[92,94,"G3588"],[95,102,"G3009"],[103,105,"G4314"],[106,108,"G1473"]]},{"book":"PHP","chapter":3,"verse":1,"text":"Finally, my brothers, rejoice in the Lord. It is no trouble for me to write the same things to you again, and it is a safeguard for you.","strongs":[[0,7,"G3063"],[9,11,"G1473"],[12,20,"G80"],[22,29,"G5463"],[30,32,"G1722"],[33,41,"G2962"],[43,51,"G3756"],[52,59,"G3636"],[60,66,"G1473"],[67,75,"G1125"],[76,79,"G3588"],[80,91,"G846"],[92,98,"G4771"],[99,104,"G3303"],[106,109,"G1161"],[110,127,"G804"],[128,135,"G4771"]]},{"book":"PHP","chapter":3,"verse":2,"text":"Watch out for those dogs, those workers of evil, those mutilators of the flesh!","strongs":[[0,13,"G991"],[14,19,"G3588"],[20,24,"G2965"],[26,31,"G3588"],[32,39,"G2040"],[40,47,"G2556"],[49,54,"G3588"],[55,78,"G2699"]]},{"book":"PHP","chapter":3,"verse":3,"text":"For it is we who are the circumcision, we who worship by the Spirit of God, who glory in Christ Jesus, and who put no confidence in the flesh—","strongs":[[0,3,"G1063"],[4,12,"G1473"],[13,20,"G1510"],[21,24,"G3588"],[25,37,"G4061"],[39,45,"G3588"],[46,53,"G3000"],[54,67,"G4151"],[68,74,"G2316"],[76,79,"G2532"],[80,85,"G2744"],[86,88,"G1722"],[89,95,"G5547"],[96,101,"G2424"],[103,110,"G2532"],[111,128,"G3982"],[129,131,"G1722"],[132,141,"G4561"]]},{"book":"PHP","chapter":3,"verse":4,"text":"though I myself could have such confidence. If anyone else thinks he has grounds for confidence in the flesh, I have more:","strongs":[[0,6,"G2539"],[7,15,"G1473"],[16,26,"G2192"],[27,42,"G4006"],[44,46,"G1487"],[47,53,"G5100"],[54,58,"G243"],[59,65,"G1380"],[66,95,"G3982"],[96,98,"G1722"],[99,108,"G4561"],[110,111,"G1473"],[112,121,"G3123"]]},{"book":"PHP","chapter":3,"verse":5,"text":"circumcised on the eighth day, of the people of Israel, of the tribe of Benjamin; a Hebrew of Hebrews; as to the law, a Pharisee;","strongs":[[0,11,"G4061"],[12,29,"G3637"],[31,33,"G1537"],[34,44,"G1085"],[45,54,"G2474"],[56,68,"G5443"],[69,80,"G958"],[82,90,"G1445"],[91,93,"G1537"],[94,101,"G1445"],[103,108,"G2596"],[109,116,"G3551"],[118,128,"G5330"]]},{"book":"PHP","chapter":3,"verse":6,"text":"as to zeal, persecuting the church; as to righteousness in the law, faultless.","strongs":[[0,5,"G2596"],[6,10,"G2205"],[12,23,"G1377"],[24,27,"G3588"],[28,34,"G1577"],[36,41,"G2596"],[42,55,"G1343"],[56,58,"G1722"],[59,66,"G3551"],[68,77,"G273"]]},{"book":"PHP","chapter":3,"verse":7,"text":"But whatever was gain to me I count as loss for the sake of Christ.","strongs":[[0,3,"G235"],[4,12,"G3748"],[13,16,"G1510"],[17,21,"G2771"],[22,27,"G1473"],[28,38,"G2233"],[39,43,"G2209"],[44,59,"G1223"],[60,66,"G5547"]]},{"book":"PHP","chapter":3,"verse":8,"text":"More than that, I count all things as loss compared to the surpassing excellence of knowing Christ Jesus my Lord, for whom I have lost all things. I consider them rubbish, that I may gain Christ","strongs":[[0,14,"G235"],[16,23,"G2233"],[24,34,"G3956"],[35,37,"G1510"],[38,42,"G2209"],[43,54,"G1223"],[55,58,"G3588"],[59,80,"G5242"],[81,83,"G3588"],[84,91,"G1108"],[92,98,"G5547"],[99,104,"G2424"],[105,107,"G1473"],[108,112,"G2962"],[114,117,"G1223"],[118,122,"G3739"],[123,134,"G2210"],[135,145,"G3956"],[147,162,"G2233"],[163,170,"G4657"],[172,176,"G2443"],[177,187,"G2770"],[188,194,"G5547"]]},{"book":"PHP","chapter":3,"verse":9,"text":"and be found in Him, not having my own righteousness from the law, but that which is through faith in Christ, the righteousness from God on the basis of faith.","strongs":[[0,3,"G2532"],[4,12,"G2147"],[13,15,"G1722"],[16,19,"G846"],[21,24,"G3361"],[25,31,"G2192"],[32,38,"G1699"],[39,52,"G1343"],[53,57,"G1537"],[58,65,"G3551"],[67,70,"G235"],[71,81,"G3588"],[82,92,"G1223"],[93,98,"G4102"],[99,108,"G5547"],[110,113,"G3588"],[114,127,"G1343"],[128,132,"G1537"],[133,136,"G2316"],[137,152,"G1909"],[153,158,"G4102"]]},{"book":"PHP","chapter":3,"verse":10,"text":"I want to know Christ and the power of His resurrection and the fellowship of His sufferings, being conformed to Him in His death,","strongs":[[0,14,"G1097"],[15,21,"G846"],[22,25,"G2532"],[26,29,"G3588"],[30,35,"G1411"],[36,38,"G3588"],[39,42,"G846"],[43,55,"G386"],[56,59,"G2532"],[60,63,"G3588"],[64,74,"G2842"],[75,77,"G3588"],[78,81,"G846"],[82,92,"G3804"],[94,109,"G4833"],[110,116,"G3588"],[117,123,"G846"],[124,129,"G2288"]]},{"book":"PHP","chapter":3,"verse":11,"text":"and so, somehow, to attain to the resurrection from the dead.","strongs":[[0,6,"G1487"],[8,15,"G4459"],[17,26,"G2658"],[27,29,"G1519"],[30,33,"G3588"],[34,46,"G1815"],[47,51,"G1537"],[52,60,"G3498"]]},{"book":"PHP","chapter":3,"verse":12,"text":"Not that I have already obtained all this, or have already been made perfect, but I press on to take hold of that for which Christ Jesus took hold of me.","strongs":[[0,3,"G3756"],[4,8,"G3754"],[9,41,"G2983"],[43,45,"G2228"],[46,76,"G5048"],[78,81,"G1161"],[82,92,"G1377"],[93,108,"G2638"],[109,123,"G1909"],[124,130,"G5547"],[131,136,"G2424"],[137,152,"G2638"]]},{"book":"PHP","chapter":3,"verse":13,"text":"Brothers, I do not consider myself yet to have taken hold of it. But one thing I do: Forgetting what is behind and straining toward what is ahead,","strongs":[[0,8,"G80"],[10,11,"G1473"],[12,18,"G3756"],[19,27,"G3049"],[28,34,"G1683"],[35,63,"G2638"],[65,68,"G1161"],[69,83,"G1520"],[85,95,"G1950"],[96,103,"G3588"],[104,110,"G3694"],[111,114,"G1161"],[115,131,"G1901"],[132,139,"G3588"],[140,145,"G1715"]]},{"book":"PHP","chapter":3,"verse":14,"text":"I press on toward the goal to win the prize of God’s heavenly calling in Christ Jesus.","strongs":[[0,10,"G1377"],[11,17,"G2596"],[18,26,"G4649"],[27,33,"G1519"],[34,37,"G3588"],[38,43,"G1017"],[44,46,"G3588"],[47,52,"G2316"],[53,61,"G507"],[62,69,"G2821"],[70,72,"G1722"],[73,79,"G5547"],[80,85,"G2424"]]},{"book":"PHP","chapter":3,"verse":15,"text":"All of us who are mature should embrace this point of view. And if you think differently about some issue, God will reveal this to you as well.","strongs":[[0,13,"G3745"],[14,24,"G5046"],[25,58,"G5426"],[60,63,"G2532"],[64,66,"G1487"],[67,76,"G5426"],[77,88,"G2088"],[89,105,"G5100"],[107,110,"G2316"],[111,122,"G601"],[123,127,"G3778"],[128,134,"G4771"],[135,142,"G2532"]]},{"book":"PHP","chapter":3,"verse":16,"text":"Nevertheless, we must live up to what we have already attained.","strongs":[[0,12,"G4133"],[14,29,"G4748"],[30,32,"G1519"],[33,37,"G3739"],[38,62,"G5348"]]},{"book":"PHP","chapter":3,"verse":17,"text":"Join one another in following my example, brothers, and carefully observe those who walk according to the pattern we set for you.","strongs":[[0,29,"G4831"],[30,40,"G1473"],[42,50,"G80"],[52,55,"G2532"],[56,73,"G4648"],[74,83,"G3588"],[84,88,"G4043"],[89,101,"G2531"],[102,113,"G5179"],[114,128,"G2192"]]},{"book":"PHP","chapter":3,"verse":18,"text":"For as I have often told you before, and now say again even with tears: Many live as enemies of the cross of Christ.","strongs":[[0,3,"G1063"],[4,6,"G3739"],[7,24,"G2036"],[25,35,"G4771"],[37,40,"G1161"],[41,44,"G3568"],[45,54,"G3004"],[55,59,"G2532"],[60,70,"G2799"],[72,76,"G4183"],[77,81,"G4043"],[82,92,"G2190"],[93,99,"G3588"],[100,105,"G4716"],[106,115,"G5547"]]},{"book":"PHP","chapter":3,"verse":19,"text":"Their end is destruction, their god is their belly, and their glory is in their shame. Their minds are set on earthly things.","strongs":[[0,5,"G3739"],[6,12,"G5056"],[13,24,"G684"],[26,31,"G3739"],[32,38,"G2316"],[39,44,"G3588"],[45,50,"G2836"],[52,55,"G2532"],[56,61,"G3588"],[62,67,"G1391"],[68,73,"G1722"],[74,79,"G846"],[80,85,"G152"],[87,92,"G3588"],[93,109,"G5426"],[110,117,"G1919"],[118,124,"G3588"]]},{"book":"PHP","chapter":3,"verse":20,"text":"But our citizenship is in heaven, and we eagerly await a Savior from there, the Lord Jesus Christ,","strongs":[[0,3,"G1063"],[4,7,"G1473"],[8,19,"G4175"],[20,22,"G5225"],[23,25,"G1722"],[26,32,"G3772"],[34,37,"G2532"],[38,54,"G553"],[55,63,"G4990"],[64,68,"G1537"],[69,74,"G3739"],[76,84,"G2962"],[85,90,"G2424"],[91,97,"G5547"]]},{"book":"PHP","chapter":3,"verse":21,"text":"who, by the power that enables Him to subject all things to Himself, will transform our lowly bodies to be like His glorious body.","strongs":[[0,3,"G3739"],[5,7,"G2596"],[8,11,"G3588"],[12,17,"G1753"],[18,34,"G1410"],[35,45,"G5293"],[46,56,"G3956"],[57,67,"G848"],[69,83,"G3345"],[84,87,"G1473"],[88,93,"G5014"],[94,100,"G4983"],[101,111,"G4832"],[112,115,"G846"],[116,124,"G1391"],[125,129,"G4983"]]},{"book":"PHP","chapter":4,"verse":1,"text":"Therefore, my brothers, whom I love and long for, my joy and crown, that is how you must stand firm in the Lord, my beloved.","strongs":[[0,9,"G5620"],[11,13,"G1473"],[14,22,"G80"],[24,35,"G27"],[36,39,"G2532"],[40,48,"G1973"],[50,52,"G1473"],[53,56,"G5479"],[57,60,"G2532"],[61,66,"G4735"],[68,79,"G3779"],[80,99,"G4739"],[100,102,"G1722"],[103,111,"G2962"],[113,123,"G27"]]},{"book":"PHP","chapter":4,"verse":2,"text":"I urge Euodia and Syntyche to agree with each other in the Lord.","strongs":[[0,6,"G3870"],[7,13,"G2136"],[14,17,"G2532"],[18,26,"G4941"],[27,51,"G5426"],[52,54,"G1722"],[55,63,"G2962"]]},{"book":"PHP","chapter":4,"verse":3,"text":"Yes, and I ask you, my true yokefellow, to help these women who have contended at my side for the gospel, along with Clement and the rest of my fellow workers, whose names are in the Book of Life.","strongs":[[0,3,"G3483"],[5,8,"G2532"],[9,14,"G2065"],[15,18,"G4771"],[20,27,"G1103"],[28,38,"G4805"],[40,47,"G4815"],[48,59,"G846"],[60,63,"G3748"],[64,78,"G4866"],[79,89,"G1473"],[90,93,"G1722"],[94,97,"G3588"],[98,104,"G2098"],[106,111,"G2532"],[112,116,"G3326"],[117,124,"G2815"],[125,128,"G2532"],[129,132,"G3588"],[133,137,"G3062"],[138,143,"G1473"],[144,158,"G4904"],[160,165,"G3739"],[166,175,"G3686"],[176,178,"G1722"],[179,187,"G976"],[188,195,"G2222"]]},{"book":"PHP","chapter":4,"verse":4,"text":"Rejoice in the Lord always. I will say it again: Rejoice!","strongs":[[0,7,"G5463"],[8,10,"G1722"],[11,19,"G2962"],[20,26,"G3842"],[28,41,"G2046"],[42,47,"G3825"],[49,56,"G5463"]]},{"book":"PHP","chapter":4,"verse":5,"text":"Let your gentleness be apparent to all. The Lord is near.","strongs":[[0,8,"G4771"],[9,19,"G1933"],[20,31,"G1097"],[32,38,"G3956"],[40,43,"G3588"],[44,48,"G2962"],[49,56,"G1451"]]},{"book":"PHP","chapter":4,"verse":6,"text":"Be anxious for nothing, but in everything, by prayer and petition, with thanksgiving, present your requests to God.","strongs":[[0,14,"G3309"],[15,22,"G3367"],[24,27,"G235"],[28,30,"G1722"],[31,41,"G3956"],[43,45,"G3588"],[46,52,"G4335"],[53,56,"G2532"],[57,65,"G1162"],[67,71,"G3326"],[72,84,"G2169"],[86,93,"G1107"],[94,98,"G4771"],[99,107,"G155"],[108,110,"G4314"],[111,114,"G2316"]]},{"book":"PHP","chapter":4,"verse":7,"text":"And the peace of God, which surpasses all understanding, will guard your hearts and your minds in Christ Jesus.","strongs":[[0,3,"G2532"],[4,7,"G3588"],[8,13,"G1515"],[14,20,"G2316"],[22,27,"G3588"],[28,37,"G5242"],[38,41,"G3956"],[42,55,"G3563"],[57,67,"G5432"],[68,72,"G4771"],[73,79,"G2588"],[80,83,"G2532"],[84,88,"G4771"],[89,94,"G3540"],[95,97,"G1722"],[98,104,"G5547"],[105,110,"G2424"]]},{"book":"PHP","chapter":4,"verse":8,"text":"Finally, brothers, whatever is true, whatever is honorable, whatever is right, whatever is pure, whatever is lovely, whatever is admirable—if anything is excellent or praiseworthy—think on these things.","strongs":[[0,7,"G3063"],[9,17,"G80"],[19,27,"G3745"],[28,30,"G1510"],[31,35,"G227"],[37,45,"G3745"],[46,58,"G4586"],[60,68,"G3745"],[69,77,"G1342"],[79,87,"G3745"],[88,95,"G53"],[97,105,"G3745"],[106,115,"G4375"],[117,125,"G3745"],[126,138,"G2163"],[139,141,"G1487"],[142,150,"G5100"],[151,153,"G5100"],[154,163,"G703"],[164,166,"G2532"],[167,179,"G1868"],[180,188,"G3049"],[189,201,"G3778"]]},{"book":"PHP","chapter":4,"verse":9,"text":"Whatever you have learned or received or heard from me, or seen in me, put it into practice. And the God of peace will be with you.","strongs":[[0,8,"G3739"],[9,25,"G3129"],[26,28,"G2532"],[29,37,"G3880"],[38,40,"G2532"],[41,54,"G191"],[56,58,"G2532"],[59,63,"G3708"],[64,66,"G1722"],[67,69,"G1473"],[71,91,"G4238"],[93,96,"G2532"],[97,100,"G3588"],[101,104,"G2316"],[105,113,"G1515"],[114,121,"G1510"],[122,126,"G3326"],[127,130,"G4771"]]},{"book":"PHP","chapter":4,"verse":10,"text":"Now I rejoice greatly in the Lord that at last you have revived your concern for me. You were indeed concerned, but you had no opportunity to show it.","strongs":[[0,3,"G1161"],[4,13,"G5463"],[14,21,"G3171"],[22,24,"G1722"],[25,33,"G2962"],[34,38,"G3754"],[39,46,"G4218"],[47,63,"G330"],[64,68,"G3588"],[69,76,"G5426"],[77,80,"G5228"],[81,83,"G1473"],[85,110,"G5426"],[112,115,"G1161"],[116,149,"G170"]]},{"book":"PHP","chapter":4,"verse":11,"text":"I am not saying this out of need, for I have learned to be content regardless of my circumstances.","strongs":[[0,20,"G3004"],[21,27,"G2596"],[28,32,"G5304"],[34,37,"G1063"],[38,39,"G1473"],[40,52,"G3129"],[53,58,"G1510"],[59,66,"G842"],[67,97,"G1722"]]},{"book":"PHP","chapter":4,"verse":12,"text":"I know how to live humbly, and I know how to abound. In any and every situation I have learned the secret of being filled and being hungry, of having plenty and having need.","strongs":[[0,6,"G1492"],[7,25,"G5013"],[27,30,"G2532"],[31,37,"G1492"],[38,51,"G4052"],[53,55,"G1722"],[56,59,"G3956"],[60,63,"G2532"],[64,79,"G3956"],[80,105,"G3453"],[106,121,"G5526"],[122,125,"G2532"],[126,138,"G3983"],[140,156,"G4052"],[157,160,"G2532"],[161,172,"G5302"]]},{"book":"PHP","chapter":4,"verse":13,"text":"I can do all things through Christ who gives me strength.","strongs":[[0,8,"G2480"],[9,19,"G3956"],[20,27,"G1722"],[28,38,"G3588"],[39,56,"G1743"]]},{"book":"PHP","chapter":4,"verse":14,"text":"Nevertheless, you have done well to share in my affliction.","strongs":[[0,12,"G4133"],[14,27,"G4160"],[28,32,"G2573"],[33,44,"G4790"],[45,47,"G1473"],[48,58,"G2347"]]},{"book":"PHP","chapter":4,"verse":15,"text":"And as you Philippians know, in the early days of the gospel, when I left Macedonia, no church but you partnered with me in the matter of giving and receiving.","strongs":[[0,6,"G1161"],[7,10,"G4771"],[11,22,"G5374"],[23,27,"G1492"],[29,31,"G1722"],[32,46,"G746"],[47,53,"G3588"],[54,60,"G2098"],[62,66,"G3753"],[67,73,"G1831"],[74,83,"G3109"],[85,87,"G3762"],[88,94,"G1577"],[95,98,"G1487"],[99,102,"G4771"],[103,112,"G2841"],[113,120,"G1473"],[121,123,"G1519"],[124,134,"G3056"],[135,144,"G1394"],[145,148,"G2532"],[149,158,"G3028"]]},{"book":"PHP","chapter":4,"verse":16,"text":"For even while I was in Thessalonica, you provided for my needs again and again.","strongs":[[0,3,"G3754"],[4,8,"G2532"],[9,23,"G1722"],[24,36,"G2332"],[38,50,"G3992"],[51,54,"G1519"],[55,57,"G1473"],[58,63,"G5532"],[64,69,"G530"],[70,73,"G2532"],[74,79,"G1364"]]},{"book":"PHP","chapter":4,"verse":17,"text":"Not that I am seeking a gift, but I am looking for the fruit that may be credited to your account.","strongs":[[0,3,"G3756"],[4,8,"G3754"],[9,21,"G1934"],[22,23,"G3588"],[24,28,"G1390"],[30,33,"G235"],[34,50,"G1934"],[51,54,"G3588"],[55,60,"G2590"],[61,65,"G3588"],[66,81,"G4121"],[82,84,"G1519"],[85,89,"G4771"],[90,97,"G3056"]]},{"book":"PHP","chapter":4,"verse":18,"text":"I have all I need and more, now that I have received your gifts from Epaphroditus. They are a fragrant offering, an acceptable sacrifice, well-pleasing to God.","strongs":[[0,6,"G568"],[7,10,"G3956"],[11,17,"G4137"],[18,21,"G2532"],[22,26,"G4052"],[28,52,"G1209"],[53,57,"G4771"],[58,63,"G3588"],[64,68,"G3844"],[69,81,"G1891"],[83,111,"G2175"],[113,126,"G1184"],[127,136,"G2378"],[138,151,"G2101"],[152,158,"G2316"]]},{"book":"PHP","chapter":4,"verse":19,"text":"And my God will supply all your needs according to His glorious riches in Christ Jesus.","strongs":[[0,3,"G1161"],[4,6,"G1473"],[7,10,"G2316"],[11,22,"G4137"],[23,26,"G3956"],[27,31,"G4771"],[32,37,"G5532"],[38,50,"G2596"],[51,54,"G846"],[55,63,"G1391"],[64,70,"G4149"],[71,73,"G1722"],[74,80,"G5547"],[81,86,"G2424"]]},{"book":"PHP","chapter":4,"verse":20,"text":"To our God and Father be glory forever and ever. Amen.","strongs":[[0,2,"G3588"],[3,6,"G1473"],[7,10,"G2316"],[11,14,"G2532"],[15,21,"G3962"],[22,24,"G3588"],[25,30,"G1391"],[31,38,"G165"],[39,42,"G3588"],[43,47,"G165"],[49,53,"G281"]]},{"book":"PHP","chapter":4,"verse":21,"text":"Greet all the saints in Christ Jesus. The brothers who are with me send you greetings.","strongs":[[0,5,"G782"],[6,9,"G3956"],[10,20,"G40"],[21,23,"G1722"],[24,30,"G5547"],[31,36,"G2424"],[38,41,"G3588"],[42,50,"G80"],[51,63,"G4862"],[64,66,"G1473"],[67,85,"G782"]]},{"book":"PHP","chapter":4,"verse":22,"text":"All the saints send you greetings, especially those from the household of Caesar.","strongs":[[0,3,"G3956"],[4,7,"G3588"],[8,14,"G40"],[15,33,"G782"],[35,45,"G3122"],[46,51,"G3588"],[52,56,"G1537"],[57,60,"G3588"],[61,70,"G3614"],[71,80,"G2541"]]},{"book":"PHP","chapter":4,"verse":23,"text":"The grace of the Lord Jesus Christ be with your spirit.","strongs":[[0,3,"G3588"],[4,9,"G5485"],[10,16,"G3588"],[17,21,"G2962"],[22,27,"G2424"],[28,34,"G5547"],[35,42,"G3326"],[43,47,"G4771"],[48,54,"G4151"]]}]}