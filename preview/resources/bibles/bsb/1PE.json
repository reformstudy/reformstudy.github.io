{"id":"1PE","name":"1 Peter","testament":"NT","chapters":5,"verses":[{"book":"1PE","chapter":1,"verse":1,"text":"Peter, an apostle of Jesus Christ, To the elect who are exiles of the Dispersion throughout Pontus, Galatia, Cappadocia, Asia, and Bithynia, chosen","strongs":[[0,5,"G4074"],[7,17,"G652"],[18,26,"G2424"],[27,33,"G5547"],[35,47,"G1588"],[48,62,"G3927"],[63,80,"G1290"],[81,98,"G4195"],[100,107,"G1053"],[109,119,"G2587"],[121,125,"G773"],[127,130,"G2532"],[131,147,"G978"]]},{"book":"1PE","chapter":1,"verse":2,"text":"according to the foreknowledge of God the Father and sanctified by the Spirit for obedience to Jesus Christ and sprinkling by His blood: Grace and peace be yours in abundance.","strongs":[[0,12,"G2596"],[13,30,"G4268"],[31,37,"G2316"],[38,48,"G3962"],[49,63,"G38"],[64,66,"G1722"],[67,77,"G4151"],[78,81,"G1519"],[82,91,"G5218"],[92,100,"G2424"],[101,107,"G5547"],[108,111,"G2532"],[112,122,"G4473"],[123,135,"G129"],[137,142,"G5485"],[143,146,"G2532"],[147,152,"G1515"],[153,161,"G4771"],[162,174,"G4129"]]},{"book":"1PE","chapter":1,"verse":3,"text":"Blessed be the God and Father of our Lord Jesus Christ! By His great mercy He has given us new birth into a living hope through the resurrection of Jesus Christ from the dead,","strongs":[[0,10,"G2128"],[11,14,"G3588"],[15,18,"G2316"],[19,22,"G2532"],[23,29,"G3962"],[30,36,"G1473"],[37,41,"G2962"],[42,47,"G2424"],[48,54,"G5547"],[56,58,"G2596"],[59,62,"G846"],[63,68,"G4183"],[69,74,"G1656"],[75,77,"G3588"],[78,100,"G313"],[101,105,"G1519"],[106,114,"G2198"],[115,119,"G1680"],[120,127,"G1223"],[128,144,"G386"],[145,153,"G2424"],[154,160,"G5547"],[161,165,"G1537"],[166,174,"G3498"]]},{"book":"1PE","chapter":1,"verse":4,"text":"and into an inheritance that is imperishable, undefiled, and unfading, reserved in heaven for you,","strongs":[[0,8,"G1519"],[9,31,"G2817"],[32,44,"G862"],[46,55,"G283"],[57,60,"G2532"],[61,69,"G263"],[71,79,"G5083"],[80,82,"G1722"],[83,89,"G3772"],[90,93,"G1519"],[94,97,"G4771"]]},{"book":"1PE","chapter":1,"verse":5,"text":"who through faith are shielded by God’s power for the salvation that is ready to be revealed in the last time.","strongs":[[0,3,"G3588"],[4,11,"G1223"],[12,17,"G4102"],[18,30,"G5432"],[31,33,"G1722"],[34,39,"G2316"],[40,45,"G1411"],[46,49,"G1519"],[50,63,"G4991"],[64,77,"G2092"],[78,92,"G601"],[93,95,"G1722"],[96,104,"G2078"],[105,109,"G2540"]]},{"book":"1PE","chapter":1,"verse":6,"text":"In this you greatly rejoice, though now for a little while you may have had to suffer grief in various trials","strongs":[[0,2,"G1722"],[3,7,"G3739"],[8,27,"G21"],[29,35,"G1487"],[36,39,"G737"],[40,58,"G3641"],[59,66,"G1510"],[67,75,"G1163"],[76,91,"G3076"],[92,94,"G1722"],[95,102,"G4164"],[103,109,"G3986"]]},{"book":"1PE","chapter":1,"verse":7,"text":"so that the proven character of your faith—more precious than gold, which perishes even though refined by fire—may result in praise, glory, and honor at the revelation of Jesus Christ.","strongs":[[0,7,"G2443"],[8,11,"G3588"],[12,28,"G1383"],[29,36,"G4771"],[37,42,"G4102"],[43,56,"G4186"],[57,66,"G5553"],[68,73,"G3588"],[74,82,"G622"],[83,94,"G1161"],[95,102,"G1381"],[103,105,"G1223"],[106,110,"G4442"],[111,124,"G2147"],[125,131,"G1868"],[133,138,"G1391"],[140,143,"G2532"],[144,149,"G5092"],[150,152,"G1722"],[153,167,"G602"],[168,176,"G2424"],[177,183,"G5547"]]},{"book":"1PE","chapter":1,"verse":8,"text":"Though you have not seen Him, you love Him; and though you do not see Him now, you believe in Him and rejoice with an inexpressible and glorious joy,","strongs":[[0,24,"G3708"],[25,28,"G3739"],[30,42,"G25"],[44,69,"G3708"],[70,73,"G3739"],[74,77,"G737"],[79,90,"G4100"],[91,97,"G1519"],[98,101,"G1161"],[102,109,"G21"],[110,131,"G412"],[132,135,"G2532"],[136,144,"G1392"],[145,148,"G5479"]]},{"book":"1PE","chapter":1,"verse":9,"text":"now that you are receiving the goal of your faith, the salvation of your souls.","strongs":[[0,26,"G2865"],[27,30,"G3588"],[31,35,"G5056"],[36,38,"G3588"],[39,43,"G4771"],[44,49,"G4102"],[51,64,"G4991"],[65,78,"G5590"]]},{"book":"1PE","chapter":1,"verse":10,"text":"Concerning this salvation, the prophets who foretold the grace to come to you searched and investigated carefully,","strongs":[[0,10,"G4012"],[11,15,"G3739"],[16,25,"G4991"],[27,39,"G4396"],[40,43,"G3588"],[44,52,"G4395"],[53,56,"G3588"],[57,62,"G5485"],[63,70,"G1519"],[71,77,"G4771"],[78,86,"G1567"],[87,90,"G2532"],[91,113,"G1830"]]},{"book":"1PE","chapter":1,"verse":11,"text":"trying to determine the time and setting to which the Spirit of Christ in them was pointing when He predicted the sufferings of Christ and the glories to follow.","strongs":[[0,19,"G2045"],[20,40,"G5101"],[41,53,"G3588"],[54,60,"G4151"],[61,70,"G5547"],[71,73,"G1722"],[74,78,"G846"],[79,91,"G1213"],[92,109,"G4303"],[110,113,"G3588"],[114,124,"G3804"],[125,127,"G1519"],[128,134,"G5547"],[135,138,"G2532"],[139,142,"G3588"],[143,150,"G1391"],[151,160,"G3778"]]},{"book":"1PE","chapter":1,"verse":12,"text":"It was revealed to them that they were not serving themselves, but you, when they foretold the things now announced by those who preached the gospel to you by the Holy Spirit sent from heaven. Even angels long to look into these things.","strongs":[[0,15,"G601"],[16,23,"G3739"],[24,28,"G3754"],[29,50,"G1247"],[51,61,"G1438"],[63,66,"G1161"],[67,70,"G4771"],[72,101,"G846"],[102,115,"G312"],[116,118,"G1223"],[119,128,"G3588"],[129,148,"G2097"],[149,155,"G4771"],[156,158,"G1722"],[159,167,"G40"],[168,174,"G4151"],[175,179,"G649"],[180,184,"G575"],[185,191,"G3772"],[193,204,"G32"],[205,209,"G1937"],[210,217,"G3879"],[218,222,"G1519"],[223,235,"G3739"]]},{"book":"1PE","chapter":1,"verse":13,"text":"Therefore prepare your minds for action. Be sober-minded. Set your hope fully on the grace to be given you at the revelation of Jesus Christ.","strongs":[[0,9,"G1352"],[10,17,"G328"],[18,22,"G4771"],[23,39,"G1271"],[41,56,"G3525"],[58,71,"G1679"],[72,77,"G5049"],[78,80,"G1909"],[81,84,"G3588"],[85,90,"G5485"],[91,102,"G5342"],[103,106,"G4771"],[107,109,"G1722"],[110,124,"G602"],[125,133,"G2424"],[134,140,"G5547"]]},{"book":"1PE","chapter":1,"verse":14,"text":"As obedient children, do not conform to the passions of your former ignorance.","strongs":[[0,2,"G5613"],[3,11,"G5218"],[12,20,"G5043"],[22,36,"G4964"],[37,43,"G3588"],[44,52,"G1939"],[53,55,"G1722"],[56,60,"G4771"],[61,67,"G4386"],[68,77,"G52"]]},{"book":"1PE","chapter":1,"verse":15,"text":"But just as He who called you is holy, so be holy in all you do,","strongs":[[0,3,"G235"],[4,11,"G2596"],[12,18,"G3588"],[19,25,"G2564"],[26,29,"G4771"],[30,37,"G40"],[39,41,"G2532"],[42,44,"G1096"],[45,49,"G40"],[50,52,"G1722"],[53,56,"G3956"],[57,63,"G391"]]},{"book":"1PE","chapter":1,"verse":16,"text":"for it is written: “Be holy, because I am holy.”","strongs":[[0,3,"G1360"],[4,17,"G1125"],[20,22,"G1510"],[23,27,"G40"],[29,36,"G3754"],[37,38,"G1473"],[39,41,"G1510"],[42,46,"G40"]]},{"book":"1PE","chapter":1,"verse":17,"text":"Since you call on a Father who judges each one’s work impartially, conduct yourselves in reverent fear during your stay as foreigners.","strongs":[[0,5,"G1487"],[6,17,"G1941"],[18,26,"G3962"],[27,30,"G3588"],[31,37,"G2919"],[38,48,"G1538"],[49,53,"G2041"],[54,65,"G678"],[67,85,"G390"],[86,88,"G1722"],[89,102,"G5401"],[103,109,"G3588"],[110,114,"G4771"],[115,119,"G5550"],[120,133,"G3940"]]},{"book":"1PE","chapter":1,"verse":18,"text":"For you know that it was not with perishable things such as silver or gold that you were redeemed from the empty way of life you inherited from your forefathers,","strongs":[[0,12,"G1492"],[13,17,"G3754"],[18,51,"G5349"],[52,66,"G694"],[67,69,"G2228"],[70,74,"G5553"],[75,97,"G3084"],[98,102,"G1537"],[103,106,"G3588"],[107,112,"G3152"],[113,124,"G391"],[125,128,"G4771"],[129,160,"G3970"]]},{"book":"1PE","chapter":1,"verse":19,"text":"but with the precious blood of Christ, a lamb without blemish or spot.","strongs":[[0,3,"G235"],[4,21,"G5093"],[22,27,"G129"],[28,37,"G5547"],[39,45,"G286"],[46,61,"G299"],[62,64,"G2532"],[65,69,"G784"]]},{"book":"1PE","chapter":1,"verse":20,"text":"He was known before the foundation of the world, but was revealed in the last times for your sake.","strongs":[[0,12,"G4267"],[13,19,"G4253"],[20,34,"G2602"],[35,47,"G2889"],[49,52,"G1161"],[53,65,"G5319"],[66,68,"G1909"],[69,72,"G3588"],[73,77,"G2078"],[78,83,"G5550"],[84,97,"G1223"]]},{"book":"1PE","chapter":1,"verse":21,"text":"Through Him you believe in God, who raised Him from the dead and glorified Him; and so your faith and hope are in God.","strongs":[[0,7,"G1223"],[8,11,"G846"],[12,15,"G3588"],[16,23,"G4103"],[24,26,"G1519"],[27,30,"G2316"],[32,35,"G3588"],[36,46,"G1453"],[47,51,"G1537"],[52,60,"G3498"],[61,64,"G2532"],[65,74,"G1391"],[75,78,"G846"],[80,86,"G5620"],[87,91,"G4771"],[92,97,"G4102"],[98,101,"G2532"],[102,106,"G1680"],[107,110,"G1510"],[111,113,"G1519"],[114,117,"G2316"]]},{"book":"1PE","chapter":1,"verse":22,"text":"Since you have purified your souls by obedience to the truth so that you have a genuine love for your brothers, love one another deeply, from a pure heart.","strongs":[[0,23,"G48"],[24,28,"G4771"],[29,34,"G5590"],[35,37,"G1722"],[38,47,"G5218"],[48,54,"G3588"],[55,60,"G225"],[61,68,"G1519"],[69,110,"G5360"],[112,116,"G25"],[117,128,"G240"],[129,135,"G1619"],[137,141,"G1537"],[142,148,"G2513"],[149,154,"G2588"]]},{"book":"1PE","chapter":1,"verse":23,"text":"For you have been born again, not of perishable seed, but of imperishable, through the living and enduring word of God.","strongs":[[0,28,"G313"],[30,33,"G3756"],[34,36,"G1537"],[37,47,"G5349"],[48,52,"G4701"],[54,57,"G235"],[58,73,"G862"],[75,82,"G1223"],[83,93,"G2198"],[94,97,"G2532"],[98,106,"G3306"],[107,111,"G3056"],[112,118,"G2316"]]},{"book":"1PE","chapter":1,"verse":24,"text":"For, “All flesh is like grass, and all its glory like the flowers of the field; the grass withers and the flowers fall,","strongs":[[0,3,"G1360"],[6,9,"G3956"],[10,18,"G4561"],[19,23,"G5613"],[24,29,"G5528"],[31,34,"G2532"],[35,38,"G3956"],[39,42,"G846"],[43,48,"G1391"],[49,53,"G5613"],[54,65,"G438"],[66,78,"G5528"],[80,83,"G3588"],[84,89,"G5528"],[90,97,"G3583"],[98,101,"G2532"],[102,105,"G3588"],[106,113,"G438"],[114,118,"G1601"]]},{"book":"1PE","chapter":1,"verse":25,"text":"but the word of the Lord stands forever.” And this is the word that was proclaimed to you.","strongs":[[0,3,"G1161"],[4,7,"G3588"],[8,12,"G4487"],[13,24,"G2962"],[25,31,"G3306"],[32,39,"G165"],[42,45,"G1161"],[46,50,"G3778"],[51,53,"G1510"],[54,57,"G3588"],[58,62,"G4487"],[63,67,"G3588"],[68,82,"G2097"],[83,85,"G1519"],[86,89,"G4771"]]},{"book":"1PE","chapter":2,"verse":1,"text":"Rid yourselves, therefore, of all malice, deceit, hypocrisy, envy, and slander.","strongs":[[0,14,"G659"],[16,25,"G3767"],[27,33,"G3956"],[34,40,"G2549"],[42,48,"G1388"],[50,59,"G5272"],[61,65,"G5355"],[67,70,"G2532"],[71,78,"G2636"]]},{"book":"1PE","chapter":2,"verse":2,"text":"Like newborn babies, crave pure spiritual milk, so that by it you may grow up in your salvation,","strongs":[[0,4,"G5613"],[5,12,"G738"],[13,19,"G1025"],[21,26,"G1971"],[27,31,"G97"],[32,41,"G3050"],[42,46,"G1051"],[48,55,"G2443"],[56,58,"G1722"],[59,61,"G846"],[62,77,"G837"],[78,85,"G1519"],[86,95,"G4991"]]},{"book":"1PE","chapter":2,"verse":3,"text":"now that you have tasted that the Lord is good.","strongs":[[0,8,"G1487"],[9,24,"G1089"],[25,29,"G3754"],[30,33,"G3588"],[34,38,"G2962"],[39,46,"G5543"]]},{"book":"1PE","chapter":2,"verse":4,"text":"As you come to Him, the living stone, rejected by men but chosen and precious in God’s sight,","strongs":[[0,11,"G4334"],[12,14,"G4314"],[15,18,"G3739"],[20,30,"G2198"],[31,36,"G3037"],[38,46,"G593"],[47,49,"G5259"],[50,53,"G444"],[54,57,"G1161"],[58,64,"G1588"],[65,77,"G1784"],[78,86,"G2316"],[87,92,"G3844"]]},{"book":"1PE","chapter":2,"verse":5,"text":"you also, like living stones, are being built into a spiritual house to be a holy priesthood, offering spiritual sacrifices acceptable to God through Jesus Christ.","strongs":[[0,3,"G846"],[4,8,"G2532"],[10,14,"G5613"],[15,21,"G2198"],[22,28,"G3037"],[30,50,"G3618"],[51,62,"G4152"],[63,68,"G3624"],[69,74,"G1519"],[75,81,"G40"],[82,92,"G2406"],[94,102,"G399"],[103,112,"G4152"],[113,123,"G2378"],[124,134,"G2144"],[135,141,"G2316"],[142,149,"G1223"],[150,155,"G2424"],[156,162,"G5547"]]},{"book":"1PE","chapter":2,"verse":6,"text":"For it stands in Scripture: “See, I lay in Zion a stone, a chosen and precious cornerstone; and the one who believes in Him will never be put to shame.”","strongs":[[0,3,"G1360"],[4,13,"G4023"],[14,16,"G1722"],[17,26,"G1124"],[29,32,"G2400"],[34,39,"G5087"],[40,42,"G1722"],[43,47,"G4622"],[48,55,"G3037"],[57,65,"G1588"],[66,78,"G1784"],[79,90,"G204"],[92,95,"G2532"],[96,107,"G3588"],[108,116,"G4100"],[117,119,"G1909"],[120,123,"G846"],[124,150,"G2617"]]},{"book":"1PE","chapter":2,"verse":7,"text":"To you who believe, then, this stone is precious. But to those who do not believe, “The stone the builders rejected has become the cornerstone,”","strongs":[[0,6,"G4771"],[7,10,"G3588"],[11,18,"G4100"],[20,24,"G3767"],[26,36,"G3588"],[37,48,"G5092"],[50,53,"G1161"],[54,81,"G569"],[84,93,"G3037"],[94,97,"G3588"],[98,106,"G3618"],[107,115,"G593"],[116,126,"G1096"],[127,142,"G1137"]]},{"book":"1PE","chapter":2,"verse":8,"text":"and, “A stone of stumbling and a rock of offense.” They stumble because they disobey the word—and to this they were appointed.","strongs":[[0,3,"G2532"],[6,13,"G3037"],[14,26,"G4348"],[27,30,"G2532"],[31,37,"G4073"],[38,48,"G4625"],[51,55,"G3739"],[56,71,"G4350"],[72,84,"G544"],[85,88,"G3588"],[89,93,"G3056"],[94,97,"G2532"],[98,100,"G1519"],[101,105,"G3739"],[106,125,"G5087"]]},{"book":"1PE","chapter":2,"verse":9,"text":"But you are a chosen people, a royal priesthood, a holy nation, a people for God’s own possession, to proclaim the virtues of Him who called you out of darkness into His marvelous light.","strongs":[[0,3,"G1161"],[4,7,"G4771"],[8,20,"G1588"],[21,27,"G1085"],[29,36,"G934"],[37,47,"G2406"],[49,55,"G40"],[56,62,"G1484"],[64,72,"G2992"],[73,86,"G1519"],[87,97,"G4047"],[99,101,"G3704"],[102,110,"G1804"],[111,114,"G3588"],[115,122,"G703"],[123,133,"G3588"],[134,140,"G2564"],[141,144,"G4771"],[145,151,"G1537"],[152,160,"G4655"],[161,165,"G1519"],[166,169,"G846"],[170,179,"G2298"],[180,185,"G5457"]]},{"book":"1PE","chapter":2,"verse":10,"text":"Once you were not a people, but now you are the people of God; once you had not received mercy, but now you have received mercy.","strongs":[[0,4,"G4218"],[5,13,"G3739"],[14,17,"G3756"],[18,26,"G2992"],[28,31,"G1161"],[32,43,"G3568"],[44,54,"G2992"],[55,61,"G2316"],[63,71,"G3588"],[72,94,"G1653"],[96,99,"G1161"],[100,103,"G3568"],[104,127,"G1653"]]},{"book":"1PE","chapter":2,"verse":11,"text":"Beloved, I urge you, as foreigners and exiles, to abstain from the desires of the flesh, which war against your soul.","strongs":[[0,7,"G27"],[9,19,"G3870"],[21,23,"G5613"],[24,34,"G3941"],[35,38,"G2532"],[39,45,"G3927"],[47,57,"G568"],[58,62,"G3588"],[63,74,"G1939"],[75,87,"G4559"],[89,94,"G3748"],[95,98,"G4754"],[99,106,"G2596"],[107,111,"G3588"],[112,116,"G5590"]]},{"book":"1PE","chapter":2,"verse":12,"text":"Conduct yourselves with such honor among the Gentiles that, though they slander you as evildoers, they may see your good deeds and glorify God on the day He visits us.","strongs":[[0,7,"G2192"],[8,18,"G4771"],[19,34,"G2570"],[35,40,"G1722"],[41,44,"G3588"],[45,53,"G1484"],[54,58,"G2443"],[60,66,"G3739"],[67,79,"G2635"],[80,83,"G4771"],[84,86,"G5613"],[87,96,"G2555"],[98,110,"G2029"],[111,115,"G3588"],[116,120,"G2570"],[121,126,"G2041"],[127,138,"G1392"],[139,142,"G2316"],[143,145,"G1722"],[146,153,"G2250"],[154,166,"G1984"]]},{"book":"1PE","chapter":2,"verse":13,"text":"Submit yourselves for the Lord’s sake to every human institution, whether to the king as the supreme authority,","strongs":[[0,17,"G5293"],[18,25,"G3588"],[26,32,"G2962"],[33,37,"G1223"],[38,46,"G3956"],[47,52,"G442"],[53,64,"G2937"],[66,73,"G1535"],[74,85,"G935"],[86,88,"G5613"],[89,110,"G5242"]]},{"book":"1PE","chapter":2,"verse":14,"text":"or to governors as those sent by him to punish those who do wrong and to praise those who do right.","strongs":[[0,2,"G1535"],[3,15,"G2232"],[16,18,"G5613"],[19,29,"G3992"],[30,32,"G1223"],[33,36,"G846"],[37,39,"G1519"],[40,46,"G1557"],[47,65,"G2555"],[66,69,"G1161"],[70,79,"G1868"],[80,98,"G17"]]},{"book":"1PE","chapter":2,"verse":15,"text":"For it is God’s will that by doing good you should silence the ignorance of foolish men.","strongs":[[0,3,"G3754"],[4,9,"G1510"],[10,15,"G2316"],[16,20,"G2307"],[21,25,"G3779"],[26,39,"G15"],[40,58,"G5392"],[59,62,"G3588"],[63,72,"G56"],[73,83,"G878"],[84,87,"G444"]]},{"book":"1PE","chapter":2,"verse":16,"text":"Live in freedom, but do not use your freedom as a cover-up for evil; live as servants of God.","strongs":[[0,4,"G5613"],[5,15,"G1658"],[17,20,"G2532"],[21,31,"G2192"],[32,36,"G3588"],[37,44,"G1657"],[45,47,"G5613"],[48,58,"G1942"],[59,62,"G3588"],[63,67,"G2549"],[69,76,"G5613"],[77,85,"G1401"],[86,92,"G2316"]]},{"book":"1PE","chapter":2,"verse":17,"text":"Treat everyone with high regard: Love the brotherhood of believers, fear God, honor the king.","strongs":[[0,31,"G5091"],[33,37,"G25"],[38,41,"G3588"],[42,66,"G81"],[68,72,"G5399"],[73,76,"G2316"],[78,83,"G5091"],[84,87,"G3588"],[88,92,"G935"]]},{"book":"1PE","chapter":2,"verse":18,"text":"Servants, submit yourselves to your masters with all respect, not only to those who are good and gentle, but even to those who are unreasonable.","strongs":[[0,8,"G3610"],[10,27,"G5293"],[28,35,"G3588"],[36,43,"G1203"],[44,48,"G1722"],[49,52,"G3956"],[53,60,"G5401"],[62,65,"G3756"],[66,70,"G3440"],[71,87,"G3588"],[88,92,"G18"],[93,96,"G2532"],[97,103,"G1933"],[105,108,"G235"],[109,113,"G2532"],[114,130,"G3588"],[131,143,"G4646"]]},{"book":"1PE","chapter":2,"verse":19,"text":"For if anyone endures the pain of unjust suffering because he is conscious of God, this is to be commended.","strongs":[[0,3,"G1063"],[4,6,"G1487"],[7,13,"G5100"],[14,21,"G5297"],[22,30,"G3077"],[31,40,"G95"],[41,50,"G3958"],[51,58,"G1223"],[59,74,"G4893"],[75,81,"G2316"],[83,87,"G3778"],[88,106,"G5485"]]},{"book":"1PE","chapter":2,"verse":20,"text":"How is it to your credit if you are beaten for doing wrong and you endure it? But if you suffer for doing good and you endure it, this is commendable before God.","strongs":[[0,3,"G4169"],[4,24,"G2811"],[25,27,"G1487"],[28,42,"G2852"],[43,58,"G264"],[59,62,"G2532"],[63,76,"G5278"],[78,81,"G235"],[82,84,"G1487"],[85,95,"G3958"],[96,110,"G15"],[111,128,"G5278"],[130,137,"G3778"],[138,149,"G5485"],[150,156,"G3844"],[157,160,"G2316"]]},{"book":"1PE","chapter":2,"verse":21,"text":"For to this you were called, because Christ also suffered for you, leaving you an example, that you should follow in His footsteps:","strongs":[[0,3,"G1063"],[4,11,"G1519"],[12,27,"G2564"],[29,36,"G3754"],[37,43,"G5547"],[44,48,"G2532"],[49,57,"G3958"],[58,61,"G5228"],[62,65,"G4771"],[67,74,"G5277"],[75,78,"G4771"],[79,89,"G5261"],[91,95,"G2443"],[96,116,"G1872"],[117,120,"G846"],[121,130,"G2487"]]},{"book":"1PE","chapter":2,"verse":22,"text":"“He committed no sin, and no deceit was found in His mouth.”","strongs":[[1,3,"G3739"],[4,13,"G4160"],[14,16,"G3756"],[17,20,"G266"],[22,28,"G3761"],[29,35,"G1388"],[36,45,"G2147"],[46,48,"G1722"],[49,52,"G846"],[53,58,"G4750"]]},{"book":"1PE","chapter":2,"verse":23,"text":"When they heaped abuse on Him, He did not retaliate; when He suffered, He made no threats, but entrusted Himself to Him who judges justly.","strongs":[[0,29,"G3058"],[31,51,"G486"],[53,69,"G3958"],[71,89,"G546"],[91,94,"G1161"],[95,112,"G3860"],[113,123,"G3588"],[124,130,"G2919"],[131,137,"G1346"]]},{"book":"1PE","chapter":2,"verse":24,"text":"He Himself bore our sins in His body on the tree, so that we might die to sin and live to righteousness. “By His stripes you are healed.”","strongs":[[0,2,"G3739"],[3,10,"G846"],[11,15,"G399"],[16,19,"G1473"],[20,24,"G266"],[25,27,"G1722"],[28,31,"G846"],[32,36,"G4983"],[37,39,"G1909"],[40,43,"G3588"],[44,48,"G3586"],[50,57,"G2443"],[58,70,"G581"],[71,77,"G266"],[78,86,"G2198"],[87,103,"G1343"],[106,112,"G3739"],[113,120,"G3468"],[121,135,"G2390"]]},{"book":"1PE","chapter":2,"verse":25,"text":"For “you were like sheep going astray,” but now you have returned to the Shepherd and Overseer of your souls.","strongs":[[0,3,"G1063"],[5,13,"G1510"],[14,18,"G5613"],[19,24,"G4263"],[25,37,"G4105"],[40,43,"G235"],[44,47,"G3568"],[48,65,"G1994"],[66,68,"G1909"],[69,72,"G3588"],[73,81,"G4166"],[82,85,"G2532"],[86,94,"G1985"],[95,97,"G3588"],[98,102,"G4771"],[103,108,"G5590"]]},{"book":"1PE","chapter":3,"verse":1,"text":"Wives, in the same way, submit yourselves to your husbands, so that even if they refuse to believe the word, they will be won over without words by the behavior of their wives","strongs":[[0,5,"G1135"],[7,22,"G3668"],[24,41,"G5293"],[42,49,"G3588"],[50,58,"G435"],[60,67,"G2443"],[68,72,"G2532"],[73,75,"G1487"],[76,80,"G5100"],[81,98,"G544"],[99,102,"G3588"],[103,107,"G3056"],[109,130,"G2770"],[131,138,"G427"],[139,144,"G3056"],[145,147,"G1223"],[148,151,"G3588"],[152,160,"G391"],[161,169,"G3588"],[170,175,"G1135"]]},{"book":"1PE","chapter":3,"verse":2,"text":"when they see your pure and reverent demeanor.","strongs":[[0,13,"G2029"],[14,18,"G4771"],[19,23,"G53"],[24,36,"G5401"],[37,45,"G391"]]},{"book":"1PE","chapter":3,"verse":3,"text":"Your beauty should not come from outward adornment, such as braided hair or gold jewelry or fine clothes,","strongs":[[0,11,"G3739"],[12,22,"G3756"],[23,27,"G1510"],[28,32,"G3588"],[33,40,"G1855"],[41,50,"G2889"],[52,67,"G1708"],[68,72,"G2359"],[73,75,"G2532"],[76,88,"G5553"],[89,91,"G2228"],[92,104,"G2440"]]},{"book":"1PE","chapter":3,"verse":4,"text":"but from the inner disposition of your heart, the unfading beauty of a gentle and quiet spirit, which is precious in God’s sight.","strongs":[[0,3,"G235"],[4,12,"G3588"],[13,18,"G2927"],[19,30,"G444"],[31,38,"G3588"],[39,44,"G2588"],[46,49,"G3588"],[50,65,"G862"],[66,70,"G3588"],[71,77,"G4239"],[78,81,"G2532"],[82,87,"G2272"],[88,94,"G4151"],[96,101,"G3739"],[102,104,"G1510"],[105,113,"G4185"],[114,122,"G2316"],[123,128,"G1799"]]},{"book":"1PE","chapter":3,"verse":5,"text":"For this is how the holy women of the past adorned themselves. They put their hope in God and were submissive to their husbands,","strongs":[[0,3,"G1063"],[4,15,"G3779"],[16,19,"G3588"],[20,24,"G40"],[25,30,"G1135"],[31,42,"G4218"],[43,50,"G2885"],[51,61,"G1438"],[63,82,"G1679"],[83,85,"G1519"],[86,89,"G2316"],[90,109,"G5293"],[110,112,"G3588"],[113,118,"G2398"],[119,127,"G435"]]},{"book":"1PE","chapter":3,"verse":6,"text":"just as Sarah obeyed Abraham and called him lord. And you are her children if you do what is right and refuse to give way to fear.","strongs":[[0,7,"G5613"],[8,13,"G4564"],[14,20,"G5219"],[21,28,"G11"],[29,39,"G2564"],[40,43,"G846"],[44,48,"G2962"],[50,61,"G1096"],[62,65,"G3739"],[66,74,"G5043"],[75,98,"G15"],[99,102,"G2532"],[103,109,"G3361"],[110,121,"G5399"],[122,129,"G4423"]]},{"book":"1PE","chapter":3,"verse":7,"text":"Husbands, in the same way, treat your wives with consideration as a delicate vessel, and with honor as fellow heirs of the gracious gift of life, so that your prayers will not be hindered.","strongs":[[0,8,"G435"],[10,25,"G3668"],[27,32,"G4924"],[33,37,"G3588"],[38,43,"G1134"],[44,48,"G2596"],[49,62,"G1108"],[63,65,"G5613"],[66,76,"G772"],[77,83,"G4632"],[85,88,"G2532"],[89,99,"G5092"],[100,102,"G5613"],[103,115,"G4789"],[116,136,"G5485"],[137,144,"G2222"],[146,153,"G1519"],[154,158,"G4771"],[159,166,"G4335"],[167,187,"G1465"]]},{"book":"1PE","chapter":3,"verse":8,"text":"Finally, all of you, be like-minded and sympathetic, love as brothers, be tenderhearted and humble.","strongs":[[0,7,"G5056"],[9,19,"G3956"],[21,35,"G3675"],[36,51,"G4835"],[53,69,"G5361"],[71,87,"G2155"],[88,98,"G5012"]]},{"book":"1PE","chapter":3,"verse":9,"text":"Do not repay evil with evil or insult with insult, but with blessing, because to this you were called so that you may inherit a blessing.","strongs":[[0,12,"G591"],[13,17,"G2556"],[18,22,"G473"],[23,27,"G2556"],[28,30,"G2228"],[31,37,"G3059"],[38,42,"G473"],[43,49,"G3059"],[51,54,"G1161"],[55,68,"G2127"],[70,77,"G3754"],[78,80,"G1519"],[81,85,"G3778"],[86,101,"G2564"],[102,109,"G2443"],[110,125,"G2816"],[126,136,"G2129"]]},{"book":"1PE","chapter":3,"verse":10,"text":"For, “Whoever would love life and see good days must keep his tongue from evil and his lips from deceitful speech.","strongs":[[0,3,"G1063"],[6,13,"G3588"],[14,19,"G2309"],[20,24,"G25"],[25,29,"G2222"],[30,33,"G2532"],[34,37,"G3708"],[38,42,"G18"],[43,47,"G2250"],[48,57,"G3973"],[58,61,"G3588"],[62,68,"G1100"],[69,73,"G575"],[74,78,"G2556"],[79,82,"G2532"],[83,91,"G5491"],[92,96,"G3361"],[97,106,"G1388"],[107,113,"G2980"]]},{"book":"1PE","chapter":3,"verse":11,"text":"He must turn from evil and do good; he must seek peace and pursue it.","strongs":[[0,12,"G1578"],[13,17,"G575"],[18,22,"G2556"],[23,26,"G2532"],[27,29,"G4160"],[30,34,"G18"],[36,48,"G2212"],[49,54,"G1515"],[55,58,"G2532"],[59,65,"G1377"],[66,68,"G846"]]},{"book":"1PE","chapter":3,"verse":12,"text":"For the eyes of the Lord are on the righteous, and His ears are inclined to their prayer. But the face of the Lord is against those who do evil.”","strongs":[[0,3,"G3754"],[4,12,"G3788"],[13,24,"G2962"],[25,31,"G1909"],[32,45,"G1342"],[47,50,"G2532"],[51,54,"G846"],[55,59,"G3775"],[60,75,"G1519"],[76,81,"G846"],[82,88,"G1162"],[90,93,"G1161"],[94,102,"G4383"],[103,114,"G2962"],[115,125,"G1909"],[126,138,"G4160"],[139,143,"G2556"]]},{"book":"1PE","chapter":3,"verse":13,"text":"Who can harm you if you are zealous for what is good?","strongs":[[0,3,"G5101"],[4,12,"G2559"],[13,16,"G4771"],[17,19,"G1437"],[20,27,"G1096"],[28,35,"G2207"],[36,47,"G3588"],[48,52,"G18"]]},{"book":"1PE","chapter":3,"verse":14,"text":"But even if you should suffer for what is right, you are blessed. “Do not fear what they fear; do not be shaken.”","strongs":[[0,3,"G235"],[4,8,"G2532"],[9,11,"G1487"],[12,29,"G3958"],[30,33,"G1223"],[34,47,"G1343"],[49,64,"G3107"],[67,78,"G5399"],[79,83,"G846"],[84,93,"G5401"],[95,111,"G5015"]]},{"book":"1PE","chapter":3,"verse":15,"text":"But in your hearts sanctify Christ as Lord. Always be prepared to give a defense to everyone who asks you the reason for the hope that is in you. But respond with gentleness and respect,","strongs":[[0,3,"G1161"],[4,6,"G1722"],[7,11,"G4771"],[12,18,"G2588"],[19,27,"G37"],[28,34,"G5547"],[35,42,"G2962"],[44,50,"G104"],[51,62,"G2092"],[63,65,"G4314"],[66,80,"G627"],[81,92,"G3956"],[93,96,"G3588"],[97,101,"G154"],[102,105,"G4771"],[106,116,"G3056"],[117,120,"G4012"],[121,124,"G3588"],[125,129,"G1680"],[130,140,"G1722"],[141,144,"G4771"],[146,157,"G235"],[158,162,"G3326"],[163,173,"G4240"],[174,177,"G2532"],[178,185,"G5401"]]},{"book":"1PE","chapter":3,"verse":16,"text":"keeping a clear conscience, so that those who slander you may be put to shame by your good behavior in Christ.","strongs":[[0,7,"G2192"],[8,15,"G18"],[16,26,"G4893"],[28,35,"G2443"],[36,57,"G2635"],[58,77,"G2617"],[78,85,"G4771"],[86,90,"G18"],[91,99,"G391"],[100,102,"G1722"],[103,109,"G5547"]]},{"book":"1PE","chapter":3,"verse":17,"text":"For it is better, if it is God’s will, to suffer for doing good than for doing evil.","strongs":[[0,3,"G1063"],[4,16,"G2909"],[18,20,"G1487"],[21,26,"G2309"],[27,32,"G2316"],[33,37,"G2307"],[39,48,"G3958"],[49,63,"G15"],[64,68,"G2228"],[69,83,"G2554"]]},{"book":"1PE","chapter":3,"verse":18,"text":"For Christ also suffered for sins once for all, the righteous for the unrighteous, to bring you to God. He was put to death in the body but made alive in the Spirit,","strongs":[[0,3,"G3754"],[4,10,"G5547"],[11,15,"G2532"],[16,24,"G3958"],[25,28,"G4012"],[29,33,"G266"],[34,46,"G530"],[48,61,"G1342"],[62,65,"G5228"],[66,81,"G94"],[83,85,"G2443"],[86,91,"G4317"],[92,95,"G4771"],[96,102,"G2316"],[104,123,"G2289"],[124,135,"G4561"],[136,139,"G1161"],[140,150,"G2227"],[151,164,"G4151"]]},{"book":"1PE","chapter":3,"verse":19,"text":"in whom He also went and preached to the spirits in prison","strongs":[[0,2,"G1722"],[3,7,"G3739"],[8,20,"G4198"],[21,33,"G2784"],[34,40,"G3588"],[41,48,"G4151"],[49,51,"G1722"],[52,58,"G5438"]]},{"book":"1PE","chapter":3,"verse":20,"text":"who disobeyed long ago when God waited patiently in the days of Noah while the ark was being built. In the ark a few people, only eight souls, were saved through water.","strongs":[[0,13,"G544"],[14,22,"G4218"],[23,27,"G3753"],[28,31,"G2316"],[32,38,"G553"],[39,48,"G3115"],[49,51,"G1722"],[52,60,"G2250"],[61,68,"G3575"],[69,82,"G2787"],[83,98,"G2680"],[100,102,"G1519"],[103,110,"G3739"],[111,123,"G3641"],[125,129,"G3778"],[130,135,"G3638"],[136,141,"G5590"],[143,153,"G1295"],[154,161,"G1223"],[162,167,"G5204"]]},{"book":"1PE","chapter":3,"verse":21,"text":"And this water symbolizes the baptism that now saves you also—not the removal of dirt from the body, but the pledge of a clear conscience toward God—through the resurrection of Jesus Christ,","strongs":[[0,3,"G2532"],[4,14,"G3739"],[15,25,"G499"],[26,37,"G908"],[38,46,"G3568"],[47,52,"G4982"],[53,61,"G4771"],[62,65,"G3756"],[66,77,"G595"],[78,85,"G4509"],[86,99,"G4561"],[101,104,"G235"],[105,118,"G1906"],[119,126,"G18"],[127,137,"G4893"],[138,144,"G1519"],[145,148,"G2316"],[149,156,"G1223"],[157,173,"G386"],[174,182,"G2424"],[183,189,"G5547"]]},{"book":"1PE","chapter":3,"verse":22,"text":"who has gone into heaven and is at the right hand of God, with angels, authorities, and powers subject to Him.","strongs":[[0,3,"G3739"],[4,12,"G4198"],[13,17,"G1519"],[18,24,"G3772"],[25,31,"G1510"],[32,34,"G1722"],[35,49,"G1188"],[50,56,"G2316"],[58,69,"G32"],[71,82,"G1849"],[84,87,"G2532"],[88,94,"G1411"],[95,102,"G5293"],[103,109,"G846"]]},{"book":"1PE","chapter":4,"verse":1,"text":"Therefore, since Christ suffered in His body, arm yourselves with the same resolve, because anyone who has suffered in his body is done with sin.","strongs":[[0,16,"G3767"],[17,23,"G5547"],[24,32,"G3958"],[33,44,"G4561"],[46,65,"G3695"],[66,69,"G3588"],[70,74,"G846"],[75,82,"G1771"],[84,91,"G3754"],[92,102,"G3588"],[103,115,"G3958"],[116,127,"G4561"],[128,140,"G3973"],[141,144,"G266"]]},{"book":"1PE","chapter":4,"verse":2,"text":"Consequently, he does not live out his remaining time on earth for human passions, but for the will of God.","strongs":[[0,12,"G1519"],[14,34,"G980"],[35,38,"G3588"],[39,48,"G1954"],[49,53,"G5550"],[54,62,"G4561"],[63,72,"G444"],[73,81,"G1939"],[83,86,"G235"],[87,99,"G2307"],[100,106,"G2316"]]},{"book":"1PE","chapter":4,"verse":3,"text":"For you have spent enough time in the past carrying out the same desires as the Gentiles: living in debauchery, lust, drunkenness, orgies, carousing, and detestable idolatry.","strongs":[[0,3,"G1063"],[4,25,"G713"],[26,30,"G5550"],[31,42,"G3928"],[43,55,"G2716"],[56,64,"G3588"],[65,72,"G1013"],[73,79,"G3588"],[80,88,"G1484"],[90,96,"G4198"],[97,99,"G1722"],[100,110,"G766"],[112,116,"G1939"],[118,129,"G3632"],[131,137,"G2970"],[139,148,"G4224"],[150,153,"G2532"],[154,164,"G111"],[165,173,"G1495"]]},{"book":"1PE","chapter":4,"verse":4,"text":"Because of this, they consider it strange of you not to plunge with them into the same flood of reckless indiscretion, and they heap abuse on you.","strongs":[[0,10,"G1722"],[11,15,"G3739"],[17,41,"G3579"],[42,48,"G4771"],[49,52,"G3361"],[53,72,"G4936"],[73,77,"G1519"],[78,81,"G3588"],[82,86,"G846"],[87,92,"G401"],[93,117,"G810"],[119,145,"G987"]]},{"book":"1PE","chapter":4,"verse":5,"text":"But they will have to give an account to Him who is ready to judge the living and the dead.","strongs":[[0,8,"G3739"],[9,26,"G591"],[27,37,"G3056"],[38,48,"G3588"],[49,51,"G2192"],[52,57,"G2093"],[58,66,"G2919"],[67,77,"G2198"],[78,81,"G2532"],[82,90,"G3498"]]},{"book":"1PE","chapter":4,"verse":6,"text":"That is why the gospel was preached even to those who are now dead, so that they might be judged as men in the flesh, but live according to God in the spirit.","strongs":[[0,11,"G3778"],[12,35,"G2097"],[36,40,"G2532"],[41,66,"G3498"],[68,75,"G2443"],[76,96,"G2919"],[97,99,"G2596"],[100,103,"G444"],[104,116,"G4561"],[118,121,"G1161"],[122,126,"G2198"],[127,139,"G2596"],[140,143,"G2316"],[144,157,"G4151"]]},{"book":"1PE","chapter":4,"verse":7,"text":"The end of all things is near. Therefore be clear-minded and sober, so that you can pray.","strongs":[[0,3,"G3588"],[4,7,"G5056"],[8,21,"G3956"],[22,29,"G1448"],[31,40,"G3767"],[41,56,"G4993"],[57,60,"G2532"],[61,66,"G3525"],[68,75,"G1519"],[76,88,"G4335"]]},{"book":"1PE","chapter":4,"verse":8,"text":"Above all, love one another deeply, because love covers over a multitude of sins.","strongs":[[0,5,"G4253"],[6,9,"G3956"],[11,15,"G26"],[16,27,"G1438"],[28,34,"G1618"],[36,43,"G3754"],[44,48,"G26"],[49,60,"G2572"],[61,72,"G4128"],[73,80,"G266"]]},{"book":"1PE","chapter":4,"verse":9,"text":"Show hospitality to one another without complaining.","strongs":[[0,16,"G5382"],[17,19,"G1519"],[20,31,"G240"],[32,39,"G427"],[40,51,"G1112"]]},{"book":"1PE","chapter":4,"verse":10,"text":"As good stewards of the manifold grace of God, each of you should use whatever gift he has received to serve one another.","strongs":[[0,2,"G5613"],[3,7,"G2570"],[8,16,"G3623"],[17,32,"G4164"],[33,38,"G5485"],[39,45,"G2316"],[47,58,"G1538"],[59,69,"G1519"],[70,78,"G846"],[79,83,"G5486"],[84,99,"G2983"],[100,108,"G1247"],[109,120,"G1438"]]},{"book":"1PE","chapter":4,"verse":11,"text":"If anyone speaks, he should speak as one conveying the words of God. If anyone serves, he should serve with the strength God provides, so that in all things God may be glorified through Jesus Christ, to whom be the glory and the power forever and ever. Amen.","strongs":[[0,2,"G1487"],[3,9,"G5100"],[10,16,"G2980"],[18,36,"G5613"],[37,67,"G3051"],[69,71,"G1487"],[72,78,"G5100"],[79,85,"G1247"],[87,102,"G5613"],[103,107,"G1537"],[108,120,"G2479"],[121,124,"G2316"],[125,133,"G5524"],[135,142,"G2443"],[143,145,"G1722"],[146,156,"G3956"],[157,160,"G2316"],[161,177,"G1392"],[178,185,"G1223"],[186,191,"G2424"],[192,198,"G5547"],[200,207,"G3739"],[208,210,"G1510"],[211,214,"G3588"],[215,220,"G1391"],[221,224,"G2532"],[225,228,"G3588"],[229,234,"G2904"],[235,242,"G165"],[243,246,"G3588"],[247,251,"G165"],[253,257,"G281"]]},{"book":"1PE","chapter":4,"verse":12,"text":"Beloved, do not be surprised at the fiery trial that has come upon you, as though something strange were happening to you.","strongs":[[0,7,"G27"],[9,15,"G3361"],[16,31,"G3579"],[32,35,"G3588"],[36,41,"G4451"],[42,47,"G3986"],[48,61,"G1096"],[62,66,"G1722"],[67,70,"G4771"],[72,81,"G5613"],[82,99,"G3581"],[100,114,"G4819"],[115,121,"G4771"]]},{"book":"1PE","chapter":4,"verse":13,"text":"But rejoice that you share in the sufferings of Christ, so that you may be overjoyed at the revelation of His glory.","strongs":[[0,3,"G235"],[4,11,"G5463"],[12,16,"G2526"],[17,26,"G2841"],[27,33,"G3588"],[34,44,"G3804"],[45,54,"G5547"],[56,63,"G2443"],[64,84,"G5463"],[85,87,"G1722"],[88,91,"G3588"],[92,102,"G602"],[103,105,"G3588"],[106,109,"G846"],[110,115,"G1391"]]},{"book":"1PE","chapter":4,"verse":14,"text":"If you are insulted for the name of Christ, you are blessed, because the Spirit of glory and of God rests on you.","strongs":[[0,2,"G1487"],[3,19,"G3679"],[20,23,"G1722"],[24,32,"G3686"],[33,42,"G5547"],[44,59,"G3107"],[61,68,"G3754"],[69,72,"G3588"],[73,79,"G4151"],[80,88,"G1391"],[89,92,"G2532"],[93,99,"G2316"],[100,105,"G373"],[106,108,"G1909"],[109,112,"G4771"]]},{"book":"1PE","chapter":4,"verse":15,"text":"Indeed, none of you should suffer as a murderer or thief or wrongdoer, or even as a meddler.","strongs":[[0,6,"G1063"],[8,12,"G5100"],[13,19,"G4771"],[20,33,"G3958"],[34,36,"G5613"],[37,47,"G5406"],[48,50,"G2228"],[51,56,"G2812"],[57,59,"G2228"],[60,69,"G2555"],[71,73,"G2228"],[74,81,"G5613"],[82,91,"G244"]]},{"book":"1PE","chapter":4,"verse":16,"text":"But if you suffer as a Christian, do not be ashamed, but glorify God that you bear that name.","strongs":[[0,3,"G1161"],[4,17,"G1487"],[18,20,"G5613"],[21,32,"G5546"],[34,51,"G153"],[53,56,"G1161"],[57,64,"G1392"],[65,68,"G2316"],[69,82,"G1722"],[83,87,"G3778"],[88,92,"G3686"]]},{"book":"1PE","chapter":4,"verse":17,"text":"For it is time for judgment to begin with the family of God; and if it begins with us, what will the outcome be for those who disobey the gospel of God?","strongs":[[0,9,"G3754"],[10,18,"G2540"],[19,27,"G2917"],[28,36,"G756"],[37,41,"G575"],[42,45,"G3588"],[46,52,"G3624"],[53,59,"G2316"],[61,64,"G1161"],[65,67,"G1487"],[68,77,"G4412"],[78,82,"G575"],[83,85,"G1473"],[87,96,"G5101"],[97,100,"G3588"],[101,111,"G5056"],[112,125,"G3588"],[126,133,"G544"],[134,137,"G3588"],[138,144,"G2098"],[145,151,"G2316"]]},{"book":"1PE","chapter":4,"verse":18,"text":"And, “If it is hard for the righteous to be saved, what will become of the ungodly and the sinner?”","strongs":[[0,3,"G2532"],[6,8,"G1487"],[9,23,"G3433"],[24,27,"G3588"],[28,37,"G1342"],[38,49,"G4982"],[51,55,"G4226"],[56,70,"G5316"],[71,74,"G3588"],[75,82,"G765"],[83,86,"G2532"],[87,97,"G268"]]},{"book":"1PE","chapter":4,"verse":19,"text":"So then, those who suffer according to God’s will should entrust their souls to their faithful Creator and continue to do good.","strongs":[[0,7,"G5620"],[9,18,"G3588"],[19,25,"G3958"],[26,38,"G2596"],[39,44,"G2316"],[45,49,"G2307"],[50,64,"G3908"],[65,70,"G846"],[71,76,"G5590"],[77,94,"G4103"],[95,102,"G2939"],[103,115,"G1722"],[116,126,"G16"]]},{"book":"1PE","chapter":5,"verse":1,"text":"As a fellow elder, a witness of Christ’s sufferings, and a partaker of the glory to be revealed, I appeal to the elders among you:","strongs":[[0,2,"G3588"],[3,17,"G4850"],[19,28,"G3144"],[29,31,"G3588"],[32,40,"G5547"],[41,51,"G3804"],[53,56,"G2532"],[57,67,"G2844"],[68,74,"G3588"],[75,80,"G1391"],[81,95,"G601"],[97,108,"G3870"],[109,119,"G4245"],[120,125,"G1722"],[126,129,"G4771"]]},{"book":"1PE","chapter":5,"verse":2,"text":"Be shepherds of God’s flock that is among you, watching over them not out of compulsion, but willingly, as God would have you; not out of greed, but out of eagerness;","strongs":[[0,12,"G4165"],[13,21,"G2316"],[22,27,"G4168"],[28,41,"G1722"],[42,45,"G4771"],[47,65,"G1983"],[66,69,"G3361"],[70,87,"G317"],[89,92,"G235"],[93,102,"G1596"],[104,110,"G2316"],[111,125,"G2596"],[127,130,"G3366"],[131,143,"G147"],[145,148,"G235"],[149,165,"G4290"]]},{"book":"1PE","chapter":5,"verse":3,"text":"not lording it over those entrusted to you, but being examples to the flock.","strongs":[[0,3,"G3366"],[4,19,"G2634"],[20,42,"G2819"],[44,47,"G235"],[48,53,"G1096"],[54,62,"G5179"],[63,69,"G3588"],[70,75,"G4168"]]},{"book":"1PE","chapter":5,"verse":4,"text":"And when the Chief Shepherd appears, you will receive the crown of glory that will never fade away.","strongs":[[0,8,"G2532"],[9,12,"G3588"],[13,27,"G750"],[28,35,"G5319"],[37,53,"G2865"],[54,57,"G3588"],[58,63,"G4735"],[64,72,"G1391"],[73,98,"G262"]]},{"book":"1PE","chapter":5,"verse":5,"text":"Young men, in the same way, submit yourselves to your elders. And all of you, clothe yourselves with humility toward one another, because, “God opposes the proud, but gives grace to the humble.”","strongs":[[0,9,"G3501"],[11,26,"G3668"],[28,45,"G5293"],[46,60,"G4245"],[62,65,"G1161"],[66,76,"G3956"],[78,95,"G1463"],[96,109,"G5012"],[110,128,"G240"],[130,137,"G3754"],[140,143,"G2316"],[144,151,"G498"],[152,161,"G5244"],[163,166,"G1161"],[167,172,"G1325"],[173,178,"G5485"],[179,192,"G5011"]]},{"book":"1PE","chapter":5,"verse":6,"text":"Humble yourselves, therefore, under God’s mighty hand, so that in due time He may exalt you.","strongs":[[0,17,"G5013"],[19,28,"G3767"],[30,35,"G5259"],[36,41,"G2316"],[42,48,"G2900"],[49,53,"G5495"],[55,62,"G2443"],[63,65,"G1722"],[66,74,"G2540"],[75,87,"G5312"],[88,91,"G4771"]]},{"book":"1PE","chapter":5,"verse":7,"text":"Cast all your anxiety on Him, because He cares for you.","strongs":[[0,4,"G1977"],[5,8,"G3956"],[9,13,"G4771"],[14,21,"G3308"],[22,24,"G1909"],[25,28,"G846"],[30,37,"G3754"],[38,40,"G846"],[41,46,"G3199"],[47,50,"G4012"],[51,54,"G4771"]]},{"book":"1PE","chapter":5,"verse":8,"text":"Be sober-minded and alert. Your adversary the devil prowls around like a roaring lion, seeking someone to devour.","strongs":[[0,15,"G3525"],[16,25,"G1127"],[27,31,"G4771"],[32,41,"G476"],[42,45,"G3588"],[46,51,"G1228"],[52,65,"G4043"],[66,70,"G5613"],[71,80,"G5612"],[81,85,"G3023"],[87,94,"G2212"],[95,102,"G5101"],[103,112,"G2666"]]},{"book":"1PE","chapter":5,"verse":9,"text":"Resist him, standing firm in your faith and in the knowledge that your brothers throughout the world are undergoing the same kinds of suffering.","strongs":[[0,6,"G436"],[7,10,"G3739"],[12,25,"G4731"],[26,33,"G3588"],[34,39,"G4102"],[40,65,"G1492"],[66,70,"G4771"],[71,79,"G81"],[80,90,"G1722"],[91,94,"G3588"],[95,100,"G2889"],[101,115,"G2005"],[116,119,"G3588"],[120,130,"G846"],[131,133,"G3588"],[134,143,"G3804"]]},{"book":"1PE","chapter":5,"verse":10,"text":"And after you have suffered for a little while, the God of all grace, who has called you to His eternal glory in Christ, will Himself restore you, secure you, strengthen you, and establish you.","strongs":[[0,3,"G1161"],[4,27,"G3958"],[28,46,"G3641"],[48,51,"G3588"],[52,55,"G2316"],[56,62,"G3956"],[63,68,"G5485"],[70,73,"G3588"],[74,84,"G2564"],[85,88,"G4771"],[89,91,"G1519"],[92,95,"G846"],[96,103,"G166"],[104,109,"G1391"],[110,112,"G1722"],[113,119,"G5547"],[121,133,"G846"],[134,145,"G2675"],[147,157,"G4741"],[159,173,"G4599"],[175,192,"G2311"]]},{"book":"1PE","chapter":5,"verse":11,"text":"To Him be the power forever and ever. Amen.","strongs":[[0,9,"G846"],[10,13,"G3588"],[14,19,"G2904"],[20,27,"G165"],[28,31,"G3588"],[32,36,"G165"],[38,42,"G281"]]},{"book":"1PE","chapter":5,"verse":12,"text":"Through Silvanus, whom I regard as a faithful brother, I have written to you briefly, encouraging you and testifying that this is the true grace of God. Stand firm in it.","strongs":[[0,7,"G1223"],[8,16,"G4610"],[18,31,"G3049"],[32,34,"G5613"],[35,36,"G3588"],[37,45,"G4103"],[46,53,"G80"],[55,69,"G1125"],[70,76,"G4771"],[77,84,"G3641"],[86,101,"G3870"],[102,105,"G2532"],[106,116,"G1957"],[117,126,"G3778"],[127,129,"G1510"],[130,138,"G227"],[139,144,"G5485"],[145,151,"G2316"],[153,163,"G2476"],[164,166,"G1519"],[167,169,"G3739"]]},{"book":"1PE","chapter":5,"verse":13,"text":"The church in Babylon, chosen together with you, sends you greetings, as does my son Mark.","strongs":[[0,10,"G3588"],[11,13,"G1722"],[14,21,"G897"],[23,47,"G4899"],[49,68,"G782"],[70,77,"G2532"],[78,80,"G1473"],[81,84,"G5207"],[85,89,"G3138"]]},{"book":"1PE","chapter":5,"verse":14,"text":"Greet one another with a kiss of love. Peace to all of you who are in Christ.","strongs":[[0,5,"G782"],[6,17,"G240"],[18,22,"G1722"],[23,29,"G5370"],[30,37,"G26"],[39,44,"G1515"],[45,51,"G3956"],[52,58,"G4771"],[59,66,"G3588"],[67,69,"G1722"],[70,76,"G5547"]]}]}