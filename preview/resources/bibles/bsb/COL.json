{"id":"COL","name":"Colossians","testament":"NT","chapters":4,"verses":[{"book":"COL","chapter":1,"verse":1,"text":"Paul, an apostle of Christ Jesus by the will of God, and Timothy our brother,","strongs":[[0,4,"G3972"],[6,16,"G652"],[17,26,"G5547"],[27,32,"G2424"],[33,35,"G1223"],[36,44,"G2307"],[45,51,"G2316"],[53,56,"G2532"],[57,64,"G5095"],[65,68,"G3588"],[69,76,"G80"]]},{"book":"COL","chapter":1,"verse":2,"text":"To the saints and faithful brothers in Christ at Colossae: Grace and peace to you from God our Father.","strongs":[[0,6,"G3588"],[7,13,"G40"],[14,17,"G2532"],[18,26,"G4103"],[27,35,"G80"],[36,38,"G1722"],[39,45,"G5547"],[46,48,"G1722"],[49,57,"G2857"],[59,64,"G5485"],[65,68,"G2532"],[69,74,"G1515"],[75,81,"G4771"],[82,86,"G575"],[87,90,"G2316"],[91,94,"G1473"],[95,101,"G3962"]]},{"book":"COL","chapter":1,"verse":3,"text":"We always thank God, the Father of our Lord Jesus Christ, when we pray for you,","strongs":[[0,15,"G2168"],[16,19,"G2316"],[21,31,"G3962"],[32,38,"G1473"],[39,43,"G2962"],[44,49,"G2424"],[50,56,"G5547"],[58,70,"G4336"],[71,74,"G4012"],[75,78,"G4771"]]},{"book":"COL","chapter":1,"verse":4,"text":"because we have heard about your faith in Christ Jesus and your love for all the saints—","strongs":[[0,27,"G191"],[28,32,"G4771"],[33,38,"G4102"],[39,41,"G1722"],[42,48,"G5547"],[49,54,"G2424"],[55,58,"G2532"],[59,63,"G2192"],[64,68,"G26"],[69,72,"G1519"],[73,76,"G3956"],[77,80,"G3588"],[81,87,"G40"]]},{"book":"COL","chapter":1,"verse":5,"text":"the faith and love proceeding from the hope stored up for you in heaven, of which you have already heard in the word of truth, the gospel","strongs":[[0,34,"G1223"],[35,38,"G3588"],[39,43,"G1680"],[44,53,"G606"],[54,61,"G4771"],[62,64,"G1722"],[65,71,"G3772"],[73,81,"G3739"],[82,104,"G4257"],[105,107,"G1722"],[108,111,"G3588"],[112,116,"G3056"],[117,125,"G225"],[127,130,"G3588"],[131,137,"G2098"]]},{"book":"COL","chapter":1,"verse":6,"text":"that has come to you. All over the world this gospel is bearing fruit and growing, just as it has been doing among you since the day you heard it and truly understood the grace of God.","strongs":[[0,4,"G3588"],[5,13,"G3918"],[14,16,"G1519"],[17,20,"G4771"],[22,25,"G3956"],[26,30,"G1722"],[31,34,"G3588"],[35,40,"G2889"],[41,55,"G1510"],[56,69,"G2592"],[70,73,"G2532"],[74,81,"G837"],[83,90,"G2531"],[91,108,"G2532"],[109,114,"G1722"],[115,118,"G4771"],[119,124,"G575"],[125,128,"G3739"],[129,132,"G2250"],[133,145,"G191"],[146,149,"G2532"],[150,155,"G225"],[156,166,"G1921"],[167,170,"G3588"],[171,176,"G5485"],[177,183,"G2316"]]},{"book":"COL","chapter":1,"verse":7,"text":"You learned it from Epaphras, our beloved fellow servant, who is a faithful minister of Christ on our behalf,","strongs":[[0,14,"G3129"],[15,19,"G575"],[20,28,"G1889"],[30,33,"G1473"],[34,41,"G27"],[42,56,"G4889"],[58,61,"G3739"],[62,64,"G1510"],[65,75,"G4103"],[76,84,"G1249"],[85,94,"G5547"],[95,101,"G1473"],[102,108,"G5228"]]},{"book":"COL","chapter":1,"verse":8,"text":"and who also informed us of your love in the Spirit.","strongs":[[0,7,"G3588"],[8,12,"G2532"],[13,21,"G1213"],[22,24,"G1473"],[25,32,"G4771"],[33,37,"G26"],[38,40,"G1722"],[41,51,"G4151"]]},{"book":"COL","chapter":1,"verse":9,"text":"For this reason, since the day we heard about you, we have not stopped praying for you and asking God to fill you with the knowledge of His will in all spiritual wisdom and understanding,","strongs":[[0,15,"G1223"],[17,22,"G575"],[23,26,"G3739"],[27,30,"G2250"],[31,49,"G191"],[51,53,"G1473"],[54,62,"G3756"],[63,70,"G3973"],[71,78,"G4336"],[79,82,"G5228"],[83,86,"G4771"],[87,90,"G2532"],[91,97,"G154"],[98,104,"G2443"],[105,118,"G4137"],[119,122,"G3588"],[123,132,"G1922"],[133,135,"G3588"],[136,139,"G846"],[140,144,"G2307"],[145,147,"G1722"],[148,151,"G3956"],[152,161,"G4152"],[162,168,"G4678"],[169,172,"G2532"],[173,186,"G4907"]]},{"book":"COL","chapter":1,"verse":10,"text":"so that you may walk in a manner worthy of the Lord and may please Him in every way: bearing fruit in every good work, growing in the knowledge of God,","strongs":[[0,20,"G4043"],[21,39,"G516"],[40,46,"G3588"],[47,51,"G2962"],[52,70,"G699"],[71,73,"G1519"],[74,83,"G3956"],[85,98,"G2592"],[99,101,"G1722"],[102,107,"G3956"],[108,112,"G18"],[113,117,"G2041"],[119,126,"G837"],[127,133,"G3588"],[134,143,"G1922"],[144,150,"G2316"]]},{"book":"COL","chapter":1,"verse":11,"text":"being strengthened with all power according to His glorious might so that you may have full endurance and patience, and joyfully","strongs":[[0,18,"G1412"],[19,23,"G1722"],[24,27,"G3956"],[28,33,"G1411"],[34,46,"G2596"],[47,50,"G846"],[51,59,"G1391"],[60,65,"G2904"],[66,86,"G1519"],[87,91,"G3956"],[92,101,"G5281"],[102,105,"G2532"],[106,114,"G3115"],[116,128,"G3326"]]},{"book":"COL","chapter":1,"verse":12,"text":"giving thanks to the Father, who has qualified you to share in the inheritance of the saints in the light.","strongs":[[0,13,"G2168"],[14,20,"G3588"],[21,27,"G3962"],[29,32,"G3588"],[33,46,"G2427"],[47,50,"G4771"],[51,59,"G3310"],[60,66,"G3588"],[67,78,"G2819"],[79,85,"G3588"],[86,92,"G40"],[93,95,"G1722"],[96,99,"G3588"],[100,105,"G5457"]]},{"book":"COL","chapter":1,"verse":13,"text":"He has rescued us from the dominion of darkness and brought us into the kingdom of His beloved Son,","strongs":[[0,2,"G3739"],[3,14,"G4506"],[15,17,"G1473"],[18,22,"G1537"],[23,26,"G3588"],[27,35,"G1849"],[36,47,"G4655"],[48,51,"G2532"],[52,62,"G3179"],[63,67,"G1519"],[68,71,"G3588"],[72,79,"G932"],[80,82,"G3588"],[83,86,"G846"],[87,94,"G26"],[95,98,"G5207"]]},{"book":"COL","chapter":1,"verse":14,"text":"in whom we have redemption, the forgiveness of sins.","strongs":[[0,2,"G1722"],[3,7,"G3739"],[8,15,"G2192"],[16,26,"G629"],[28,31,"G3588"],[32,43,"G859"],[44,51,"G266"]]},{"book":"COL","chapter":1,"verse":15,"text":"The Son is the image of the invisible God, the firstborn over all creation.","strongs":[[0,7,"G3739"],[8,10,"G1510"],[11,20,"G1504"],[21,27,"G3588"],[28,37,"G517"],[38,41,"G2316"],[43,56,"G4416"],[57,65,"G3956"],[66,74,"G2937"]]},{"book":"COL","chapter":1,"verse":16,"text":"For in Him all things were created, things in heaven and on earth, visible and invisible, whether thrones or dominions or rulers or authorities. All things were created through Him and for Him.","strongs":[[0,3,"G3754"],[4,6,"G1722"],[7,10,"G846"],[11,21,"G3956"],[22,34,"G2936"],[36,45,"G1722"],[46,52,"G3772"],[53,56,"G2532"],[57,59,"G1909"],[60,65,"G1093"],[67,74,"G3707"],[75,78,"G2532"],[79,88,"G517"],[90,97,"G1535"],[98,105,"G2362"],[106,108,"G1535"],[109,118,"G2963"],[119,121,"G1535"],[122,128,"G746"],[129,131,"G1535"],[132,143,"G1849"],[145,155,"G3956"],[156,168,"G2936"],[169,176,"G1223"],[177,180,"G846"],[181,184,"G2532"],[185,188,"G1519"],[189,192,"G846"]]},{"book":"COL","chapter":1,"verse":17,"text":"He is before all things, and in Him all things hold together.","strongs":[[0,2,"G846"],[3,5,"G1510"],[6,12,"G4253"],[13,23,"G3956"],[25,28,"G2532"],[29,31,"G1722"],[32,35,"G846"],[36,46,"G3956"],[47,60,"G4921"]]},{"book":"COL","chapter":1,"verse":18,"text":"And He is the head of the body, the church; He is the beginning and firstborn from among the dead, so that in all things He may have preeminence.","strongs":[[0,3,"G2532"],[4,6,"G846"],[7,9,"G1510"],[10,13,"G3588"],[14,18,"G2776"],[19,25,"G3588"],[26,30,"G4983"],[32,35,"G3588"],[36,42,"G1577"],[44,46,"G3739"],[47,49,"G1510"],[50,53,"G3588"],[54,63,"G746"],[64,77,"G4416"],[78,88,"G1537"],[89,92,"G3588"],[93,97,"G3498"],[99,106,"G2443"],[107,109,"G1722"],[110,120,"G3956"],[121,123,"G846"],[124,127,"G1096"],[128,144,"G4409"]]},{"book":"COL","chapter":1,"verse":19,"text":"For God was pleased to have all His fullness dwell in Him,","strongs":[[0,3,"G3754"],[4,27,"G2106"],[28,31,"G3956"],[32,35,"G3588"],[36,44,"G4138"],[45,50,"G2730"],[51,53,"G1722"],[54,57,"G846"]]},{"book":"COL","chapter":1,"verse":20,"text":"and through Him to reconcile to Himself all things, whether things on earth or things in heaven, by making peace through the blood of His cross.","strongs":[[0,3,"G2532"],[4,11,"G1223"],[12,15,"G846"],[16,28,"G604"],[29,31,"G1519"],[32,39,"G846"],[40,50,"G3956"],[52,59,"G1535"],[60,66,"G3588"],[67,69,"G1909"],[70,75,"G1093"],[76,78,"G1535"],[79,85,"G3588"],[86,88,"G1722"],[89,95,"G3772"],[97,112,"G1517"],[113,120,"G1223"],[121,124,"G3588"],[125,130,"G129"],[131,133,"G3588"],[134,137,"G846"],[138,143,"G4716"]]},{"book":"COL","chapter":1,"verse":21,"text":"Once you were alienated from God and were hostile in your minds, engaging in evil deeds.","strongs":[[0,4,"G4218"],[5,8,"G4771"],[9,13,"G1510"],[14,32,"G526"],[33,36,"G2532"],[37,49,"G2190"],[50,52,"G3588"],[53,63,"G1271"],[65,76,"G1722"],[77,81,"G4190"],[82,87,"G2041"]]},{"book":"COL","chapter":1,"verse":22,"text":"But now He has reconciled you by Christ’s physical body through death to present you holy, unblemished, and blameless in His presence—","strongs":[[0,3,"G1161"],[4,7,"G3570"],[8,29,"G604"],[30,32,"G1722"],[33,41,"G846"],[42,50,"G4561"],[51,55,"G4983"],[56,63,"G1223"],[64,69,"G2288"],[70,80,"G3936"],[81,84,"G4771"],[85,89,"G40"],[91,102,"G299"],[104,107,"G2532"],[108,117,"G410"],[118,133,"G2714"]]},{"book":"COL","chapter":1,"verse":23,"text":"if indeed you continue in your faith, established and firm, not moved from the hope of the gospel you heard, which has been proclaimed to every creature under heaven, and of which I, Paul, have become a servant.","strongs":[[0,2,"G1487"],[3,9,"G1065"],[10,22,"G1961"],[23,36,"G4102"],[38,49,"G2311"],[50,53,"G2532"],[54,58,"G1476"],[60,63,"G3361"],[64,69,"G3334"],[70,74,"G575"],[75,78,"G3588"],[79,83,"G1680"],[84,90,"G3588"],[91,97,"G2098"],[98,107,"G191"],[109,114,"G3588"],[115,134,"G2784"],[135,137,"G1722"],[138,143,"G3956"],[144,152,"G2937"],[153,158,"G5259"],[159,165,"G3772"],[167,179,"G3739"],[180,181,"G1473"],[183,187,"G3972"],[189,200,"G1096"],[201,210,"G1249"]]},{"book":"COL","chapter":1,"verse":24,"text":"Now I rejoice in my sufferings for you, and I fill up in my flesh what is lacking in regard to Christ’s afflictions for the sake of His body, which is the church.","strongs":[[0,3,"G3568"],[4,13,"G5463"],[14,16,"G1722"],[17,19,"G3588"],[20,30,"G3804"],[31,38,"G5228"],[40,43,"G2532"],[44,53,"G466"],[54,56,"G1722"],[57,59,"G1473"],[60,65,"G4561"],[66,70,"G3588"],[71,81,"G5303"],[82,94,"G3588"],[95,103,"G5547"],[104,115,"G2347"],[116,131,"G5228"],[132,135,"G846"],[136,140,"G4983"],[142,147,"G3739"],[148,150,"G1510"],[151,154,"G3588"],[155,161,"G1577"]]},{"book":"COL","chapter":1,"verse":25,"text":"I became its servant by the commission God gave me to fully proclaim to you the word of God,","strongs":[[0,1,"G1473"],[2,8,"G1096"],[9,12,"G3739"],[13,20,"G1249"],[21,23,"G2596"],[24,27,"G3588"],[28,38,"G3622"],[39,42,"G2316"],[43,47,"G1325"],[48,50,"G1473"],[51,68,"G4137"],[69,71,"G1519"],[72,75,"G4771"],[76,79,"G3588"],[80,84,"G3056"],[85,91,"G2316"]]},{"book":"COL","chapter":1,"verse":26,"text":"the mystery that was hidden for ages and generations but is now revealed to His saints.","strongs":[[0,3,"G3588"],[4,11,"G3466"],[12,16,"G3588"],[17,27,"G613"],[28,31,"G575"],[32,36,"G165"],[37,40,"G2532"],[41,52,"G1074"],[53,56,"G1161"],[57,72,"G5319"],[73,75,"G3588"],[76,79,"G846"],[80,86,"G40"]]},{"book":"COL","chapter":1,"verse":27,"text":"To them God has chosen to make known among the Gentiles the glorious riches of this mystery, which is Christ in you, the hope of glory.","strongs":[[0,7,"G3739"],[8,11,"G2316"],[12,22,"G2309"],[23,36,"G1107"],[37,42,"G1722"],[43,46,"G3588"],[47,55,"G1484"],[56,59,"G3588"],[60,68,"G1391"],[69,75,"G4149"],[76,83,"G3778"],[84,91,"G3466"],[93,98,"G3739"],[99,101,"G1510"],[102,108,"G5547"],[109,111,"G1722"],[112,115,"G4771"],[117,120,"G3588"],[121,125,"G1680"],[126,128,"G3588"],[129,134,"G1391"]]},{"book":"COL","chapter":1,"verse":28,"text":"We proclaim Him, admonishing and teaching everyone with all wisdom, so that we may present everyone perfect in Christ.","strongs":[[0,2,"G1473"],[3,11,"G2605"],[12,15,"G3739"],[17,28,"G3560"],[29,32,"G2532"],[33,41,"G1321"],[42,50,"G3956"],[51,55,"G1722"],[56,59,"G3956"],[60,66,"G4678"],[68,75,"G2443"],[76,90,"G3936"],[91,99,"G3956"],[100,107,"G5046"],[108,110,"G1722"],[111,117,"G5547"]]},{"book":"COL","chapter":1,"verse":29,"text":"To this end I also labor, striving with all His energy working powerfully within me.","strongs":[[0,2,"G1519"],[3,11,"G3739"],[12,18,"G2532"],[19,24,"G2872"],[26,34,"G75"],[35,43,"G2596"],[44,47,"G846"],[48,54,"G1753"],[55,62,"G1754"],[63,73,"G1411"],[74,80,"G1722"],[81,83,"G1473"]]},{"book":"COL","chapter":2,"verse":1,"text":"For I want you to know how much I am struggling for you and for those at Laodicea, and for all who have not met me face to face,","strongs":[[0,3,"G1063"],[4,10,"G2309"],[11,14,"G4771"],[15,22,"G1492"],[23,31,"G2245"],[32,47,"G2192"],[48,51,"G5228"],[52,55,"G4771"],[56,59,"G2532"],[60,69,"G3588"],[70,72,"G1722"],[73,81,"G2993"],[83,86,"G2532"],[87,98,"G3745"],[99,111,"G3708"],[112,114,"G1473"],[115,127,"G4383"]]},{"book":"COL","chapter":2,"verse":2,"text":"that they may be encouraged in heart, knit together in love, and filled with the full riches of complete understanding, so that they may know the mystery of God, namely Christ,","strongs":[[0,4,"G2443"],[5,27,"G3870"],[28,36,"G2588"],[38,51,"G4822"],[52,54,"G1722"],[55,59,"G26"],[61,64,"G2532"],[65,76,"G1519"],[77,92,"G4149"],[93,104,"G4136"],[105,118,"G4907"],[120,127,"G1519"],[128,141,"G1922"],[142,145,"G3588"],[146,153,"G3466"],[154,160,"G2316"],[162,175,"G5547"]]},{"book":"COL","chapter":2,"verse":3,"text":"in whom are hidden all the treasures of wisdom and knowledge.","strongs":[[0,2,"G1722"],[3,7,"G3739"],[8,11,"G1510"],[12,18,"G614"],[19,22,"G3956"],[23,26,"G3588"],[27,36,"G2344"],[37,46,"G4678"],[47,50,"G2532"],[51,60,"G1108"]]},{"book":"COL","chapter":2,"verse":4,"text":"I say this so that no one will deceive you by smooth rhetoric.","strongs":[[0,5,"G3004"],[6,10,"G3778"],[11,18,"G2443"],[19,25,"G3367"],[26,38,"G3884"],[39,42,"G4771"],[43,45,"G1722"],[46,61,"G4086"]]},{"book":"COL","chapter":2,"verse":5,"text":"For although I am absent from you in body, I am present with you in spirit, and I delight to see your orderly condition and firm faith in Christ.","strongs":[[0,3,"G1063"],[4,12,"G2532"],[13,33,"G548"],[34,36,"G3588"],[37,41,"G4561"],[43,55,"G1510"],[56,60,"G4862"],[61,64,"G4771"],[65,74,"G4151"],[76,89,"G5463"],[90,96,"G991"],[97,101,"G4771"],[102,119,"G5010"],[120,123,"G2532"],[124,128,"G4733"],[129,134,"G4102"],[135,137,"G1519"],[138,144,"G5547"]]},{"book":"COL","chapter":2,"verse":6,"text":"Therefore, just as you have received Christ Jesus as Lord, continue to walk in Him,","strongs":[[0,9,"G3767"],[11,18,"G5613"],[19,36,"G3880"],[37,43,"G5547"],[44,49,"G2424"],[50,52,"G3588"],[53,57,"G2962"],[59,75,"G4043"],[76,78,"G1722"],[79,82,"G846"]]},{"book":"COL","chapter":2,"verse":7,"text":"rooted and built up in Him, established in the faith as you were taught, and overflowing with thankfulness.","strongs":[[0,6,"G4492"],[7,10,"G2532"],[11,19,"G2026"],[20,22,"G1722"],[23,26,"G846"],[28,42,"G950"],[43,46,"G3588"],[47,52,"G4102"],[53,55,"G2531"],[56,71,"G1321"],[73,88,"G4052"],[89,93,"G1722"],[94,106,"G2169"]]},{"book":"COL","chapter":2,"verse":8,"text":"See to it that no one takes you captive through philosophy and empty deception, which are based on human tradition and the spiritual forces of the world rather than on Christ.","strongs":[[0,9,"G991"],[10,21,"G3361"],[22,39,"G4812"],[40,47,"G1223"],[48,58,"G5385"],[59,62,"G2532"],[63,68,"G2756"],[69,78,"G539"],[80,98,"G2596"],[99,104,"G444"],[105,114,"G3862"],[115,118,"G2596"],[119,122,"G3588"],[123,139,"G4747"],[140,146,"G3588"],[147,152,"G2889"],[153,164,"G3756"],[165,167,"G2596"],[168,174,"G5547"]]},{"book":"COL","chapter":2,"verse":9,"text":"For in Christ all the fullness of the Deity dwells in bodily form.","strongs":[[0,3,"G3754"],[4,6,"G1722"],[7,13,"G846"],[14,17,"G3956"],[18,21,"G3588"],[22,30,"G4138"],[31,37,"G3588"],[38,43,"G2320"],[44,50,"G2730"],[51,65,"G4985"]]},{"book":"COL","chapter":2,"verse":10,"text":"And you have been made complete in Christ, who is the head over every ruler and authority.","strongs":[[0,3,"G2532"],[4,17,"G1510"],[18,31,"G4137"],[32,34,"G1722"],[35,41,"G846"],[43,46,"G3739"],[47,49,"G1510"],[50,53,"G3588"],[54,58,"G2776"],[59,69,"G3956"],[70,75,"G746"],[76,79,"G2532"],[80,89,"G1849"]]},{"book":"COL","chapter":2,"verse":11,"text":"In Him you were also circumcised, in the putting off of your sinful nature, with the circumcision performed by Christ and not by human hands.","strongs":[[0,2,"G1722"],[3,6,"G3739"],[7,32,"G4059"],[34,36,"G1722"],[37,40,"G3588"],[41,52,"G555"],[53,60,"G3588"],[61,74,"G4561"],[76,80,"G1722"],[81,84,"G3588"],[85,97,"G4061"],[98,117,"G5547"],[118,121,"G4061"],[122,140,"G886"]]},{"book":"COL","chapter":2,"verse":12,"text":"And having been buried with Him in baptism, you were raised with Him through your faith in the power of God, who raised Him from the dead.","strongs":[[0,3,"G2532"],[4,27,"G4916"],[28,31,"G846"],[32,34,"G1722"],[35,42,"G909"],[44,68,"G4891"],[69,76,"G1223"],[77,81,"G3588"],[82,87,"G4102"],[88,94,"G3588"],[95,100,"G1753"],[101,107,"G2316"],[109,112,"G3588"],[113,119,"G1453"],[120,123,"G846"],[124,128,"G1537"],[129,137,"G3498"]]},{"book":"COL","chapter":2,"verse":13,"text":"When you were dead in your trespasses and in the uncircumcision of your sinful nature, God made you alive with Christ. He forgave us all our trespasses,","strongs":[[0,4,"G2532"],[5,8,"G4771"],[9,13,"G1510"],[14,18,"G3498"],[19,21,"G1722"],[22,26,"G3588"],[27,37,"G3900"],[38,41,"G2532"],[42,48,"G3588"],[49,63,"G203"],[64,71,"G4771"],[72,85,"G4561"],[87,105,"G4806"],[106,110,"G4862"],[111,117,"G846"],[119,129,"G5483"],[130,132,"G1473"],[133,136,"G3956"],[137,140,"G3588"],[141,151,"G3900"]]},{"book":"COL","chapter":2,"verse":14,"text":"having canceled the debt ascribed to us in the decrees that stood against us. He took it away, nailing it to the cross!","strongs":[[0,15,"G1813"],[16,19,"G3588"],[20,33,"G5498"],[34,36,"G2596"],[37,39,"G1473"],[40,46,"G3588"],[47,54,"G1378"],[55,59,"G3739"],[60,65,"G1510"],[66,73,"G5227"],[74,76,"G1473"],[78,85,"G142"],[86,88,"G846"],[89,93,"G1537"],[95,102,"G4338"],[103,105,"G846"],[106,112,"G3588"],[113,118,"G4716"]]},{"book":"COL","chapter":2,"verse":15,"text":"And having disarmed the powers and authorities, He made a public spectacle of them, triumphing over them by the cross.","strongs":[[0,19,"G554"],[20,23,"G3588"],[24,30,"G746"],[31,34,"G2532"],[35,46,"G1849"],[48,82,"G1165"],[84,94,"G2358"],[95,104,"G846"],[105,107,"G1722"],[108,117,"G846"]]},{"book":"COL","chapter":2,"verse":16,"text":"Therefore let no one judge you by what you eat or drink, or with regard to a feast, a New Moon, or a Sabbath.","strongs":[[0,9,"G3767"],[10,16,"G3361"],[17,20,"G5100"],[21,26,"G2919"],[27,30,"G4771"],[31,33,"G1722"],[34,46,"G1035"],[47,49,"G2532"],[50,55,"G4213"],[57,59,"G2228"],[60,64,"G1722"],[65,74,"G3313"],[75,82,"G1859"],[84,94,"G3561"],[96,98,"G2228"],[99,108,"G4521"]]},{"book":"COL","chapter":2,"verse":17,"text":"These are a shadow of the things to come, but the body that casts it belongs to Christ.","strongs":[[0,5,"G3739"],[6,9,"G1510"],[10,18,"G4639"],[19,32,"G3588"],[33,40,"G3195"],[42,45,"G1161"],[46,49,"G3588"],[50,68,"G4983"],[69,79,"G3588"],[80,86,"G5547"]]},{"book":"COL","chapter":2,"verse":18,"text":"Do not let anyone who delights in false humility and the worship of angels disqualify you with speculation about what he has seen. Such a person is puffed up without basis by his unspiritual mind.","strongs":[[0,17,"G3367"],[18,30,"G2309"],[31,33,"G1722"],[34,48,"G5012"],[49,52,"G2532"],[53,64,"G2356"],[65,74,"G32"],[75,85,"G2603"],[86,89,"G4771"],[90,112,"G1687"],[113,117,"G3739"],[118,129,"G3708"],[131,157,"G5448"],[158,171,"G1500"],[172,174,"G5259"],[175,178,"G846"],[179,190,"G4561"],[191,195,"G3563"]]},{"book":"COL","chapter":2,"verse":19,"text":"He has lost connection to the head, from whom the whole body, supported and knit together by its joints and ligaments, grows as God causes it to grow.","strongs":[[0,22,"G2902"],[23,29,"G3588"],[30,34,"G2776"],[36,40,"G1537"],[41,45,"G3739"],[46,49,"G3588"],[50,55,"G3956"],[56,60,"G4983"],[62,71,"G2023"],[72,75,"G2532"],[76,89,"G4822"],[90,92,"G1223"],[93,96,"G3588"],[97,103,"G860"],[104,107,"G2532"],[108,117,"G4886"],[119,124,"G837"],[125,127,"G3588"],[128,131,"G2316"],[132,149,"G838"]]},{"book":"COL","chapter":2,"verse":20,"text":"If you have died with Christ to the spiritual forces of the world, why, as though you still belonged to the world, do you submit to its regulations:","strongs":[[0,2,"G1487"],[3,16,"G599"],[17,21,"G4862"],[22,28,"G5547"],[29,31,"G575"],[32,35,"G3588"],[36,52,"G4747"],[53,59,"G3588"],[60,65,"G2889"],[67,70,"G5101"],[72,81,"G5613"],[82,100,"G2198"],[101,103,"G1722"],[104,113,"G2889"],[115,147,"G1379"]]},{"book":"COL","chapter":2,"verse":21,"text":"“Do not handle, do not taste, do not touch!”?","strongs":[[1,3,"G3361"],[4,14,"G680"],[16,18,"G3366"],[19,28,"G1089"],[30,32,"G3366"],[33,42,"G2345"]]},{"book":"COL","chapter":2,"verse":22,"text":"These will all perish with use, because they are based on human commands and teachings.","strongs":[[0,5,"G3739"],[6,10,"G1510"],[11,14,"G3956"],[15,21,"G5356"],[22,26,"G3588"],[27,30,"G671"],[32,57,"G2596"],[58,63,"G444"],[64,72,"G1778"],[73,76,"G2532"],[77,86,"G1319"]]},{"book":"COL","chapter":2,"verse":23,"text":"Such restrictions indeed have an appearance of wisdom, with their self-prescribed worship, their false humility, and their harsh treatment of the body; but they are of no value against the indulgence of the flesh.","strongs":[[0,17,"G3748"],[18,24,"G3303"],[25,29,"G2192"],[30,43,"G3056"],[44,53,"G4678"],[55,65,"G1722"],[66,89,"G1479"],[91,111,"G5012"],[113,116,"G2532"],[117,138,"G857"],[139,150,"G4983"],[152,164,"G1510"],[165,167,"G1722"],[168,170,"G3756"],[171,176,"G5092"],[177,184,"G4314"],[185,199,"G4140"],[200,206,"G3588"],[207,212,"G4561"]]},{"book":"COL","chapter":3,"verse":1,"text":"Therefore, since you have been raised with Christ, strive for the things above, where Christ is seated at the right hand of God.","strongs":[[0,9,"G3767"],[11,16,"G1487"],[17,42,"G4891"],[43,49,"G5547"],[51,61,"G2212"],[62,72,"G3588"],[73,78,"G507"],[80,85,"G3757"],[86,92,"G5547"],[93,95,"G1510"],[96,102,"G2521"],[103,105,"G1722"],[106,120,"G1188"],[121,127,"G2316"]]},{"book":"COL","chapter":3,"verse":2,"text":"Set your minds on things above, not on earthly things.","strongs":[[0,17,"G5426"],[18,24,"G3588"],[25,30,"G507"],[32,35,"G3361"],[36,38,"G1909"],[39,46,"G1093"],[47,53,"G3588"]]},{"book":"COL","chapter":3,"verse":3,"text":"For you died, and your life is now hidden with Christ in God.","strongs":[[0,3,"G1063"],[4,12,"G599"],[14,17,"G2532"],[18,22,"G4771"],[23,27,"G2222"],[28,41,"G2928"],[42,46,"G4862"],[47,53,"G5547"],[54,56,"G1722"],[57,60,"G2316"]]},{"book":"COL","chapter":3,"verse":4,"text":"When Christ, who is your life, appears, then you also will appear with Him in glory.","strongs":[[0,4,"G3752"],[5,11,"G5547"],[13,19,"G3588"],[20,24,"G4771"],[25,29,"G2222"],[31,38,"G5319"],[40,44,"G5119"],[45,48,"G4771"],[49,53,"G2532"],[54,65,"G5319"],[66,70,"G4862"],[71,74,"G846"],[75,77,"G1722"],[78,83,"G1391"]]},{"book":"COL","chapter":3,"verse":5,"text":"Put to death, therefore, the components of your earthly nature: sexual immorality, impurity, lust, evil desires, and greed, which is idolatry.","strongs":[[0,12,"G3499"],[14,23,"G3767"],[25,28,"G3588"],[29,39,"G3196"],[40,47,"G3588"],[48,62,"G1093"],[64,81,"G4202"],[83,91,"G167"],[93,97,"G3806"],[99,103,"G2556"],[104,111,"G1939"],[113,116,"G2532"],[117,122,"G4124"],[124,129,"G3748"],[130,132,"G1510"],[133,141,"G1495"]]},{"book":"COL","chapter":3,"verse":6,"text":"Because of these, the wrath of God is coming on the sons of disobedience.","strongs":[[0,10,"G1223"],[11,16,"G3739"],[18,21,"G3588"],[22,27,"G3709"],[28,34,"G2316"],[35,44,"G2064"],[45,47,"G1909"],[48,51,"G3588"],[52,56,"G5207"],[57,59,"G3588"],[60,72,"G543"]]},{"book":"COL","chapter":3,"verse":7,"text":"When you lived among them, you also used to walk in these ways.","strongs":[[0,4,"G3753"],[5,14,"G2198"],[15,20,"G1722"],[21,25,"G3778"],[27,30,"G4771"],[31,35,"G2532"],[36,43,"G4218"],[44,48,"G4043"],[49,51,"G1722"],[52,62,"G3739"]]},{"book":"COL","chapter":3,"verse":8,"text":"But now you must put aside all such things as these: anger, rage, malice, slander, and filthy language from your lips.","strongs":[[0,3,"G1161"],[4,7,"G3570"],[8,11,"G4771"],[12,26,"G659"],[27,51,"G3956"],[53,58,"G3709"],[60,64,"G2372"],[66,72,"G2549"],[74,81,"G988"],[83,102,"G148"],[103,107,"G1537"],[108,112,"G4771"],[113,117,"G4750"]]},{"book":"COL","chapter":3,"verse":9,"text":"Do not lie to one another, since you have taken off the old self with its practices,","strongs":[[0,6,"G3361"],[7,10,"G5574"],[11,13,"G1519"],[14,25,"G240"],[27,51,"G554"],[52,55,"G3588"],[56,59,"G3820"],[60,64,"G444"],[65,69,"G4862"],[70,73,"G846"],[74,83,"G4234"]]},{"book":"COL","chapter":3,"verse":10,"text":"and have put on the new self, which is being renewed in knowledge in the image of its Creator.","strongs":[[0,3,"G2532"],[4,15,"G1746"],[16,19,"G3588"],[20,28,"G3501"],[30,38,"G3588"],[39,52,"G341"],[53,55,"G1519"],[56,65,"G1922"],[66,68,"G2596"],[69,78,"G1504"],[79,81,"G3588"],[82,85,"G846"],[86,93,"G2936"]]},{"book":"COL","chapter":3,"verse":11,"text":"Here there is no Greek or Jew, circumcised or uncircumcised, barbarian, Scythian, slave, or free, but Christ is all and is in all.","strongs":[[0,4,"G3699"],[5,13,"G1762"],[14,16,"G3756"],[17,22,"G1672"],[23,25,"G2532"],[26,29,"G2453"],[31,42,"G4061"],[43,45,"G2532"],[46,59,"G203"],[61,70,"G915"],[72,80,"G4658"],[82,87,"G1401"],[89,96,"G1658"],[98,101,"G235"],[102,111,"G5547"],[112,115,"G3956"],[116,119,"G2532"],[120,125,"G1722"],[126,129,"G3956"]]},{"book":"COL","chapter":3,"verse":12,"text":"Therefore, as the elect of God, holy and beloved, clothe yourselves with hearts of compassion, kindness, humility, gentleness, and patience.","strongs":[[0,9,"G3767"],[11,13,"G5613"],[14,23,"G1588"],[24,30,"G2316"],[32,36,"G40"],[37,40,"G2532"],[41,48,"G25"],[50,72,"G1746"],[73,79,"G4698"],[80,93,"G3628"],[95,103,"G5544"],[105,113,"G5012"],[115,125,"G4240"],[127,139,"G3115"]]},{"book":"COL","chapter":3,"verse":13,"text":"Bear with one another and forgive any complaint you may have against someone else. Forgive as the Lord forgave you.","strongs":[[0,9,"G430"],[10,21,"G240"],[22,25,"G2532"],[26,33,"G5483"],[34,37,"G5100"],[38,47,"G3437"],[48,60,"G2192"],[61,68,"G4314"],[69,81,"G5100"],[83,90,"G4771"],[91,93,"G2531"],[94,97,"G3588"],[98,102,"G2962"],[103,110,"G5483"],[111,114,"G4771"]]},{"book":"COL","chapter":3,"verse":14,"text":"And over all these virtues put on love, which is the bond of perfect unity.","strongs":[[0,3,"G1161"],[4,8,"G1909"],[9,12,"G3956"],[13,26,"G3778"],[27,38,"G26"],[40,45,"G3739"],[46,48,"G1510"],[49,57,"G4886"],[58,74,"G5047"]]},{"book":"COL","chapter":3,"verse":15,"text":"Let the peace of Christ rule in your hearts, for to this you were called as members of one body. And be thankful.","strongs":[[0,7,"G3588"],[8,13,"G1515"],[14,23,"G5547"],[24,28,"G1018"],[29,31,"G1722"],[32,36,"G4771"],[37,43,"G2588"],[45,51,"G1519"],[52,56,"G3739"],[57,72,"G2564"],[73,86,"G1722"],[87,90,"G1520"],[91,95,"G4983"],[97,100,"G2532"],[101,103,"G1096"],[104,112,"G2170"]]},{"book":"COL","chapter":3,"verse":16,"text":"Let the word of Christ richly dwell within you as you teach and admonish one another with all wisdom, and as you sing psalms, hymns, and spiritual songs with gratitude in your hearts to God.","strongs":[[0,7,"G3588"],[8,12,"G3056"],[13,22,"G5547"],[23,29,"G4146"],[30,35,"G1774"],[36,42,"G1722"],[43,46,"G4771"],[47,59,"G1321"],[60,63,"G2532"],[64,72,"G3560"],[73,84,"G1438"],[85,89,"G1722"],[90,93,"G3956"],[94,100,"G4678"],[102,117,"G103"],[118,124,"G5568"],[126,131,"G5215"],[133,146,"G4152"],[147,152,"G5603"],[153,157,"G1722"],[158,167,"G5485"],[168,170,"G1722"],[171,175,"G4771"],[176,182,"G2588"],[183,185,"G3588"],[186,189,"G2316"]]},{"book":"COL","chapter":3,"verse":17,"text":"And whatever you do, in word or deed, do it all in the name of the Lord Jesus, giving thanks to God the Father through Him.","strongs":[[0,3,"G2532"],[4,12,"G3956"],[13,19,"G4160"],[21,23,"G1722"],[24,28,"G3056"],[29,31,"G2228"],[32,36,"G2041"],[38,47,"G3956"],[48,50,"G1722"],[51,59,"G3686"],[60,71,"G2962"],[72,77,"G2424"],[79,92,"G2168"],[93,99,"G2316"],[100,110,"G3962"],[111,118,"G1223"],[119,122,"G846"]]},{"book":"COL","chapter":3,"verse":18,"text":"Wives, submit to your husbands, as is fitting in the Lord.","strongs":[[0,5,"G1135"],[7,13,"G5293"],[14,21,"G3588"],[22,30,"G435"],[32,34,"G5613"],[35,45,"G433"],[46,48,"G1722"],[49,57,"G2962"]]},{"book":"COL","chapter":3,"verse":19,"text":"Husbands, love your wives and do not be harsh with them.","strongs":[[0,8,"G435"],[10,14,"G25"],[15,19,"G3588"],[20,25,"G1135"],[26,29,"G2532"],[30,36,"G3361"],[37,45,"G4087"],[46,50,"G4314"],[51,55,"G846"]]},{"book":"COL","chapter":3,"verse":20,"text":"Children, obey your parents in everything, for this is pleasing to the Lord.","strongs":[[0,8,"G5043"],[10,14,"G5219"],[15,19,"G3588"],[20,27,"G1118"],[28,30,"G2596"],[31,41,"G3956"],[43,46,"G1063"],[47,51,"G3778"],[52,54,"G1510"],[55,63,"G2101"],[64,66,"G1722"],[67,75,"G2962"]]},{"book":"COL","chapter":3,"verse":21,"text":"Fathers, do not provoke your children, so they will not become discouraged.","strongs":[[0,7,"G3962"],[9,15,"G3361"],[16,23,"G2042"],[24,28,"G4771"],[29,37,"G5043"],[39,41,"G2443"],[42,74,"G120"]]},{"book":"COL","chapter":3,"verse":22,"text":"Slaves, obey your earthly masters in everything, not only to please them while they are watching, but with sincerity of heart and fear of the Lord.","strongs":[[0,6,"G1401"],[8,12,"G5219"],[13,17,"G3588"],[18,25,"G2596"],[26,33,"G2962"],[34,36,"G2596"],[37,47,"G3956"],[49,57,"G3361"],[58,72,"G441"],[73,96,"G3787"],[98,101,"G235"],[102,106,"G1722"],[107,116,"G572"],[117,125,"G2588"],[126,134,"G5399"],[135,141,"G3588"],[142,146,"G2962"]]},{"book":"COL","chapter":3,"verse":23,"text":"Whatever you do, work at it with your whole being, as for the Lord and not for men,","strongs":[[0,8,"G3739"],[9,15,"G4160"],[17,27,"G2038"],[28,49,"G5590"],[51,57,"G5613"],[58,61,"G3588"],[62,66,"G2962"],[67,70,"G2532"],[71,74,"G3756"],[75,82,"G444"]]},{"book":"COL","chapter":3,"verse":24,"text":"because you know that you will receive an inheritance from the Lord as your reward. It is the Lord Christ you are serving.","strongs":[[0,16,"G1492"],[17,21,"G3754"],[22,38,"G618"],[39,53,"G2817"],[54,58,"G575"],[59,67,"G2962"],[68,75,"G3588"],[76,82,"G469"],[84,93,"G3588"],[94,98,"G2962"],[99,105,"G5547"],[106,121,"G1398"]]},{"book":"COL","chapter":3,"verse":25,"text":"Whoever does wrong will be repaid for his wrong, and there is no favoritism.","strongs":[[0,7,"G3588"],[8,18,"G91"],[19,37,"G2865"],[38,47,"G91"],[49,52,"G2532"],[53,61,"G1510"],[62,64,"G3756"],[65,75,"G4382"]]},{"book":"COL","chapter":4,"verse":1,"text":"Masters, supply your slaves with what is right and fair, since you know that you also have a Master in heaven.","strongs":[[0,7,"G2962"],[9,15,"G3930"],[16,20,"G3588"],[21,27,"G1401"],[28,37,"G3588"],[38,46,"G1342"],[47,50,"G2532"],[51,55,"G2471"],[57,71,"G1492"],[72,76,"G3754"],[77,80,"G4771"],[81,85,"G2532"],[86,90,"G2192"],[91,99,"G2962"],[100,102,"G1722"],[103,109,"G3772"]]},{"book":"COL","chapter":4,"verse":2,"text":"Devote yourselves to prayer, being watchful and thankful,","strongs":[[0,17,"G4342"],[18,20,"G3588"],[21,27,"G4335"],[29,43,"G1127"],[44,47,"G1722"],[48,56,"G2169"]]},{"book":"COL","chapter":4,"verse":3,"text":"as you pray also for us, that God may open to us a door for the word, so that we may proclaim the mystery of Christ, for which I am in chains.","strongs":[[0,2,"G260"],[3,11,"G4336"],[12,16,"G2532"],[17,20,"G4012"],[21,23,"G1473"],[25,29,"G2443"],[30,33,"G2316"],[34,42,"G455"],[43,48,"G1473"],[49,55,"G2374"],[56,63,"G3588"],[64,68,"G3056"],[70,93,"G2980"],[94,97,"G3588"],[98,105,"G3466"],[106,115,"G5547"],[117,120,"G1223"],[121,126,"G3739"],[127,141,"G1210"]]},{"book":"COL","chapter":4,"verse":4,"text":"Pray that I may declare it clearly, as I should.","strongs":[[0,9,"G2443"],[10,34,"G5319"],[36,38,"G5613"],[39,40,"G1473"],[41,47,"G1163"]]},{"book":"COL","chapter":4,"verse":5,"text":"Act wisely toward outsiders, redeeming the time.","strongs":[[0,3,"G4043"],[4,10,"G4678"],[11,17,"G4314"],[18,27,"G1854"],[29,38,"G1805"],[39,42,"G3588"],[43,47,"G2540"]]},{"book":"COL","chapter":4,"verse":6,"text":"Let your speech always be gracious, seasoned with salt, so that you may know how to answer everyone.","strongs":[[0,8,"G4771"],[9,15,"G3056"],[16,25,"G3842"],[26,34,"G5485"],[36,44,"G741"],[45,54,"G217"],[56,76,"G1492"],[77,80,"G4459"],[81,90,"G611"],[91,99,"G1538"]]},{"book":"COL","chapter":4,"verse":7,"text":"Tychicus will tell you all the news about me. He is a beloved brother, a faithful minister, and a fellow servant in the Lord.","strongs":[[0,8,"G5190"],[9,18,"G1107"],[19,22,"G4771"],[23,26,"G3956"],[27,35,"G3588"],[36,41,"G2596"],[42,44,"G1473"],[46,51,"G3588"],[52,61,"G27"],[62,69,"G80"],[71,81,"G4103"],[82,90,"G1249"],[92,95,"G2532"],[96,112,"G4889"],[113,115,"G1722"],[116,124,"G2962"]]},{"book":"COL","chapter":4,"verse":8,"text":"I have sent him to you for this very purpose, that you may know about us, and that he may encourage your hearts.","strongs":[[0,11,"G3992"],[12,15,"G3739"],[16,18,"G4314"],[19,22,"G4771"],[23,26,"G1519"],[27,36,"G846"],[37,44,"G3778"],[46,50,"G2443"],[51,63,"G1097"],[64,69,"G4012"],[70,72,"G1473"],[74,82,"G2532"],[83,99,"G3870"],[100,104,"G4771"],[105,111,"G2588"]]},{"book":"COL","chapter":4,"verse":9,"text":"With him I am sending Onesimus, our faithful and beloved brother, who is one of you. They will tell you about everything here.","strongs":[[0,21,"G4862"],[22,30,"G3682"],[32,35,"G3588"],[36,44,"G4103"],[45,48,"G2532"],[49,56,"G27"],[57,64,"G80"],[66,69,"G3739"],[70,72,"G1510"],[73,79,"G1537"],[80,83,"G4771"],[85,99,"G1107"],[100,109,"G4771"],[110,120,"G3956"],[121,125,"G5602"]]},{"book":"COL","chapter":4,"verse":10,"text":"My fellow prisoner Aristarchus sends you greetings, as does Mark the cousin of Barnabas. You have already received instructions about him: If he comes to you, welcome him.","strongs":[[0,2,"G1473"],[3,18,"G4869"],[19,30,"G708"],[31,50,"G782"],[52,59,"G2532"],[60,64,"G3138"],[65,68,"G3588"],[69,75,"G431"],[76,87,"G921"],[89,114,"G2983"],[115,127,"G1785"],[128,133,"G4012"],[134,137,"G3739"],[139,141,"G1437"],[142,150,"G2064"],[151,153,"G4314"],[154,157,"G4771"],[159,166,"G1209"],[167,170,"G846"]]},{"book":"COL","chapter":4,"verse":11,"text":"Jesus, who is called Justus, also sends greetings. These are the only Jews among my fellow workers for the kingdom of God, and they have been a comfort to me.","strongs":[[0,5,"G2424"],[7,20,"G3004"],[21,27,"G2459"],[29,49,"G2532"],[51,56,"G3778"],[57,60,"G1510"],[61,69,"G3441"],[70,74,"G4061"],[75,80,"G1537"],[81,83,"G3588"],[84,98,"G4904"],[99,102,"G1519"],[103,106,"G3588"],[107,114,"G932"],[115,121,"G2316"],[123,131,"G3748"],[132,141,"G1096"],[142,151,"G3931"],[152,157,"G1473"]]},{"book":"COL","chapter":4,"verse":12,"text":"Epaphras, who is one of you and a servant of Christ Jesus, sends you greetings. He is always wrestling in prayer for you, so that you may stand mature and fully assured in the full will of God.","strongs":[[0,8,"G1889"],[10,16,"G3588"],[17,23,"G1537"],[24,27,"G4771"],[28,41,"G1401"],[42,51,"G5547"],[52,57,"G2424"],[59,78,"G782"],[80,92,"G3842"],[93,102,"G75"],[103,105,"G1722"],[106,112,"G4335"],[113,116,"G5228"],[117,120,"G4771"],[122,129,"G2443"],[130,143,"G2476"],[144,150,"G5046"],[151,154,"G2532"],[155,168,"G4135"],[169,171,"G1722"],[172,180,"G3956"],[181,185,"G2307"],[186,192,"G2316"]]},{"book":"COL","chapter":4,"verse":13,"text":"For I testify about him that he goes to great pains for you and for those at Laodicea and Hierapolis.","strongs":[[0,3,"G1063"],[4,13,"G3140"],[14,23,"G846"],[24,28,"G3754"],[29,39,"G2192"],[40,45,"G4183"],[46,51,"G4192"],[52,55,"G5228"],[56,59,"G4771"],[60,63,"G2532"],[64,73,"G3588"],[74,76,"G1722"],[77,85,"G2993"],[86,89,"G2532"],[90,100,"G2413"]]},{"book":"COL","chapter":4,"verse":14,"text":"Luke, the beloved physician, and Demas send you greetings.","strongs":[[0,4,"G3065"],[6,9,"G3588"],[10,17,"G27"],[18,27,"G2395"],[29,32,"G2532"],[33,38,"G1214"],[39,57,"G782"]]},{"book":"COL","chapter":4,"verse":15,"text":"Greet the brothers in Laodicea, as well as Nympha and the church that meets at her house.","strongs":[[0,5,"G782"],[6,9,"G3588"],[10,18,"G80"],[19,21,"G1722"],[22,30,"G2993"],[32,42,"G2532"],[43,49,"G3564"],[50,53,"G2532"],[54,57,"G3588"],[58,64,"G1577"],[65,78,"G2596"],[79,82,"G846"],[83,88,"G3624"]]},{"book":"COL","chapter":4,"verse":16,"text":"After this letter has been read among you, make sure that it is also read in the church of the Laodiceans, and that you in turn read the letter from Laodicea.","strongs":[[0,5,"G3752"],[6,10,"G3588"],[11,17,"G1992"],[18,31,"G314"],[32,37,"G3844"],[38,41,"G4771"],[43,52,"G4160"],[53,57,"G2443"],[58,73,"G314"],[74,76,"G1722"],[77,80,"G3588"],[81,87,"G1577"],[88,105,"G2994"],[107,110,"G2532"],[111,115,"G2443"],[116,119,"G4771"],[120,127,"G2532"],[128,132,"G314"],[133,143,"G3588"],[144,148,"G1537"],[149,157,"G2993"]]},{"book":"COL","chapter":4,"verse":17,"text":"Tell Archippus: “See to it that you complete the ministry you have received in the Lord.”","strongs":[[0,4,"G2036"],[5,14,"G751"],[17,26,"G991"],[27,31,"G2443"],[32,44,"G4137"],[45,48,"G3588"],[49,57,"G1248"],[58,75,"G3880"],[76,78,"G1722"],[79,87,"G2962"]]},{"book":"COL","chapter":4,"verse":18,"text":"This greeting is in my own hand—Paul. Remember my chains. Grace be with you.","strongs":[[0,4,"G3588"],[5,13,"G783"],[14,22,"G3588"],[23,26,"G1699"],[27,31,"G5495"],[32,36,"G3972"],[38,46,"G3421"],[47,49,"G1473"],[50,56,"G1199"],[58,66,"G5485"],[67,71,"G3326"],[72,75,"G4771"]]}]}